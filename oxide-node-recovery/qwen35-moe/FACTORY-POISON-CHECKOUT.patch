+    #[test]
+    fn never_queued_mismatched_key_discards_without_release_or_quarantine() {
+        let (work, releases, drops) = FakeWork::new();
+        let mut cache: WorkCache<FakeWork> = WorkCache::default();
+        let outcome = settle_work(
+            &mut cache,
+            (2, 2, 2),
+            false,
+            None,
+            work,
+            FakeWork::release,
+            FakeWork::discard,
+        );
+        let discarded = match outcome {
+            WorkSettlement::Released(work) => work,
+            _ => panic!("expected safe never-queued discard"),
+        };
+        assert!(!discarded.live);
+        assert_eq!(releases.get(), 0);
+        assert_eq!(drops.get(), 0);
+        drop(discarded);
+        assert_eq!(drops.get(), 1);
