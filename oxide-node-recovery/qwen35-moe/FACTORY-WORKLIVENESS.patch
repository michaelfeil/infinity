+    #[test]
+    fn cached_completed_work_keeps_payload_live_and_is_reusable() {
+        let key = (1, 1, 1);
+        let (first, first_releases, first_drops) = FakeWork::new();
+        let (second, _, _) = FakeWork::new();
+        let mut cache: WorkCache<FakeWork> = WorkCache::default();
+        cache.reset(key, first, second);
+        let work = cache.take_slot().unwrap();
+        let first_releases = Rc::clone(&first_releases);
+        let outcome = settle_work(&mut cache, key, true, Some(true), work, FakeWork::release);
+        assert!(matches!(outcome, WorkSettlement::Cached));
+        let reused = cache.take_slot().unwrap();
+        assert!(reused.live);
+        assert_eq!(first_releases.get(), 0);
+        assert_eq!(first_drops.get(), 0);
+    }
