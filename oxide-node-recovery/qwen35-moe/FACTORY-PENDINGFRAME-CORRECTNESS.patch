+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn fixture(value: serde_json::Value) -> PathBuf {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
+        let dir = std::env::temp_dir().join(format!(
+            "qwen35-moe-factory-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("config.json"), serde_json::to_vec(&value).unwrap()).unwrap();
+        dir
+    }
+
+    #[test]
+    fn factory_detects_qwen3_5_moe_before_dense_qwen35() {
+        let moe = fixture(json!({
+            "model_type": "qwen3_5_moe",
+            "text_config": {"model_type": "qwen3_5_moe_text"}
+        }));
+        assert!(is_qwen35_moe_checkpoint(&moe).unwrap());
+        let text = fixture(json!({"model_type": "qwen3_5_moe_text"}));
+        assert!(is_qwen35_moe_checkpoint(&text).unwrap());
+        let dense = fixture(json!({
+            "model_type": "qwen3_5",
+            "text_config": {"model_type": "qwen3_5_text"}
+        }));
+        assert!(!is_qwen35_moe_checkpoint(&dense).unwrap());
+        let _ = std::fs::remove_dir_all(moe);
+        let _ = std::fs::remove_dir_all(text);
+        let _ = std::fs::remove_dir_all(dense);
+    }
+    #[test]
+    fn workcache_recovers_after_two_cancelled_slots_and_out_of_order_returns() {
+        let mut cache: WorkCache<u32> = WorkCache::default();
+        cache.reset((1, 1, 1), 10, 11);
+        let a = cache.take_slot().unwrap();
+        let b = cache.take_slot().unwrap();
+        assert_eq!((a, b), (10, 11));
+        assert!(cache.take_slot().is_none());
+        assert!(cache.return_slot((1, 1, 1), b).is_ok());
+        assert!(cache.return_slot((1, 1, 2), a).is_err());
+        assert_eq!(cache.take_slot(), Some(11));
+        assert!(cache.return_slot((1, 1, 1), a).is_ok());
+        assert_eq!(cache.take_slot(), Some(10));
+    }
+
+    #[test]
+    fn workcache_partial_constructor_failure_cannot_commit_partial_slots() {
+        // reset only accepts both completed owners; there is no partial commit API.
+        let mut cache: WorkCache<u32> = WorkCache::default();
+        let result: Result<(u32, u32), &'static str> = Err("second constructor failed");
+        if let Ok((first, second)) = result {
+            cache.reset((1, 1, 1), first, second);
+        }
+        assert_eq!(cache.key, None);
+        assert!(cache.slots.iter().all(Option::is_none));
+    }
+    #[test]
+    fn factory_error_classification_preserves_backend_overloaded_and_unhealthy() {
+        use crate::qwen35_moe_engine::ExperimentalMoeError as E;
+        assert!(matches!(
+            moe_error(E::Backend(BackendError::Overloaded("busy".into()))),
+            BackendError::Overloaded(_)
+        ));
+        assert!(matches!(
+            moe_error(E::Backend(BackendError::Unhealthy)),
+            BackendError::Unhealthy
+        ));
+        assert!(matches!(
+            moe_error(E::Cold("cold".into())),
+            BackendError::Start(message) if message == "cold"
+        ));
+        assert!(matches!(
+            moe_error(E::Admission("runtime".into())),
+            BackendError::Inference(message) if message == "runtime"
+        ));
+    }
+}
