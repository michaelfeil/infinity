+fn base_entries(packed: bool, separate_too: bool) -> Vec<Entry> {
+    let hidden = 16;
+    let vocab = 32;
+    let experts = 4;
+    let intermediate = 6;
+    let shared = 6;
+    let layers = 4;
+    let mut entries = vec![
+        entry(
+            format!("{ROOT}embed_tokens.weight"),
+            vec![vocab, hidden],
+            Dtype::BF16,
+            1000.0,
+        ),
+        entry(
+            format!("{ROOT}norm.weight"),
+            vec![hidden],
+            Dtype::BF16,
+            2000.0,
+        ),
+        entry(
+            "lm_head.weight".to_owned(),
+            vec![vocab, hidden],
+            Dtype::BF16,
+            3000.0,
+        ),
+    ];
+    for layer in 0..layers {
+        let prefix = format!("{ROOT}layers.{layer}");
+        let base = 10_000.0 * (layer as f32 + 1.0);
+        entries.push(entry(
+            format!("{prefix}.input_layernorm.weight"),
+            vec![hidden],
+            Dtype::BF16,
+            base,
+        ));
+        entries.push(entry(
+            format!("{prefix}.post_attention_layernorm.weight"),
+            vec![hidden],
+            Dtype::BF16,
+            base + 100.0,
+        ));
+        entries.push(entry(
+            format!("{prefix}.mlp.gate.weight"),
+            vec![experts, hidden],
+            Dtype::BF16,
+            base + 200.0,
+        ));
+        if packed {
+            entries.push(entry(
+                format!("{prefix}.mlp.experts.gate_up_proj"),
+                vec![experts, intermediate * 2, hidden],
+                Dtype::BF16,
+                base + 300.0,
+            ));
+            entries.push(entry(
+                format!("{prefix}.mlp.experts.down_proj"),
+                vec![experts, hidden, intermediate],
+                Dtype::BF16,
+                base + 400.0,
+            ));
+        }
+        if !packed || separate_too {
+            for expert in 0..experts {
+                let expert_base = base + 500.0 + 1000.0 * expert as f32;
+                entries.push(entry(
+                    format!("{prefix}.mlp.experts.{expert}.gate_proj.weight"),
+                    vec![intermediate, hidden],
+                    Dtype::BF16,
+                    expert_base,
+                ));
+                entries.push(entry(
+                    format!("{prefix}.mlp.experts.{expert}.up_proj.weight"),
+                    vec![intermediate, hidden],
+                    Dtype::BF16,
+                    expert_base + 100.0,
+                ));
+                entries.push(entry(
+                    format!("{prefix}.mlp.experts.{expert}.down_proj.weight"),
+                    vec![hidden, intermediate],
+                    Dtype::BF16,
+                    expert_base + 200.0,
+                ));
+            }
+        }
+        entries.push(entry(
+            format!("{prefix}.mlp.shared_expert.gate_proj.weight"),
+            vec![shared, hidden],
+            Dtype::BF16,
+            base + 8000.0,
+        ));
+        entries.push(entry(
+            format!("{prefix}.mlp.shared_expert.up_proj.weight"),
+            vec![shared, hidden],
+            Dtype::BF16,
+            base + 8200.0,
+        ));
+        entries.push(entry(
+            format!("{prefix}.mlp.shared_expert.down_proj.weight"),
+            vec![hidden, shared],
+            Dtype::BF16,
+            base + 8400.0,
+        ));
+        entries.push(entry(
+            format!("{prefix}.mlp.shared_expert_gate.weight"),
+            vec![1, hidden],
+            Dtype::BF16,
+            base + 8600.0,
+        ));
+    }
+    entries
+}
