+    fn failed_work_fence_poison_is_admitted_as_unhealthy() {
+        assert!(!engine_unhealthy(false, false));
+        assert!(engine_unhealthy(true, false));
+        assert!(engine_unhealthy(false, true));
+        assert!(engine_unhealthy(true, true));
+    }
+}
diff -ruN a/infinity-v3/backends/oxide/src/qwen35_moe_enqueue.rs b/infinity-v3/backends/oxide/src/qwen35_moe_enqueue.rs
--- a/infinity-v3/backends/oxide/src/qwen35_moe_enqueue.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/infinity-v3/backends/oxide/src/qwen35_moe_enqueue.rs	2026-11-02 06:28:39.214780125 -0800
@@ -0,0 +1,227 @@
+// Typed routed-FFN enqueue preparation for Qwen3.5-MoE.
+//
+// This module owns no stream and queries nothing at enqueue time. The provider
+// artifact supplies the architecture-specific workspace size and kernel plan
+// (SM90 Hopper vs portable SM100/120). Every cross-context, length, geometry,
+// workspace and workspace-alignment guard runs before the single ABI forward.
+// No safe API accepts raw pointers; the caller must keep every typed owner and
+// the bound stream alive until completion, and a failure is final (no retry or
+// fallback).
+
+use crate::cublas::Blas;
+use crate::moe_abi::{Buffers, ABI_VERSION};
+use crate::qwen35_moe_device::Qwen35MoeDeviceFfn;
+use crate::qwen35_moe_provider::PreparedQwen35MoeRouted;
+use crate::tensor::Bf16;
+use crate::{arg, infer, launch, product, u32_size};
+use cuda_core::{DeviceBuffer, Function, Stream};
+use infinity_v3_backend_core::BackendError;
+use std::sync::Arc;
+
+const WORKSPACE_ALIGNMENT: usize = 256;
+const CAST_THREADS: u32 = 256;
+
+/// Provider-derived workspace capacity. The actual size comes from
+/// `oxide_moe_query_workspace` for the selected architecture, so the Hopper ABI
+/// is never approximated by the portable layout.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct RoutedWorkspacePlan {
+    bytes: usize,
+}
+
+impl RoutedWorkspacePlan {
+    pub(crate) fn from_prepared(prepared: &PreparedQwen35MoeRouted) -> Result<Self, BackendError> {
+        let bytes = prepared.workspace_bytes();
+        if bytes == 0 || !bytes.is_multiple_of(WORKSPACE_ALIGNMENT) {
+            return Err(infer(
+                "provider workspace must be nonzero and 256-byte aligned",
+            ));
+        }
+        Ok(Self { bytes })
+    }
+
+    pub(crate) const fn bytes(&self) -> usize {
+        self.bytes
+    }
+}
+
+/// Typed buffers owned by the outer backbone/request. The routed enqueue
+/// borrows them; it does not allocate, sort, read back or synchronize.
+pub(crate) struct RoutedFfnBuffers<'a> {
+    pub(crate) input: &'a DeviceBuffer<Bf16>,
+    pub(crate) output: &'a mut DeviceBuffer<Bf16>,
+    pub(crate) logits_bf16: &'a mut DeviceBuffer<Bf16>,
+    pub(crate) logits_f32: &'a DeviceBuffer<f32>,
+    pub(crate) workspace: &'a mut DeviceBuffer<u8>,
+    pub(crate) stream: &'a Arc<Stream>,
+}
+
+fn same_context(actual: &Arc<cuda_core::Context>, expected: &Arc<cuda_core::Context>) -> bool {
+    Arc::ptr_eq(actual, expected)
+}
+
+/// Enqueue router linear + BF16->F32 widening + one Native ABI forward.
+///
+/// # Safety
+/// The caller must bind the provider context on this thread. Every typed buffer
+/// and `layer` must belong to that context and stay alive without conflicting
+/// access until `stream` drains. `workspace` must be at least
+/// `RoutedWorkspacePlan::bytes()` and 256-byte aligned. The caller owns
+/// completion; on error the whole stream must be drained or quarantined.
+pub(crate) unsafe fn enqueue_routed_ffn(
+    prepared: &PreparedQwen35MoeRouted,
+    layer: &Qwen35MoeDeviceFfn,
+    blas: &Blas,
+    cast_bf16_to_f32: &Function,
+    buffers: RoutedFfnBuffers<'_>,
+    workspace_plan: RoutedWorkspacePlan,
+) -> Result<(), BackendError> {
+    let tokens = prepared.tokens();
+    let hidden = prepared.hidden();
+    let intermediate = prepared.intermediate();
+    if tokens == 0
+        || layer.hidden != hidden
+        || layer.intermediate != intermediate
+        || layer.experts != 256
+        || prepared.shape().experts != 256
+        || prepared.shape().top_k != 8
+        || prepared.shape().hidden as usize != hidden
+        || prepared.shape().intermediate as usize != intermediate
+    {
+        return Err(infer("routed FFN geometry differs from the prepared plan"));
+    }
+    if !same_context(blas.context(), buffers.stream.context()) {
+        return Err(infer("routed FFN BLAS and stream contexts differ"));
+    }
+    if blas.stream().cu_stream() != buffers.stream.cu_stream() {
+        return Err(infer("routed FFN BLAS and consumer streams differ"));
+    }
+    for actual in [
+        buffers.input.context(),
+        buffers.output.context(),
+        buffers.logits_bf16.context(),
+        buffers.logits_f32.context(),
+        buffers.workspace.context(),
+        layer.router.context(),
+        layer.gate_up.context(),
+        layer.down.context(),
+    ] {
+        if !same_context(actual, buffers.stream.context()) {
+            return Err(infer("routed FFN buffer belongs to a different context"));
+        }
+    }
+    let hidden_elements = product(tokens, hidden)?;
+    let logits_elements = product(tokens, 256)?;
+    if buffers.input.len() < hidden_elements
+        || buffers.output.len() < hidden_elements
+        || buffers.logits_bf16.len() < logits_elements
+        || buffers.logits_f32.len() < logits_elements
+        || buffers.workspace.len() < workspace_plan.bytes()
+    {
+        return Err(infer(
+            "routed FFN buffer is shorter than the prepared prefix",
+        ));
+    }
+    ensure_forward_admitted(prepared)?;
+    let (expected_router, expected_gate_up, expected_down) =
+        routed_weight_lengths(hidden, intermediate)?;
+    if layer.router.len() != expected_router
+        || layer.gate_up.len() != expected_gate_up
+        || layer.down.len() != expected_down
+    {
+        return Err(infer(
+            "routed FFN device weight lengths differ from canonical geometry",
+        ));
+    }
+
+    let router_arguments = prepared
+        .router_plan()
+        .bind(buffers.input, &layer.router, buffers.logits_bf16)
+        .map_err(infer)?;
+    // SAFETY: contexts/lengths checked above; owners are retained by the caller.
+    unsafe { blas.linear_bound(&router_arguments)? };
+
+    let mut source = buffers.logits_bf16.cu_deviceptr();
+    let mut destination = buffers.logits_f32.cu_deviceptr();
+    let mut selected: u64 = 0;
+    let mut count = u32_size(logits_elements)?;
+    let mut width = 1u32;
+    let grid = (
+        u32_size(logits_elements.div_ceil(CAST_THREADS as usize))?,
+        1,
+        1,
+    );
+    // The fixed BF16->F32 widening ABI covers exactly `logits_elements`; all
+    // owners outlive the enqueue.
+    launch(
+        cast_bf16_to_f32,
+        buffers.stream,
+        grid,
+        0,
+        &mut [
+            arg(&mut source),
+            arg(&mut destination),
+            arg(&mut selected),
+            arg(&mut count),
+            arg(&mut width),
+        ],
+    )?;
+
+    let abi_buffers = Buffers {
+        struct_size: std::mem::size_of::<Buffers>() as u32,
+        abi_version: ABI_VERSION,
+        logits: buffers.logits_f32.cu_deviceptr() as *const f32,
+        input_bf16: buffers.input.cu_deviceptr() as *const std::ffi::c_void,
+        gate_up_weight_bf16: layer.gate_up.cu_deviceptr() as *const std::ffi::c_void,
+        down_weight_bf16: layer.down.cu_deviceptr() as *const std::ffi::c_void,
+        expert_scales: std::ptr::null(),
+        output_bf16: buffers.output.cu_deviceptr() as *mut std::ffi::c_void,
+        workspace: buffers.workspace.cu_deviceptr() as *mut std::ffi::c_void,
+        workspace_bytes: workspace_plan.bytes(),
+        stream: buffers.stream.cu_stream().cast(),
+        flags: 0,
+        reserved: [0; 3],
+    };
+    // SAFETY: the caller guaranteed context binding, owner lifetime and
+    // workspace capacity; the retained plan matches this frame exactly.
+    unsafe { prepared.plan().forward_bound(&abi_buffers) }.map_err(infer)
+}
+
+/// Canonical ABI1 Qwen35 routed weight lengths for `[E,H]`, `[E,2I,H]` and
+/// `[E,H,I]`. The `2I` factor is explicit; this is deliberately pure so the
+/// length guard is testable without a CUDA context.
+pub(crate) fn routed_weight_lengths(
+    hidden: usize,
+    intermediate: usize,
+) -> Result<(usize, usize, usize), BackendError> {
+    let experts = 256usize;
+    let router = product(experts, hidden)?;
+    let gate_up = product(product(experts, product(intermediate, 2)?)?, hidden)?;
+    let down = product(product(experts, hidden)?, intermediate)?;
+    Ok((router, gate_up, down))
+}
+
+/// Compile-only providers (SM100/SM120) may expose CPU metadata and prepare a
+/// plan, but must never be enqueued as though Root had qualified them.
+pub(crate) fn ensure_forward_admitted(
+    prepared: &PreparedQwen35MoeRouted,
+) -> Result<(), BackendError> {
+    if prepared.contract().compile_only() {
+        return Err(infer(
+            "compile-only provider cannot enqueue a routed FFN before Root GPU qualification",
+        ));
+    }
+    Ok(())
+}
+
+/// Pure guard used by CPU tests: verifies the workspace plan is 256-aligned and
+/// that the ABI descriptor size matches the mirrored C header.
+pub(crate) fn validate_ffn_contract(plan: RoutedWorkspacePlan) -> Result<(), BackendError> {
+    if plan.bytes() == 0 || !plan.bytes().is_multiple_of(WORKSPACE_ALIGNMENT) {
+        return Err(infer("workspace plan is not 256-byte aligned"));
+    }
+    if std::mem::size_of::<Buffers>() != 96 || ABI_VERSION != 1 {
+        return Err(infer("ABI1 Buffers layout drift"));
+    }
+    Ok(())
+}
diff -ruN a/infinity-v3/backends/oxide/src/qwen35_moe_factory.rs b/infinity-v3/backends/oxide/src/qwen35_moe_factory.rs
--- a/infinity-v3/backends/oxide/src/qwen35_moe_factory.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/infinity-v3/backends/oxide/src/qwen35_moe_factory.rs	2026-11-02 07:53:22.584208640 -0800
@@ -0,0 +1,501 @@
+//! Normal service-factory owner for the actual Qwen3.5-MoE text backbone.
+//!
+//! This is a thin owning adapter over the tested `ExperimentalMoEEngine`. It
+//! does not create a CUDA context or upload weights per request; one engine is
+//! constructed at cold startup and owns the stream, weights, two pooled host-I/O
+//! leases and request Work arena. Deferred inference acquires one lease and
+//! reuses one Work buffer when the request geometry matches.
+
+use crate::output;
+use crate::qwen35_moe_engine::{
+    ExperimentalMoEEngine, ExperimentalMoELease, ExperimentalMoEOptions, ExperimentalMoEWork,
+};
+use infinity_v3_backend_core::{
+    result_memory, Backend, BackendError, Batch, Embeddings, Inference, ModelType, Pool,
+    Predictions, TokenPredictions,
+};
+use serde_json::Value;
+use std::mem::ManuallyDrop;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+pub fn is_qwen35_moe_checkpoint(path: &Path) -> Result<bool, BackendError> {
+    let value: Value = serde_json::from_slice(
+        &std::fs::read(path.join("config.json"))
+            .map_err(|error| BackendError::Start(format!("read config.json: {error}")))?,
+    )
+    .map_err(|error| BackendError::Start(format!("parse config.json: {error}")))?;
+    let root = value.get("model_type").and_then(Value::as_str);
+    let text = value
+        .get("text_config")
+        .and_then(Value::as_object)
+        .and_then(|text| text.get("model_type"))
+        .and_then(Value::as_str);
+    Ok(matches!(root, Some("qwen3_5_moe" | "qwen3_5_moe_text"))
+        || matches!(text, Some("qwen3_5_moe_text")))
+}
+
+pub struct Qwen35MoeBackend {
+    engine: Arc<ExperimentalMoEEngine>,
+    pool: Pool,
+    work: Arc<Mutex<WorkCache>>,
+}
+
+struct WorkCache<W = ExperimentalMoEWork> {
+    key: Option<(usize, usize, usize)>,
+    slots: Vec<Option<W>>,
+}
+
+impl<W> Default for WorkCache<W> {
+    fn default() -> Self {
+        Self {
+            key: None,
+            slots: vec![None, None],
+        }
+    }
+}
+
+impl<W> WorkCache<W> {
+    fn reset(&mut self, key: (usize, usize, usize), first: W, second: W) {
+        self.key = Some(key);
+        self.slots = vec![Some(first), Some(second)];
+    }
+
+    fn take_slot(&mut self) -> Option<W> {
+        self.slots.iter_mut().find_map(|slot| slot.take())
+    }
+
+    fn return_slot(&mut self, key: (usize, usize, usize), work: W) -> Result<(), W> {
+        if self.key != Some(key) {
+            return Err(work);
+        }
+        if let Some(slot) = self.slots.iter_mut().find(|slot| slot.is_none()) {
+            *slot = Some(work);
+            Ok(())
+        } else {
+            Err(work)
+        }
+    }
+}
+
+struct PendingFrame {
+    lease: Option<ManuallyDrop<ExperimentalMoELease>>,
+    work: Option<ManuallyDrop<ExperimentalMoEWork>>,
+    engine: Option<ManuallyDrop<Arc<ExperimentalMoEEngine>>>,
+    cache: Arc<Mutex<WorkCache>>,
+    key: (usize, usize, usize),
+    selected_count: usize,
+    batch: Batch,
+    hidden: usize,
+    memory: Option<result_memory::ResultLease>,
+    settled: bool,
+}
+
+impl PendingFrame {
+    #[allow(clippy::too_many_arguments)]
+    fn new(
+        lease: ExperimentalMoELease,
+        work: ExperimentalMoEWork,
+        engine: Arc<ExperimentalMoEEngine>,
+        cache: Arc<Mutex<WorkCache>>,
+        key: (usize, usize, usize),
+        batch: Batch,
+        hidden: usize,
+        memory: result_memory::ResultLease,
+    ) -> Self {
+        Self {
+            lease: Some(ManuallyDrop::new(lease)),
+            work: Some(ManuallyDrop::new(work)),
+            engine: Some(ManuallyDrop::new(engine)),
+            cache,
+            key,
+            selected_count: 0,
+            batch,
+            hidden,
+            memory: Some(memory),
+            settled: false,
+        }
+    }
+
+    fn enqueue(&mut self, pool: Pool) -> Result<(), BackendError> {
+        let engine = self.engine.as_deref().ok_or(BackendError::Unhealthy)?;
+        let lease = self.lease.as_deref_mut().ok_or(BackendError::Unhealthy)?;
+        let work = self.work.as_deref_mut().ok_or(BackendError::Unhealthy)?;
+        self.selected_count = engine
+            .enqueue(work, &self.batch, lease, pool)
+            .map_err(moe_error)?;
+        Ok(())
+    }
+
+    fn complete(mut self) -> Result<Embeddings, BackendError> {
+        let lease = self.lease.as_deref_mut().ok_or(BackendError::Unhealthy)?;
+        self.engine
+            .as_deref()
+            .ok_or(BackendError::Unhealthy)?
+            .wait(lease)
+            .map_err(moe_error)?;
+        let selected = lease.output(self.selected_count)?;
+        let mut embeddings = output::pack(
+            selected,
+            self.hidden,
+            self.hidden,
+            &self.batch.pooled_indices,
+            &self.batch.raw_indices,
+            &self.batch.cumulative_seq_lengths,
+        )?;
+        embeddings.memory = self.memory.take();
+        self.settle_success()?;
+        Ok(embeddings)
+    }
+
+    fn settle_success(&mut self) -> Result<(), BackendError> {
+        if self.settled {
+            return Ok(());
+        }
+        let engine = self.engine.as_deref().ok_or(BackendError::Unhealthy)?;
+        let lease = self.lease.as_deref().ok_or(BackendError::Unhealthy)?;
+        let proof = engine.completion_proof(lease);
+        let work =
+            unsafe { ManuallyDrop::take(self.work.as_mut().ok_or(BackendError::Unhealthy)?) };
+        let mut pending_work = Some(work);
+        if let Ok(mut cache) = self.cache.lock() {
+            match cache.return_slot(self.key, pending_work.take().unwrap()) {
+                Ok(()) => {}
+                Err(work) => pending_work = Some(work),
+            }
+        }
+        if let Some(mut work) = pending_work {
+            match proof {
+                Some(proof) if unsafe { work.release_after_completion(&proof) }.is_ok() => {}
+                _ => {
+                    std::mem::forget(work);
+                    self.quarantine();
+                    return Err(BackendError::Unhealthy);
+                }
+            }
+        }
+        if let Some(mut lease) = self.lease.take() {
+            // SAFETY: the fence completed and this is the only owner.
+            unsafe { ManuallyDrop::drop(&mut lease) };
+        }
+        if let Some(engine) = self.engine.take() {
+            let engine = ManuallyDrop::into_inner(engine);
+            drop(engine);
+        }
+        self.settled = true;
+        Ok(())
+    }
+
+    fn quarantine(&mut self) {
+        if let Some(engine) = self.engine.as_deref() {
+            engine.poison_after_failed_fence();
+        }
+        if let Some(lease) = self.lease.take() {
+            std::mem::forget(ManuallyDrop::into_inner(lease));
+        }
+        if let Some(work) = self.work.take() {
+            std::mem::forget(ManuallyDrop::into_inner(work));
+        }
+        if let Some(engine) = self.engine.take() {
+            std::mem::forget(ManuallyDrop::into_inner(engine));
+        }
+        self.settled = true;
+    }
+
+    fn settle_cancelled(&mut self) {
+        if self.settled {
+            return;
+        }
+        let wait = match (self.engine.as_deref(), self.lease.as_deref_mut()) {
+            (Some(engine), Some(lease)) => engine.wait(lease).map_err(moe_error),
+            _ => Err(BackendError::Unhealthy),
+        };
+        match wait {
+            Ok(()) => {
+                let _ = self.settle_success();
+            }
+            Err(_) => self.quarantine(),
+        }
+    }
+}
+
+impl Drop for PendingFrame {
+    fn drop(&mut self) {
+        if self.settled {
+            return;
+        }
+        self.settle_cancelled();
+    }
+}
+
+impl Qwen35MoeBackend {
+    pub fn new(
+        path: &Path,
+        dtype: &str,
+        model_type: ModelType,
+        device_id: usize,
+    ) -> Result<Self, BackendError> {
+        if !matches!(dtype, "bfloat16" | "bf16") {
+            return Err(BackendError::Start(
+                "Qwen3.5-MoE factory route requires bfloat16".into(),
+            ));
+        }
+        let pool = match model_type {
+            ModelType::Embedding(pool @ (Pool::Cls | Pool::Mean | Pool::LastToken)) => pool,
+            ModelType::Classifier => {
+                return Err(BackendError::Start(
+                    "Qwen3.5-MoE factory route does not implement a score head; typed unsupported"
+                        .into(),
+                ))
+            }
+            ModelType::Decision => {
+                return Err(BackendError::Start(
+                    "Qwen3.5-MoE factory route does not implement Decision; typed unsupported"
+                        .into(),
+                ))
+            }
+            ModelType::Embedding(Pool::Splade) => {
+                return Err(BackendError::Start(
+                    "Qwen3.5-MoE factory route does not implement SPLADE; typed unsupported".into(),
+                ))
+            }
+        };
+        if !is_qwen35_moe_checkpoint(path)? {
+            return Err(BackendError::Start(
+                "Qwen3.5-MoE factory route requires a qwen3_5_moe checkpoint".into(),
+            ));
+        }
+        let options = ExperimentalMoEOptions::from_environment().map_err(moe_error)?;
+        let engine = ExperimentalMoEEngine::load(path, device_id, options).map_err(moe_error)?;
+        Ok(Self {
+            engine: Arc::new(engine),
+            pool,
+            work: Arc::new(Mutex::new(WorkCache::default())),
+        })
+    }
+
+    fn prepare_embedding(&self, batch: Batch) -> Result<Inference<Embeddings>, BackendError> {
+        let tokens = batch.input_ids.len();
+        let sequences = batch
+            .cumulative_seq_lengths
+            .len()
+            .checked_sub(1)
+            .filter(|count| *count > 0)
+            .ok_or_else(|| BackendError::Inference("missing sequence boundaries".into()))?;
+        // Authoritative production validation before Work/cache mutation,
+        // lease acquisition, result reservation or any launch. Runs even when
+        // no pooled/raw selections are requested.
+        self.engine.validate_batch(&batch).map_err(moe_error)?;
+        let max_len = batch
+            .cumulative_seq_lengths
+            .windows(2)
+            .map(|pair| pair[1].saturating_sub(pair[0]) as usize)
+            .max()
+            .unwrap_or(0);
+        let key = (tokens, sequences, max_len);
+        let raw_rows = output::raw_rows(&batch)?;
+        let selected_rows = batch
+            .pooled_indices
+            .len()
+            .checked_add(raw_rows)
+            .ok_or_else(|| BackendError::Inference("selected row overflow".into()))?;
+        if selected_rows > tokens.saturating_add(sequences) {
+            return Err(BackendError::Inference(
+                "duplicate selectors exceed the bounded MoE selected-output capacity".into(),
+            ));
+        }
+        let hidden = self.engine.hidden_size().map_err(moe_error)?;
+        // Reserve results before enqueue so a budget rejection cannot follow a
+        // launch or mutate cached Work.
+        let memory =
+            result_memory::global_pool()?.reserve(output::result_bytes(&batch, hidden, hidden)?)?;
+        if selected_rows == 0 {
+            let mut empty = Embeddings::default();
+            empty.memory = Some(memory);
+            return Ok(Inference::Ready(empty));
+        }
+        let mut cache = self.work.lock().map_err(|_| BackendError::Unhealthy)?;
+        if cache.key != Some(key) {
+            if self.engine.active_leases().map_err(moe_error)? > 0 {
+                return Err(BackendError::Overloaded(
+                    "Qwen3.5-MoE geometry growth while a result is held".into(),
+                ));
+            }
+            // Transactional construction: commit key/slots only after both
+            // Works exist. A partial constructor failure leaves the old cache
+            // state untouched and returns the typed engine error.
+            let first = self
+                .engine
+                .work(tokens, sequences, max_len)
+                .map_err(moe_error)?;
+            let second = self
+                .engine
+                .work(tokens, sequences, max_len)
+                .map_err(moe_error)?;
+            cache.reset(key, first, second);
+        }
+        let work = cache.take_slot().ok_or_else(|| {
+            BackendError::Overloaded(
+                "third concurrent Qwen3.5-MoE result exceeds the two host slots".into(),
+            )
+        })?;
+        drop(cache);
+        let lease = match self.engine.lease() {
+            Ok(lease) => lease,
+            Err(error) => {
+                if let Ok(mut cache) = self.work.lock() {
+                    if cache.key == Some(key) {
+                        let _ = cache.return_slot(key, work);
+                    }
+                }
+                return Err(moe_error(error));
+            }
+        };
+        // Full owner exists before Deferred is returned, so cancellation and
+        // enqueue failure both traverse the same PendingFrame Drop path.
+        let mut frame = PendingFrame::new(
+            lease,
+            work,
+            Arc::clone(&self.engine),
+            Arc::clone(&self.work),
+            key,
+            batch,
+            hidden,
+            memory,
+        );
+        frame.enqueue(self.pool.clone())?;
+        Ok(Inference::Deferred(Box::new(move || frame.complete())))
+    }
+}
+
+fn hidden_width(output_len: usize, tokens: usize) -> Result<usize, BackendError> {
+    output_len
+        .checked_div(tokens)
+        .filter(|width| *width > 0 && width.checked_mul(tokens) == Some(output_len))
+        .ok_or_else(|| BackendError::Inference("Qwen3.5-MoE hidden width mismatch".into()))
+}
+
+fn moe_error(error: crate::qwen35_moe_engine::ExperimentalMoeError) -> BackendError {
+    use crate::qwen35_moe_engine::ExperimentalMoeError as E;
+    match error {
+        E::Backend(error) => error,
+        E::Cold(message) => BackendError::Start(message),
+        E::MissingFa4Profile(proposal) => BackendError::Start(format!("{proposal:?}")),
+        E::Admission(message) => BackendError::Inference(message),
+    }
+}
+
+impl Backend for Qwen35MoeBackend {
+    fn health(&self) -> Result<(), BackendError> {
+        self.engine.health_check().map_err(moe_error)
+    }
+
+    fn embed(&self, batch: Batch) -> Result<Embeddings, BackendError> {
+        self.submit_embed(batch)?.complete()
+    }
+
+    fn submit_embed(&self, batch: Batch) -> Result<Inference<Embeddings>, BackendError> {
+        self.prepare_embedding(batch)
+    }
+
+    fn predict(&self, _batch: Batch) -> Result<Predictions, BackendError> {
+        Err(BackendError::Inference(
+            "Qwen3.5-MoE score head is not implemented; typed unsupported".into(),
+        ))
+    }
+
+    fn predict_tokens(&self, _batch: Batch) -> Result<TokenPredictions, BackendError> {
+        Err(BackendError::Inference(
+            "Qwen3.5-MoE token score head is not implemented; typed unsupported".into(),
+        ))
+    }
+}
