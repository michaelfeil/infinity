+        multimodal: vec![None; lengths.len()],
+        input_ids: (0..tokens).map(|index| (index % 7 + 1) as u32).collect(),
+        token_type_ids: vec![0; tokens],
+        position_ids: positions,
+        cumulative_seq_lengths: cumulative,
+        max_length: *lengths.iter().max().unwrap_or(&0) as u32,
+        pooled_indices: (0..lengths.len() as u32).collect(),
+        raw_indices: Vec::new(),
+        compact_input_ids: None,
+        compact_position_ids: None,
+        scatter_unfold: None,
+        fold_gather: None,
+        tokens: Vec::new(),
+        offsets: {
