+#[allow(dead_code)]
+pub(crate) fn decoder_128_tables(
+    theta: f64,
+    positions: usize,
+    byte_limit: usize,
+    stream: &Arc<Stream>,
+    initializer: Arc<Function>,
+) -> Result<(DeviceBuffer<f32>, DeviceBuffer<f32>), BackendError> {
+    let plan = decoder_128_plan(theta, positions, byte_limit)?;
