+/// A params.json-only directory is only admitted through the Mistral3 wrapper;
+/// the normalifier is shared by config parsing and rejects malformed/other
+/// short-key schemas with a typed error before any driver/device work.
+fn params_only_mistral3(path: &Path) -> Result<bool, BackendError> {
