+    let Some(value) = value.filter(|value| !value.is_null()) else {
+        return Ok(None);
+    };
+    let kind = value
+        .get("rope_type")
+        .or_else(|| value.get("type"))
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("default");
+    if kind == "default" {
+        return Ok(None);
+    }
+    if kind != "yarn" {
+        return Err(start(format!(
+            "unsupported Mistral rotary configuration {kind}; default or yarn only"
+        )));
+    }
+    let real = |key: &str, fallback: f64| {
+        value
+            .get(key)
+            .and_then(serde_json::Value::as_f64)
+            .unwrap_or(fallback)
+    };
+    let llama4 = |key: &str, fallback: f64| {
+        llama_4_scaling
+            .filter(|_| value.get("llama_4_scaling_beta").is_none())
+            .and_then(|value| value.get(key))
+            .and_then(serde_json::Value::as_f64)
+            .unwrap_or(fallback)
+    };
+    let yarn = YarnRope {
+        factor: real("factor", 1.0),
+        original_max_position_embeddings: real("original_max_position_embeddings", 0.0),
+        beta_fast: real("beta_fast", 32.0),
+        beta_slow: real("beta_slow", 1.0),
+        mscale: real("mscale", 0.0),
+        mscale_all_dim: real("mscale_all_dim", 0.0),
+        llama_4_scaling_beta: real("llama_4_scaling_beta", llama4("beta", 0.0)),
+    };
+    yarn.validate()?;
+    Ok(Some(yarn))
