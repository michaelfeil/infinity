+        let mut lease = self
+            .lease
+            .take()
+            .ok_or_else(|| infer("Mistral3 pending request has no host lease"))?;
+        if let Err(error) = lease.wait() {
+            if let Some(media) = self.media.take() {
+                // The fence did not complete; keep pinned H2D owners alive with
+                // the quarantined engine rather than freeing them early.
+                std::mem::forget(media);
