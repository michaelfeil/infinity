+                ptr,
+                self.slot.host.as_ptr(),
+                bytes,
+                self.stream.cu_stream(),
+            )
+        }
+        .map_err(start)
+    }
+
+    fn record(&mut self) -> Result<(), BackendError> {
+        self.slot.complete.record(self.stream).map_err(start)?;
+        self.slot.pending = true;
+        Ok(())
+    }
+}
+
+fn fill_plan<S: StagingSlot>(
+    slots: &mut [S; 2],
