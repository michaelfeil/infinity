+impl Drop for Mistral3Pending {
+    fn drop(&mut self) {
+        if self.finished {
+            return;
+        }
+        let mut lease = self.lease.take();
+        let healthy = match lease.as_mut() {
+            Some(lease) => lease.wait().is_ok(),
+            None => false,
+        };
+        if !healthy {
+            if let Some(media) = self.media.take() {
+                std::mem::forget(media);
+            }
+        }
+        crate::staging::finish_before_release(|| self.release(healthy), || drop(lease));
+    }
