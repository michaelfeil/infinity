+/// Completion ordering used by deferred request owners: mark the engine work
+/// complete/quarantined before the HostIo slot becomes visible to another
+/// submit. Both operations are explicit so the lock order stays engine -> pool
+/// and the slot never precedes its work.
+pub(crate) fn finish_before_release<T>(finish: impl FnOnce(), release: impl FnOnce() -> T) -> T {
+    finish();
+    release()
