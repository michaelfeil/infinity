+fn validate_mistral3(
+    batch: &Batch,
+    config: &mistral3::Mistral3Config,
+) -> Result<usize, BackendError> {
+    let fail = || infer("Invalid or unsupported packed oxide Mistral3 batch");
+    let tokens = batch.input_ids.len();
+    let sequences = batch
+        .cumulative_seq_lengths
+        .len()
+        .checked_sub(1)
+        .filter(|count| *count > 0)
+        .ok_or_else(fail)?;
+    if tokens == 0
+        || batch.cumulative_seq_lengths.first() != Some(&0)
+        || batch
+            .cumulative_seq_lengths
+            .last()
+            .copied()
+            .map(|value| value as usize)
+            != Some(tokens)
+        || batch.position_ids.len() != tokens
+        || batch.token_type_ids.len() != tokens
+        || batch.token_type_ids.iter().any(|&kind| kind != 0)
+        || batch.compact_input_ids.is_some()
+        || batch.compact_position_ids.is_some()
+        || batch.scatter_unfold.is_some()
+        || batch.fold_gather.is_some()
+    {
+        return Err(fail());
+    }
+    if batch
+        .input_ids
+        .iter()
+        .any(|&id| id as usize >= config.text.vocab_size)
+    {
+        return Err(infer("Mistral3 token id exceeds vocab_size"));
+    }
+    if batch
+        .pooled_indices
+        .iter()
+        .chain(&batch.raw_indices)
+        .any(|&index| index as usize >= sequences)
+    {
+        return Err(infer("Mistral3 selector exceeds the sequence count"));
+    }
+    let mut raw_seen = std::collections::BTreeSet::new();
+    if batch
+        .raw_indices
+        .iter()
+        .any(|&index| !raw_seen.insert(index))
+    {
+        return Err(infer("Mistral3 raw selectors contain duplicates"));
+    }
+    if !batch.multimodal.is_empty() && batch.multimodal.len() != sequences {
+        return Err(fail());
+    }
+    let merge = config.spatial_merge_size;
+    if merge == 0 {
+        return Err(infer("Mistral3 spatial merge size is zero"));
+    }
+    let patch_dim = config.vision.patch_dim();
+    let maximum_grid = config.vision.image_size / config.vision.patch_size;
+    for (slot, media) in batch.multimodal.iter().enumerate() {
+        let Some(media) = media else { continue };
+        if !media.audios.is_empty() {
+            return Err(infer("Mistral3 does not admit audio"));
+        }
+        let start = batch.cumulative_seq_lengths[slot] as usize;
+        let end = batch.cumulative_seq_lengths[slot + 1] as usize;
+        let sequence_length = end
+            .checked_sub(start)
+            .ok_or_else(|| infer("Mistral3 image sequence boundary is inverted"))?;
+        for (token_start, patches) in &media.images {
+            let grid = patches.grid_thw;
+            let (temporal, height, width) = (grid[0], grid[1], grid[2]);
+            if temporal != 1
+                || height == 0
+                || width == 0
+                || !height.is_multiple_of(merge)
+                || !width.is_multiple_of(merge)
+                || patches.merge_size != merge
+            {
+                return Err(infer(
+                    "Mistral3 image grid does not match the Pixtral merge contract",
+                ));
+            }
+            if height > maximum_grid || width > maximum_grid {
+                return Err(infer(
+                    "Mistral3 image grid exceeds vision_config.image_size / patch_size",
+                ));
+            }
+            if patches.patch_dim != patch_dim {
+                return Err(infer(
+                    "Mistral3 image patch_dim does not match the vision tower",
+                ));
+            }
+            let pixels = height
+                .checked_mul(width)
+                .and_then(|rows| rows.checked_mul(patch_dim))
+                .ok_or_else(|| infer("Mistral3 image pixel count overflow"))?;
+            if patches.pixels.len() != pixels {
+                return Err(infer("Mistral3 image pixel payload has the wrong length"));
+            }
+            let token_count = patches
+                .token_count_checked()
+                .map_err(|error| infer(format!("Mistral3 image geometry rejected: {error}")))?;
+            let nh = height / merge;
+            let nw = width / merge;
+            let expected_tokens = nh
+                .checked_mul(nw)
+                .ok_or_else(|| infer("Mistral3 image token count overflow"))?;
+            if token_count != expected_tokens {
+                return Err(infer("Mistral3 image token count disagrees with its grid"));
+            }
+            let marker_block = nh
+                .checked_mul(
+                    nw.checked_add(1)
+                        .ok_or_else(|| infer("Mistral3 marker row width overflow"))?,
+                )
+                .ok_or_else(|| infer("Mistral3 marker block overflow"))?;
+            let finish = token_start
+                .checked_add(marker_block)
+                .ok_or_else(|| infer("Mistral3 image marker block overflow"))?;
+            if finish > sequence_length {
+                return Err(infer(
+                    "Mistral3 image marker block crosses a sequence boundary",
+                ));
+            }
+        }
+    }
+    let mut max_length = 0usize;
+    for pair in batch.cumulative_seq_lengths.windows(2) {
+        let start = pair[0] as usize;
+        let end = pair[1] as usize;
+        let length = end.checked_sub(start).ok_or_else(fail)?;
+        if length == 0 {
+            return Err(fail());
+        }
+        for position in &batch.position_ids[start..end] {
+            if *position as usize >= config.text.max_position_embeddings {
+                return Err(infer("Mistral3 position exceeds max_position_embeddings"));
+            }
+        }
+        max_length = max_length.max(length);
+    }
+    Ok(max_length)
+}
+
+fn mistral3_images(
+    batch: &Batch,
+) -> Result<Vec<(usize, Arc<infinity_v3_backend_core::ImagePatches>)>, BackendError> {
+    let mut images = Vec::new();
+    if batch.multimodal.is_empty() {
+        return Ok(images);
+    }
+    for (slot, media) in batch.multimodal.iter().enumerate() {
+        let Some(media) = media else { continue };
+        let base = *batch
+            .cumulative_seq_lengths
+            .get(slot)
+            .ok_or_else(|| infer("Mistral3 image sequence boundary is missing"))?
+            as usize;
+        for (token_start, patches) in &media.images {
+            images.push((
+                base.checked_add(*token_start)
+                    .ok_or_else(|| infer("Mistral3 packed image start overflow"))?,
+                patches.clone(),
+            ));
+        }
     }
+    Ok(images)
 }
 
