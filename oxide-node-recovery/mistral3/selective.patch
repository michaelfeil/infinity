+/// CPU-visible Mistral3 admission summary. Building it reads only the original
+/// config and safetensors headers: it creates no CUDA context, uploads no
+/// payload, and never claims that a pending text/vision feature is supported.
+#[derive(Debug, Clone)]
+pub struct Mistral3Admission {
+    pub vision_tensors: usize,
+    pub projector_tensors: usize,
+    pub text_layers: usize,
+    pub text_tensors: usize,
+    pub score_tensors: usize,
+    pub classifier: bool,
+    pub vision_bytes: usize,
+    pub projector_bytes: usize,
+    pub cold_plan_tensors: usize,
+    pub cold_plan_bytes: usize,
+    pub tensor_inventory: Vec<String>,
+    pub vision_profile: Option<String>,
+    pub vision_pending: Option<String>,
+    pub text_pending: Option<String>,
+    pub projector_pending: Option<String>,
+}
+
+/// Prepare the Mistral3/Pixtral composite contract on CPU. This validates the
+/// original config, every vision/projector/text tensor header and the media
+/// policy. It is safe to call offline; the separate device executor requires a
+/// real CUDA context and a Root-qualified FA4 bundle.
+pub fn admit_mistral3(path: &Path) -> Result<Mistral3Admission, BackendError> {
+    let plan = mistral3::Mistral3Plan::load(path, 0)?;
+    let (vision_profile, vision_pending) = match &plan.vision_profile {
+        Ok(profile) => (
+            Some(format!(
+                "{}heads/{}kv/d{} causal={} window={} provider_compile_pending={}",
+                profile.heads,
+                profile.kv_heads,
+                profile.head_dim,
+                profile.causal,
+                profile.window,
+                profile.pending_provider_compile
+            )),
+            None,
+        ),
+        Err(pending) => (None, Some(pending.reason().to_owned())),
+    };
+    let text_pending = plan
+        .text_profile
+        .as_ref()
+        .err()
+        .map(|pending| pending.reason().to_owned());
+    let projector_pending = plan
+        .projector_pending
+        .as_ref()
+        .map(|pending| pending.reason().to_owned());
+    let score_tensors = usize::from(plan.weights.score.is_some());
+    let text_tensors = plan
+        .inventory
+        .len()
+        .saturating_sub(plan.weights.vision.len())
+        .saturating_sub(plan.weights.projector.len())
+        .saturating_sub(score_tensors);
+    Ok(Mistral3Admission {
+        vision_tensors: plan.weights.vision.len(),
+        projector_tensors: plan.weights.projector.len(),
+        text_layers: plan.weights.text.layers.len(),
+        text_tensors,
+        score_tensors,
+        classifier: plan.config.classifier,
+        vision_bytes: plan.vision_bytes,
+        projector_bytes: plan.projector_bytes,
+        cold_plan_tensors: plan.cold.tensors().len(),
+        cold_plan_bytes: plan.cold.total_bytes(),
+        tensor_inventory: plan.inventory.clone(),
+        vision_profile,
+        vision_pending,
+        text_pending,
+        projector_pending,
+    })
+}
