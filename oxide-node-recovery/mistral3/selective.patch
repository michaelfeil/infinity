+pub(crate) fn attention_spec(config: &DecoderConfig) -> Result<fa4::AttentionSpec, BackendError> {
+    // Native applies a positive Mistral sliding_window uniformly to every
+    // layer, even when it reaches the position limit. Keep the local mask class;
+    // do not silently rewrite an explicit window to global.
+    let window = match config.attention_window {
+        None => fa4::Window::Global,
+        Some(window) => fa4::Window::Local {
+            left: i32::try_from(
+                window
+                    .checked_sub(1)
+                    .ok_or_else(|| start("decoder window underflow"))?,
+            )
+            .map_err(start)?,
+            right: 0,
+        },
+    };
+    Ok(fa4::AttentionSpec {
+        heads: config.num_attention_heads,
+        kv_heads: config.num_key_value_heads,
+        head_dim: config.head_dim,
+        causal: config.is_causal,
+        window,
+        dtype: fa4::DType::Bf16,
+        scale: fa4::Scale::RsqrtHeadDim,
+    })
+}
