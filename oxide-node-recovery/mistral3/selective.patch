+/// event (or the whole-stream fallback drain) proves the device work complete.
+struct Mistral3Pending {
+    lease: Option<HostIoLease>,
+    engine: Arc<Mutex<Engine>>,
+    work: usize,
+    hidden: usize,
+    labels: usize,
+    output_elements: usize,
+    pooled: Vec<u32>,
+    raw: Vec<u32>,
