+fn packed_qualification_batch(lengths: &[usize]) -> Result<Batch, BackendError> {
+    if lengths.is_empty() || lengths.contains(&0) {
+        return Err(infer("Mistral3 qualification lengths must be nonzero"));
+    }
+    let tokens: usize = lengths
+        .iter()
+        .try_fold(0usize, |total, length| total.checked_add(*length))
+        .ok_or_else(|| infer("Mistral3 qualification token overflow"))?;
+    let mut cumulative = Vec::with_capacity(lengths.len() + 1);
+    cumulative.push(0u32);
+    for length in lengths {
