+    candidate_repeat_dir = out / "candidate-repeat"
+    repeat_env = {**env, "INFINITY_MISTRAL3_OUT_DIR": str(candidate_repeat_dir)}
+    candidate_repeat = run([args.candidate_bin], repeat_env, out / "candidate-repeat.log")
