@@ -0,0 +1,341 @@
+// Copyright Infinity Core Contributors. Licensed under the repository LICENSE.
+//! Unified host consumer for the normal Mistral3 `OxideBackend::new` factory.
+//!
+//! This binary exists for the one granted opt3/no-LTO independent consumer run.
+//! It exercises the actual factory route (not the qualification-only handle):
+//! text embedding, image embedding, classifier score and backend lifetime.
+//! It is a binary only; it is not part of the optimized all-test-target build.
+
+use infinity_backend_oxide::OxideBackend;
+use infinity_v3_backend_core::{
+    Backend, Batch, Embedding, ImagePatches, ModelType, MultimodalEncoding, Pool,
+};
+use serde_json::json;
+use std::{
+    collections::BTreeMap,
+    fs,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::Instant,
+};
+
+const SEED: u64 = 0x4d49_5354;
+
+fn env(name: &str) -> Result<String, Box<dyn std::error::Error>> {
+    std::env::var(name).map_err(|_| format!("set {name}").into())
+}
+
+fn text_ids(tokens: usize) -> Vec<u32> {
+    (0..tokens)
+        .map(|i| (1 + (SEED + i as u64 * 37) % 1000) as u32)
+        .collect()
+}
+
+fn batch(ids: Vec<u32>, pooled: bool, media: Option<Arc<MultimodalEncoding>>) -> Batch {
+    let tokens = ids.len();
+    Batch {
+        multimodal: if media.is_some() { vec![media] } else { vec![] },
+        input_ids: ids,
+        token_type_ids: vec![0; tokens],
+        position_ids: (0..tokens as u32).collect(),
+        cumulative_seq_lengths: vec![0, tokens as u32],
+        max_length: tokens as u32,
+        pooled_indices: if pooled { vec![0] } else { Vec::new() },
+        raw_indices: Vec::new(),
+        compact_input_ids: None,
+        compact_position_ids: None,
+        scatter_unfold: None,
+        fold_gather: None,
+        tokens: Vec::new(),
+        offsets: vec![(0, tokens)],
+    }
+}
+
+fn batch_positions(ids: Vec<u32>, positions: Vec<u32>, media: Option<Arc<MultimodalEncoding>>) -> Batch {
+    let tokens = ids.len();
+    assert_eq!(positions.len(), tokens);
+    Batch {
+        multimodal: if media.is_some() { vec![media] } else { vec![] },
+        input_ids: ids,
+        token_type_ids: vec![0; tokens],
+        position_ids: positions,
+        cumulative_seq_lengths: vec![0, tokens as u32],
+        max_length: tokens as u32,
+        pooled_indices: vec![0],
+        raw_indices: Vec::new(),
+        compact_input_ids: None,
+        compact_position_ids: None,
+        scatter_unfold: None,
+        fold_gather: None,
+        tokens: Vec::new(),
+        offsets: vec![(0, tokens)],
+    }
+}
+
+fn image_case(
+    height: usize,
+    width: usize,
+    sequence_tokens: usize,
+    token_start: usize,
+    patch_size: usize,
+    merge: usize,
+    position_offset: usize,
+) -> (Batch, Arc<ImagePatches>) {
+    let mut ids = text_ids(sequence_tokens);
+    let merge_width = width / merge;
+    let merge_tokens = (height / merge) * merge_width;
+    for i in 0..merge_tokens {
+        let row = i / merge_width;
+        let column = i % merge_width;
+        ids[token_start + row * (merge_width + 1) + column] = 10;
+    }
+    let patch_dim = 3 * patch_size * patch_size;
+    let elements = height * width * patch_dim;
+    let mut pixels = Vec::with_capacity(elements);
+    for i in 0..elements {
+        let sample = (i as u32).wrapping_mul(2_654_435_761) ^ 0x9e37_79b9;
+        pixels.push((sample & 0xffff) as f32 / 65535.0);
+    }
+    let patches = Arc::new(ImagePatches {
+        pixels,
+        grid_thw: [1, height, width],
+        patch_dim,
+        merge_size: merge,
+    });
+    let media = Arc::new(MultimodalEncoding {
+        images: vec![(token_start, patches.clone())],
+        audios: vec![],
+        position_ids: std::array::from_fn(|_| {
+            (position_offset..position_offset + sequence_tokens)
+                .map(|value| value as u32)
+                .collect()
+        }),
+        memory: None,
+    });
+    (
+        batch_positions(
+            ids,
+            (position_offset..position_offset + sequence_tokens)
+                .map(|value| value as u32)
+                .collect(),
+            Some(media),
+        ),
+        patches,
+    )
+}
+
+fn write_f32(path: &Path, values: &[f32]) -> Result<(), Box<dyn std::error::Error>> {
+    let mut bytes = Vec::with_capacity(values.len() * 4);
+    for value in values {
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    fs::write(path, bytes)?;
+    Ok(())
+}
+
+fn pooled(embedding: &Embedding) -> &[f32] {
+    match embedding {
+        Embedding::Pooled(values) => values,
+        Embedding::All(rows) => rows.first().map(Vec::as_slice).unwrap_or(&[]),
+    }
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    if std::env::var_os("INFINITY_MISTRAL3_RUN_GPU").as_deref() != Some(std::ffi::OsStr::new("1")) {
+        eprintln!("set INFINITY_MISTRAL3_RUN_GPU=1 (Root GPU only)");
+        return Ok(());
+    }
+    let model = PathBuf::from(env("INFINITY_MISTRAL3_MODEL")?);
+    let out = PathBuf::from(env("INFINITY_OXIDE_MISTRAL3_OUT_DIR")?);
+    let ordinal: usize = std::env::var("INFINITY_MISTRAL3_DEVICE")
+        .unwrap_or_else(|_| "0".to_owned())
+        .parse()?;
+    let iterations: usize = std::env::var("INFINITY_MISTRAL3_ITERATIONS")
+        .unwrap_or_else(|_| "20".to_owned())
+        .parse()?;
+    let warmup: usize = std::env::var("INFINITY_MISTRAL3_WARMUP")
+        .unwrap_or_else(|_| "3".to_owned())
+        .parse()?;
+    if !std::env::var("CUDA_VISIBLE_DEVICES").is_ok_and(|value| !value.is_empty()) {
+        return Err("CUDA_VISIBLE_DEVICES must be set by Root".into());
+    }
+    env("FA4_ROOT")?;
+    env("INFINITY_OXIDE_KERNEL_MODULE")?;
+    fs::create_dir_all(&out)?;
+
+    let raw_config: serde_json::Value = serde_json::from_slice(
+        &fs::read(model.join("config.json")).or_else(|_| fs::read(model.join("params.json")))?,
+    )?;
+    let classifier = raw_config
+        .get("architectures")
+        .and_then(serde_json::Value::as_array)
+        .is_some_and(|values| {
+            values.iter().any(|value| {
+                value
+                    .as_str()
+                    .is_some_and(|name| name.ends_with("ForSequenceClassification"))
+            })
+        });
+    let model_type = if classifier {
+        ModelType::Classifier
+    } else {
+        ModelType::Embedding(Pool::Mean)
+    };
+
+    let open = Instant::now();
+    let backend = OxideBackend::new(&model, "bfloat16", model_type.clone(), ordinal)?;
+    let create_ns = open.elapsed().as_nanos();
+    backend.health()?;
+    let mut manifest = BTreeMap::new();
+
+    let text_cases = [("text-mean-16", 16usize), ("text-mean-128", 128)];
+    for (name, tokens) in text_cases {
+        let start = Instant::now();
+        let result = backend.embed(batch(text_ids(tokens), true, None))?;
+        let elapsed = start.elapsed().as_nanos();
+        let values = result
+            .get(&0)
+            .map(pooled)
+            .ok_or("missing text embedding")?;
+        write_f32(&out.join(format!("{name}.pooled.f32")), values)?;
+        manifest.insert(
+            name.to_string(),
+            json!({"elements": values.len(), "elapsed_ns": elapsed}),
+        );
+    }
+
+    for (name, positions) in [
+        ("text-yarn-16384", vec![16383, 16384, 16385, 16386]),
+        ("text-yarn-32768", vec![32767, 32768, 32769, 32770]),
+        ("text-yarn-262140", vec![262140, 262141, 262142, 262143]),
+    ] {
+        let start = Instant::now();
+        let result = backend.embed(batch_positions(
+            text_ids(positions.len()),
+            positions,
+            None,
+        ))?;
+        let elapsed = start.elapsed().as_nanos();
+        let values = result.get(&0).map(pooled).ok_or("missing YaRN text embedding")?;
+        write_f32(&out.join(format!("{name}.pooled.f32")), values)?;
+        manifest.insert(
+            name.to_string(),
+            json!({"elements": values.len(), "elapsed_ns": elapsed, "positions": "explicit"}),
+        );
+    }
+
+    if classifier {
+        let start = Instant::now();
+        let result = backend.predict(batch(text_ids(32), true, None))?;
+        let elapsed = start.elapsed().as_nanos();
+        let values = result.get(&0).ok_or("missing text logits")?;
+        write_f32(&out.join("text-score-32.logits.f32"), values)?;
+        manifest.insert(
+            "text-score-32".to_string(),
+            json!({"elements": values.len(), "elapsed_ns": elapsed}),
+        );
+    }
+
+    let (image_batch, _) = image_case(4, 6, 12, 2, 14, 2, 0);
+    let start = Instant::now();
+    let result = backend.embed(image_batch)?;
+    let elapsed = start.elapsed().as_nanos();
+    let values = result
+        .get(&0)
+        .map(pooled)
+        .ok_or("missing image embedding")?;
+    write_f32(&out.join("image-mean-1x4x6.pooled.f32"), values)?;
+    manifest.insert(
+        "image-mean-1x4x6".to_string(),
+        json!({"elements": values.len(), "elapsed_ns": elapsed}),
+    );
+
+    // Explicit raw token output through the normal factory.
+    let mut raw_batch = batch(text_ids(16), false, None);
+    raw_batch.raw_indices = vec![0];
+    let start = Instant::now();
+    let raw_result = backend.embed(raw_batch)?;
+    let elapsed = start.elapsed().as_nanos();
+    let raw_rows = match raw_result.get(&0) {
+        Some(Embedding::All(rows)) => rows,
+        Some(Embedding::Pooled(_)) | None => return Err("missing raw token output".into()),
+    };
+    let flat: Vec<f32> = raw_rows.iter().flatten().copied().collect();
+    write_f32(&out.join("text-raw-16.raw.f32"), &flat)?;
+    manifest.insert(
+        "text-raw-16".to_string(),
+        json!({"rows": raw_rows.len(), "elements": flat.len(), "elapsed_ns": elapsed}),
+    );
+
+    // Image + selected classifier on the actual patch path.
+    let (image_yarn_batch, _) = image_case(4, 6, 12, 2, 14, 2, 16384);
+    let start = Instant::now();
+    let result = backend.embed(image_yarn_batch)?;
+    let elapsed = start.elapsed().as_nanos();
+    let values = result.get(&0).map(pooled).ok_or("missing shifted image embedding")?;
+    write_f32(&out.join("image-yarn-16384.pooled.f32"), values)?;
+    manifest.insert(
+        "image-yarn-16384".to_string(),
+        json!({"elements": values.len(), "elapsed_ns": elapsed, "positions": "explicit"}),
+    );
+
+    if classifier {
+        let (image_batch, _) = image_case(8, 8, 24, 2, 14, 2, 0);
+        let start = Instant::now();
+        let result = backend.predict(image_batch)?;
+        let elapsed = start.elapsed().as_nanos();
+        let values = result.get(&0).ok_or("missing image logits")?;
+        write_f32(&out.join("image-score-1x8x8.logits.f32"), values)?;
+        manifest.insert(
+            "image-score-1x8x8".to_string(),
+            json!({"elements": values.len(), "elapsed_ns": elapsed}),
+        );
+    }
+
+    // Deferred lease + health, then a fresh factory open/drop to exercise the
+    // real lifetime path without reusing the qualification handle.
+    let deferred = backend.submit_embed(batch(text_ids(16), true, None))?.complete()?;
+    if deferred.get(&0).is_none() {
+        return Err("deferred embedding missing".into());
+    }
+    backend.health()?;
+    let lifetime_start = Instant::now();
+    {
+        let reopened = OxideBackend::new(&model, "bfloat16", model_type, ordinal)?;
+        reopened.health()?;
+        let _ = reopened.embed(batch(text_ids(8), true, None))?;
+    }
+    let lifetime_ns = lifetime_start.elapsed().as_nanos();
+
+    let mut perf_samples = Vec::with_capacity(iterations);
+    for _ in 0..warmup {
+        let _ = backend.embed(batch(text_ids(16), true, None))?;
+    }
+    for _ in 0..iterations {
+        let start = Instant::now();
+        let _ = backend.embed(batch(text_ids(16), true, None))?;
+        perf_samples.push(start.elapsed().as_nanos() as u64);
+    }
+    perf_samples.sort_unstable();
+    let p50 = perf_samples.get(perf_samples.len() / 2).copied().unwrap_or(0);
+    let p99 = perf_samples
+        .get((perf_samples.len() * 99 / 100).min(perf_samples.len().saturating_sub(1)))
+        .copied()
+        .unwrap_or(0);
+
+    let candidate = json!({
+        "schema": "oxide-mistral3-host-consumer/v1",
+        "factory": "OxideBackend::new",
+        "checkpoint": model,
+        "classifier": classifier,
+        "device": ordinal,
+        "create_ns": create_ns,
+        "lifetime_reopen_ns": lifetime_ns,
+        "cases": manifest,
+        "perf": {"warmup": warmup, "iterations": iterations, "p50_ns": p50, "p99_ns": p99},
+    });
+    fs::write(out.join("candidate.json"), serde_json::to_vec_pretty(&candidate)?)?;
+    println!("{}", serde_json::to_string_pretty(&candidate)?);
+    drop(backend);
+    Ok(())
+}
diff --git a/native/include/bridge.h b/native/include/bridge.h
new file mode 100644
index 0000000..6226b9e
--- /dev/null
+++ b/native/include/bridge.h
@@ -0,0 +1,230 @@
+/// \file
+/// C ABI declarations mirrored by the Rust LibTorch adapter.
+/// Input descriptors borrow caller storage; engine and output handles have explicit
+/// destruction entry points.
+
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+// C ABI mirrored by the repr(C) descriptors in ../src/lib.rs and ../src/radix.rs.
+// Keep field order and integer widths in sync when changing a descriptor.
+struct TeiConfig {
+  int64_t hidden, heads, layers, intermediate, vocab, positions, types;
+  double epsilon;
+  int32_t activation;
+};
+
+/// Borrowed image-patch matrix with packed-token placement and optional cache identity.
+struct TeiImage {
+  const float* pixels;
+  int64_t rows, patch_dim, grid[3], merge_size, token_start, token_count, sequence_start;
+  uint8_t feature_key[32]{};
+  uint8_t has_feature_key = 0;
+};
+
+/// Borrowed audio features and validity mask with packed-token placement.
+struct TeiAudio {
+  const float* values;
+  const uint8_t* mask;
+  int64_t frames, feature_size, token_start, token_count;
+};
+
+/// Borrowed compact token rows and maps between compact and logical token layouts.
+struct TeiRadix {
+  const int64_t* ids;
+  const int64_t* types;
+  const int64_t* positions;
+  const int64_t* scatter;
+  const int64_t* fold;
+  int64_t compact_tokens;
+};
+
+/// Question and option spans for one field of a structured decision request.
+struct TeiDecisionField {
+  int64_t kind, question_start, question_end;
+  const int64_t* options;
+  size_t option_count;
+};
+
+/// Counted, borrowed metadata selecting a supported decision-head request contract.
+struct TeiDecision {
+  // kind 4 is block option-token scoring; question_type holds its prefix length.
+  int32_t kind;
+  int64_t question_type;
+  const int64_t* markers;
+  size_t marker_count;
+  const int64_t* token_ids;
+  size_t token_count;
+  const TeiDecisionField* fields;
+  size_t field_count;
+};
+
+// A tensor range from a Rust-validated safetensors header, ordered by offset.
+struct TeiWeight {
+  const char* name;
+  const int64_t* shape;
+  size_t rank;
+  int32_t dtype;
+  uint64_t offset;
+  uint64_t length;
+};
+
+// Every fallible entry point catches C++ exceptions; the error string is thread-local.
+extern "C" {
+/// Borrow the calling thread's last error text; copy it before another fallible native call.
+const char* tei_error();
+// Thread-local status of the last fallible call: 0 success, 1 other error,
+// 2 memory admission rejection, 3 recoverable allocator OOM. Read immediately
+// on the calling thread. Other device failures retain kind 1.
+int32_t tei_last_error_kind();
+int64_t tei_device_count(const char* device);
+// Synchronous CUDA allocation/add/readback check; CPU is a no-op.
+int32_t tei_device_preflight(const char* device);
+/// Create an owned engine handle, or return null with thread-local error details. Load options and
+/// weights, call tei_ready(), then release the handle with tei_destroy().
+void* tei_create(const TeiConfig*, const char* device, int32_t dtype);
+/// Copy the supplied checkpoint bytes into engine-owned storage; success is 0, failure is -1.
+int32_t tei_weight(
+    void*, const char* name, const uint8_t* data, const int64_t* shape, size_t rank, int32_t dtype);
+#ifndef _WIN32
+int32_t tei_load_safetensors(void*,
+                             int fd,
+                             uint64_t data_start,
+                             uint64_t data_length,
+                             const TeiWeight*,
+                             size_t count,
+                             size_t threads,
+                             size_t buffer_bytes,
+                             int32_t direct_io);
+#endif
+int32_t tei_option(void*, const char* key, const char* value);
+int64_t tei_output_width(void*);
+int64_t tei_pooled_width(void*);
+int64_t tei_classification_width(void*);
+int64_t tei_graph_count(void*);
+// hits, misses, captures, attempts, evictions, live bytes, cumulative admitted bytes.
+int32_t tei_graph_stats(void*, uint64_t* counters, size_t count);
+// Operation 0: hidden states, 1: sequence classification, 2: token classification.
+int32_t tei_prefix_cache_supported(void*, int32_t operation);
+// hits, misses, reused tokens, admissions, evictions, bypasses, live bytes.
+int32_t tei_prefix_cache_stats(void*, uint64_t* counters, size_t count);
+int32_t tei_prefix_cache_clear(void*);
+// Set probe bypass and return its previous value, or -1 on error.
+int32_t tei_prefix_cache_set_probe(void*, int32_t enabled);
+int32_t tei_supports_radix(void*);
+/// Prepare loaded weights and model/cache state; rebuilding drains previous engine submissions.
+int32_t tei_ready(void*);
+/// Validate one decision descriptor per requested count and fill caller-owned logit-count storage.
+int32_t tei_decision_counts(void*, const TeiDecision*, size_t count, int64_t* counts);
+/// Synchronously write concatenated request logits and one action probability per sequence.
+/// Capacity counts logit floats; inputs and output buffers remain valid throughout the call.
+int32_t tei_decide(void*,
+                   const int64_t* ids,
+                   const int64_t* types,
+                   const int64_t* positions,
+                   const int32_t* cumulative,
+                   int64_t batch,
+                   int64_t max_sequence,
+                   const TeiDecision*,
+                   float* logits,
+                   size_t capacity,
+                   float* actions,
+                   const int64_t* media_positions,
+                   const TeiImage* images,
+                   size_t image_count,
+                   const TeiAudio* audios,
+                   size_t audio_count);
+/// Perform synchronous decisions with optional compact
+/// causal-prefix maps; null maps disable sharing.
+int32_t tei_decide_radix(void*,
+                         const int64_t* ids,
+                         const int64_t* types,
+                         const int64_t* positions,
+                         const int32_t* cumulative,
+                         int64_t batch,
+                         int64_t max_sequence,
+                         const TeiDecision*,
+                         float* logits,
+                         size_t capacity,
+                         float* actions,
+                         const int64_t* media_positions,
+                         const TeiImage* images,
+                         size_t image_count,
+                         const TeiAudio* audios,
+                         size_t audio_count,
+                         const TeiRadix* radix);
+/// Synchronously write pooled selections first, then raw token spans, preserving selection order.
+/// Capacity counts float elements, including repetitions; input
+/// boundaries delimit unpadded sequences.
+int32_t tei_forward(void*,
+                    const int64_t* ids,
+                    const int64_t* types,
+                    const int64_t* positions,
+                    const int32_t* cumulative,
+                    int64_t batch,
+                    int64_t max_sequence,
+                    int32_t pool,
+                    const int64_t* pooled,
+                    size_t pooled_count,
+                    const int64_t* raw,
+                    size_t raw_count,
+                    float* output,
+                    size_t capacity,
+                    const int64_t* media_positions,
+                    const TeiImage* images,
+                    size_t image_count,
+                    const TeiAudio* audios,
+                    size_t audio_count);
+// A separate entry point preserves the existing packed C ABI for callers that
+// do not provide radix maps. Maps never contain padded or unused compact rows.
+int32_t tei_forward_radix(void*,
+                          const int64_t* ids,
+                          const int64_t* types,
+                          const int64_t* positions,
+                          const int32_t* cumulative,
+                          int64_t batch,
+                          int64_t max_sequence,
+                          int32_t pool,
+                          const int64_t* pooled,
+                          size_t pooled_count,
+                          const int64_t* raw,
+                          size_t raw_count,
+                          float* output,
+                          size_t capacity,
+                          const int64_t* media_positions,
+                          const TeiImage* images,
+                          size_t image_count,
+                          const TeiAudio* audios,
+                          size_t audio_count,
+                          const TeiRadix* radix);
+// Returns an owned output lease, or nullptr on failure. capacity counts floats.
+// Inputs are staged during this call; caller storage can be released on return.
+// Wait before reading results, then destroy the lease after copying them out.
+void* tei_forward_submit(void* handle,
+                         const int64_t* ids,
+                         const int64_t* types,
+                         const int64_t* positions,
+                         const int32_t* cumulative,
+                         int64_t batch,
+                         int64_t max_sequence,
+                         int32_t pool,
+                         const int64_t* pooled,
+                         size_t pooled_count,
+                         const int64_t* raw,
+                         size_t raw_count,
+                         size_t capacity,
+                         const int64_t* media_positions,
+                         const TeiImage* images,
+                         size_t image_count,
+                         const TeiAudio* audios,
+                         size_t audio_count,
+                         const TeiRadix* radix);
+// Owned output lease: wait and construct host results before destroy.
+const float* tei_output_wait(void*);
+/// Release an owned output lease after consuming its results;
+/// unfinished transfers drain on destruction.
+void tei_output_destroy(void*);
+/// Destroy an owned engine handle after callers stop using it, draining pending producer work.
+void tei_destroy(void*);
+}
diff --git a/native/include/mistral3_b66.h b/native/include/mistral3_b66.h
new file mode 100644
index 0000000..6015b56
--- /dev/null
+++ b/native/include/mistral3_b66.h
@@ -0,0 +1,213 @@
+/*
+ * mistral3_b66.h - source-only Root packet C ABI for Mistral3 + Pixtral.
+ *
+ * This header is a fixed-width, C-compatible description of the packet that
+ * wraps the frozen b66 libtei_torch C entry points (tei_create, tei_option,
+ * tei_load_safetensors, tei_ready, tei_forward, tei_forward_submit,
+ * tei_output_wait, tei_output_destroy, tei_destroy). Root compiles this header
+ * and native/src/mistral3_runner.cpp later inside the GPU/Torch image.
+ *
+ * Nothing here was compiled, linked, loaded or executed during the CPU-only
+ * control. The header contains no Torch, ATen, c10, CUDA or C++ types, and it
+ * does not itself initialize CUDA. A consumer must set CUDA_VISIBLE_DEVICES
+ * explicitly for a real GPU run; the bundled runner refuses an empty guard.
+ *
+ * Image pixels are caller-owned RGB patch rows in float32, row-major, exactly
+ * rows * patch_dim values. Token buffers are caller-owned, concatenated in
+ * sequence order. All descriptors are borrowed for the duration of a
+ * synchronous call; deferred submission stages them before returning.
+ */
+#ifndef MISTRAL3_B66_H
+#define MISTRAL3_B66_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MISTRAL3_B66_ABI_VERSION 1u
+
+/* Mirrors the b66 scalar dtype selector: 0=f32, 1=f16, 2=bf16. */
+enum {
+    MISTRAL3_B66_DTYPE_F32 = 0,
+    MISTRAL3_B66_DTYPE_F16 = 1,
+    MISTRAL3_B66_DTYPE_BF16 = 2
+};
+
+/* Pool selector values accepted by the b66 forward ABI. */
+enum {
+    MISTRAL3_B66_POOL_FIRST = 0,
+    MISTRAL3_B66_POOL_MEAN = 1,
+    MISTRAL3_B66_POOL_LAST = 2,
+    MISTRAL3_B66_POOL_CLASSIFICATION = 4
+};
+
+typedef void* mistral3_b66_handle;
+typedef struct mistral3_b66_output_lease* mistral3_b66_output;
+
+/*
+ * One image in packed-token layout.
+ *
+ * grid_thw is [frames, patch_rows, patch_columns] and must have frames == 1.
+ * patch_dim is 3 * patch_size * patch_size (588 for patch_size 14).
+ * rows is the patch count (grid_thw[1] * grid_thw[2]).
+ * pixels points at rows * patch_dim float32 values.
+ * pixel_count, when nonzero, must equal rows * patch_dim; zero means derive it.
+ * token_start is the first packed-token index replaced by projected features.
+ * token_count is (grid_thw[1] / merge_size) * (grid_thw[2] / merge_size).
+ * sequence_start is the first token index of the image's sequence.
+ */
+typedef struct mistral3_b66_image {
+    int64_t grid_thw[3];
+    int64_t patch_dim;
+    int64_t rows;
+    int64_t merge_size;
+    const float* pixels;
+    uint64_t pixel_count;
+    int64_t token_start;
+    int64_t token_count;
+    int64_t sequence_start;
+    uint8_t feature_key[32];
+    uint8_t has_feature_key;
+} mistral3_b66_image;
+
+/*
+ * One packed forward request. ids/types/positions contain
+ * cumulative[batch] entries. cumulative has batch + 1 int32 offsets.
+ * pool uses MISTRAL3_B66_POOL_*; pool == 4 emits classification scores.
+ * pooled/raw are row indices into the packed batch, preserving caller order.
+ * output_capacity counts float elements.
+ */
+typedef struct mistral3_b66_text_request {
+    const int64_t* ids;
+    const int64_t* types;
+    const int64_t* positions;
+    const int32_t* cumulative;
+    int64_t batch;
+    int64_t max_sequence;
+    int32_t pool;
+    const int64_t* pooled;
+    size_t pooled_count;
+    const int64_t* raw;
+    size_t raw_count;
+    size_t output_capacity;
+} mistral3_b66_text_request;
+
+/*
+ * One safetensors range. offset is relative to the shard payload start
+ * (8 + header_bytes), exactly as stored in data_offsets. length is the exact
+ * payload byte length. name is a NUL-terminated UTF-8 tensor name.
+ */
+typedef struct mistral3_b66_weight {
+    const char* name;
+    const int64_t* shape;
+    size_t rank;
+    int32_t dtype;
+    uint64_t offset;
+    uint64_t length;
+} mistral3_b66_weight;
+
+/* Monotonic nanosecond counters and output metadata for one engine. */
+typedef struct mistral3_b66_perf_counters {
+    uint64_t create_ns;
+    uint64_t option_ns;
+    uint64_t load_ns;
+    uint64_t ready_ns;
+    uint64_t forward_sync_ns;
+    uint64_t forward_submit_ns;
+    uint64_t output_wait_ns;
+    uint64_t output_destroy_ns;
+    uint64_t destroy_ns;
+    uint64_t forward_calls;
+    uint64_t deferred_calls;
+    uint64_t last_output_elements;
+    uint64_t last_output_checksum;
+    uint64_t min_forward_ns;
+    uint64_t max_forward_ns;
+    uint64_t total_forward_ns;
+} mistral3_b66_perf_counters;
+
+/*
+ * Create an engine for the checkpoint at a directory path. device is a b66
+ * device string such as "cuda:0"; dtype is MISTRAL3_B66_DTYPE_*. Returns NULL
+ * on failure; use mistral3_b66_last_error().
+ */
+mistral3_b66_handle mistral3_b66_create(const char* checkpoint,
+                                        const char* device,
+                                        int32_t dtype);
+
+/* Set one flattened config option before ready(). Returns 0 or -1. */
+int32_t mistral3_b66_option(mistral3_b66_handle handle,
+                            const char* key,
+                            const char* value);
+
+/*
+ * Open one safetensors shard, validate its header-derived data start/length,
+ * and hand every descriptor to the frozen b66 reader. The descriptor array
+ * must be ordered by ascending offset. Returns 0 or -1.
+ */
+int32_t mistral3_b66_load_safetensors(mistral3_b66_handle handle,
+                                      const char* shard_path,
+                                      const mistral3_b66_weight* weights,
+                                      size_t count,
+                                      size_t threads,
+                                      size_t buffer_bytes,
+                                      int32_t direct_io);
+
+/* Build model/caches from the loaded config and all tensors. Returns 0 or -1. */
+int32_t mistral3_b66_ready(mistral3_b66_handle handle);
+
+/*
+ * Synchronous image+text forward. output must hold output_capacity floats and
+ * the capacity must be at least the exact requested element count. Returns 0
+ * or -1.
+ */
+int32_t mistral3_b66_forward(mistral3_b66_handle handle,
+                             const mistral3_b66_text_request* request,
+                             const mistral3_b66_image* images,
+                             size_t image_count,
+                             float* output);
+
+/*
+ * Deferred forward. Inputs are staged before return; output_capacity must be
+ * exactly the requested element count. Returns an owned lease or NULL.
+ */
+mistral3_b66_output mistral3_b66_forward_submit(
+    mistral3_b66_handle handle,
+    const mistral3_b66_text_request* request,
+    const mistral3_b66_image* images,
+    size_t image_count);
+
+/* Wait for one lease and borrow its host output until output_destroy(). */
+const float* mistral3_b66_output_wait(mistral3_b66_output output);
+
+/* Number of float elements in a completed lease; returns 0 or -1. */
+int32_t mistral3_b66_output_elements(mistral3_b66_output output,
+                                     size_t* elements);
+
+/* Release one lease after its results are consumed. */
+void mistral3_b66_output_destroy(mistral3_b66_output output);
+
+/* Copy the engine's timing counters. Returns 0 or -1. */
+int32_t mistral3_b66_perf(mistral3_b66_handle handle,
+                          mistral3_b66_perf_counters* counters);
+
+/* Reset engine timing counters. Returns 0 or -1. */
+int32_t mistral3_b66_reset_perf(mistral3_b66_handle handle);
+
+/* Last thread-local error text; valid until the next fallible call. */
+const char* mistral3_b66_last_error(void);
+
+/* Last thread-local error kind: 0 success, 1 error, 2/3 memory admission. */
+int32_t mistral3_b66_last_error_kind(void);
+
+/* Destroy the engine and drain any outstanding work. */
+void mistral3_b66_destroy(mistral3_b66_handle handle);
+
