+pub struct Mistral3Qualification {
+    engine: mistral3_exec::Mistral3Engine,
+}
+
+/// Owned host copy of one qualification result.
+#[derive(Debug, Clone)]
+pub struct Mistral3QualificationOutput {
+    pub pooled: Vec<f32>,
+    pub raw: Vec<f32>,
+    pub logits: Vec<f32>,
+}
+
+impl Mistral3Qualification {
+    pub fn open(
+        path: &Path,
+        device: usize,
+        fa4_root: &Path,
+        max_tokens: usize,
+        max_sequences: usize,
+        max_images: usize,
+    ) -> Result<Self, BackendError> {
+        let plan = mistral3::Mistral3Plan::load(path, device)?;
+        let context = Context::new(device).map_err(start)?;
+        let stream = context.new_stream().map_err(start)?;
+        let lt = LtProvider::new(context.clone(), stream.clone())?;
+        let engine = mistral3_exec::Mistral3Engine::new(
+            plan,
+            context,
+            stream,
+            lt,
+            fa4_root,
+            max_tokens,
+            max_sequences,
+            max_images,
+        )?;
+        Ok(Self { engine })
+    }
+
+    /// Run a text-only ragged qualification batch with mean pooling.
