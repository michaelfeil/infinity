+      {"image-yarn-16384", &image_yarn_16384},
+  };
+  for (const auto& item : cases) {
+    if (!run_sync_case(*state, *item.second, item.first, result, error)) {
+      std::cerr << item.first << " failed: " << error << "\n";
+      mistral3_b66_destroy(handle);
