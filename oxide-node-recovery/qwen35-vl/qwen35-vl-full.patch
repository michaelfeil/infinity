new file mode 100644
index 0000000..4fca1db
--- /dev/null
+++ b/native/sdk/remote_guard.py
@@ -0,0 +1,58 @@
+"""Owned Docker child guard: GNU deadline plus identity-checked group cleanup."""
+from pathlib import Path
+import argparse,json,os,signal,time
+
+ROOT=Path(__file__).resolve().parent
+
+def start_ticks(pid):
+    try:return Path(f'/proc/{pid}/stat').read_text().rsplit(')',1)[1].split()[19]
+    except FileNotFoundError:return None
+
+def alive(pid):
+    try:return Path(f'/proc/{pid}/stat').read_text().rsplit(')',1)[1].split()[0]!='Z'
+    except FileNotFoundError:return False
+
+def stop(state_path):
+    state=json.loads(state_path.read_text());pid=state['pid']
+    ticks=start_ticks(pid)
+    if ticks is None or ticks!=state['start_ticks']:
+        return {'status':'already-exited-or-reused','pid':pid,'group_signal_sent':False}
+    try:actual=Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
+    except FileNotFoundError:return {'status':'already-exited-or-reused','pid':pid,'group_signal_sent':False}
+    actual=[x.decode()for x in actual if x]
+    if actual!=state['argv']:
+        # The state is published just before exec; at that point no CUDA
+        # child exists and only this exact owned guard PID may be stopped.
+        if str(Path(__file__).resolve())not in actual or str(state_path)not in actual:
+            raise RuntimeError('Owned remote PID command identity changed; no signal sent')
+        os.kill(pid,signal.SIGTERM)
+        return {'status':'guard-stopped-before-exec','pid':pid,'group_signal_sent':False}
+    if os.getpgid(pid)!=pid:raise RuntimeError('Owned timeout process-group identity differs')
+    try:os.killpg(pid,signal.SIGTERM)
+    except ProcessLookupError:pass
+    deadline=time.monotonic()+2.
+    while alive(pid)and time.monotonic()<deadline:time.sleep(.02)
+    # Signal the same owned group even if the leader is now a zombie; its
+    # same-start-time identity still protects against PID/group reuse.
+    if start_ticks(pid)==state['start_ticks']:
+        try:os.killpg(pid,signal.SIGKILL)
+        except ProcessLookupError:pass
+    return {'status':'owned-group-terminated','pid':pid,'group_signal_sent':True}
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--state',type=Path,required=True);p.add_argument('--seconds',type=int,default=1200)
+    p.add_argument('--stop',action='store_true');p.add_argument('argv',nargs=argparse.REMAINDER);a=p.parse_args()
+    state=a.state.resolve()
+    if not state.is_relative_to(ROOT)or state==ROOT:raise RuntimeError('State must remain in the owned controller directory')
+    if a.stop:
+        print(json.dumps(stop(state))if state.exists()else json.dumps({'status':'not-started','group_signal_sent':False}));return
+    argv=a.argv[1:]if a.argv[:1]==['--']else a.argv
+    if state.exists()or not state.parent.is_dir()or not 1<=a.seconds<=3600:raise RuntimeError('Fresh state and bounded positive deadline required')
+    if not argv or argv[0]!='taskset':raise RuntimeError('Only the explicit pinned native command is supported')
+    command=['/usr/bin/timeout','--signal=TERM','--kill-after=15s',f'{a.seconds}s']+argv
+    pid=os.getpid();ticks=start_ticks(pid)
+    if ticks is None:raise RuntimeError('Owned guard identity is not observable')
+    state.write_text(json.dumps({'pid':pid,'start_ticks':ticks,'argv':command},indent=2)+'\n')
+    os.execv(command[0],command)
+
+if __name__=='__main__':main()
diff --git a/native/sdk/sdk_stage.py b/native/sdk/sdk_stage.py
new file mode 100644
index 0000000..d470ed9
--- /dev/null
+++ b/native/sdk/sdk_stage.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""CPU-only SDK/Torch/GOT/model/fixture stage validation. No engine, no GPU."""
+import argparse, ctypes as C, hashlib, json, os, struct, subprocess, sys
+from pathlib import Path
+
+B66_SHA = "b66d70b61b39e1bf0d565aca33bac7c5e21849677396ce5216f5baf73027d37e"
+TORCH_VERSION = "2.14.1+cu130"
+TORCH_GIT = "5c4886908584029761b579af026dcfb627c84070"
+GOT_VERSION = 130200
+UNION124_SHA = "56863d52"
+
+def sha(path): return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+def header(path):
+    with Path(path).open("rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        return json.loads(f.read(n))
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--library", required=True)
+    p.add_argument("--torch-python", required=True)
+    p.add_argument("--vendor", required=True)
+    p.add_argument("--union124", required=True)
+    p.add_argument("--model", required=True)
+    p.add_argument("--media", required=True)
+    p.add_argument("--out", required=True)
+    a = p.parse_args()
+    failures = []
+    b66 = sha(a.library)
+    if b66 != B66_SHA: failures.append("b66 SHA changed")
+    torch = subprocess.run([a.torch_python, "-c",
+        "import torch;print(torch.__version__);print(torch.version.git_version)"],
+        capture_output=True, text=True,
+        env={k: v for k, v in os.environ.items() if not k.startswith(("CUDA_", "INFINITY_", "LD_"))}
+        | {"CUDA_VISIBLE_DEVICES": ""})
+    torch_lines = torch.stdout.strip().splitlines()
+    if torch.returncode != 0 or torch_lines[:2] != [TORCH_VERSION, TORCH_GIT]:
+        failures.append(f"torch identity changed: {torch.stdout!r} {torch.stderr!r}")
+    env = dict(os.environ, LD_LIBRARY_PATH=a.vendor + ":" + os.environ.get("LD_LIBRARY_PATH", ""))
+    ldd = subprocess.run(["ldd", "-r", a.library], capture_output=True, text=True, env=env)
+    cublas_lines = [line for line in ldd.stdout.splitlines() if "libcublas" in line]
+    if ldd.returncode != 0 or "undefined symbol" in ldd.stdout:
+        failures.append("ldd -r b66 failed")
+    if not cublas_lines or any(a.vendor not in line for line in cublas_lines):
+        failures.append(f"b66 cublas relocations are not vendor-bound: {cublas_lines}")
+    lt = C.CDLL(str(Path(a.vendor) / "libcublasLt.so.13"))
+    lt.cublasLtGetVersion.restype = C.c_size_t
+    version = int(lt.cublasLtGetVersion())
+    if version != GOT_VERSION: failures.append(f"cublasLt version {version} != {GOT_VERSION}")
+    union = json.loads(Path(a.union124, "manifest.json").read_text())
+    union_manifest_sha = sha(Path(a.union124, "manifest.json"))
+    if not union_manifest_sha.startswith(UNION124_SHA):
+        failures.append(f"union124 manifest {union_manifest_sha} lacks {UNION124_SHA}")
+    archs = {entry["architecture"]: entry["symbols_verified"] for entry in union["architectures"]}
+    if set(archs) != {"sm_90", "sm_100", "sm_120"} or any(len(v) != 124 for v in archs.values()):
+        failures.append(f"union124 architecture/symbol proof incomplete: {list(archs)}")
+    model = Path(a.model)
+    config = json.loads((model / "config.json").read_text())
+    index_path = model / "model.safetensors.index.json"
+    if index_path.is_file():
+        index = json.loads(index_path.read_text())
+        shards = sorted(set(index["weight_map"].values()))
+        headers = {}
+        for shard in shards:
+            headers.update({k: v for k, v in header(model / shard).items() if k != "__metadata__"})
+        tensor_count = len(index["weight_map"])
+    else:
+        headers = {k: v for k, v in header(model / "model.safetensors").items() if k != "__metadata__"}
+        tensor_count = len(headers)
+    vision = sum(1 for name in headers if name.startswith("model.visual."))
+    media = json.loads(Path(a.media).read_text())
+    fixture_reports = []
+    for fixture in media.get("fixtures", []):
+        pixels = Path(fixture["pixels"])
+        rows, patch_dim = int(fixture["rows"]), int(fixture["patch_dim"])
+        size = pixels.stat().st_size
+        expected = rows * patch_dim * 4
+        grid = fixture["grid"]; merge = fixture["merge"]
+        tokens = grid[0] * grid[1] * grid[2] // (merge * merge)
+        ok = size == expected and tokens == fixture["token_count"]
+        if not ok: failures.append(f"fixture {fixture['name']} shape/token guard failed")
+        fixture_reports.append({"name": fixture["name"], "bytes": size, "rows": rows,
+                                "patch_dim": patch_dim, "grid": grid, "merge": merge,
+                                "tokens": tokens, "ok": ok})
+    report = {"schema": "oxide-qwen35vl-sdk-cpu-stage/v1",
+              "status": "passed" if not failures else "failed",
+              "b66": {"sha256": b66, "path": a.library}, "torch": torch_lines,
+              "cublasLt": version, "vendor": a.vendor,
+              "union124": {"manifest_sha256": union_manifest_sha, "architectures": {k: len(v) for k, v in archs.items()}},
+              "model": str(model), "model_type": config.get("model_type"),
+              "text_model_type": config.get("text_config", {}).get("model_type"),
+              "tensor_count": tensor_count, "vision_tensor_count": vision,
+              "config_sha256": sha(model / "config.json"),
+              "index_sha256": sha(index_path) if index_path.is_file() else None,
+              "fixtures": fixture_reports, "gpu_initialized": False,
+              "engine_created": False, "failures": failures}
+    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    (out / "sdk-stage.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"status": report["status"], "failures": failures}))
+    return 0 if not failures else 1
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/native/tower_probe.cpp b/native/tower_probe.cpp
new file mode 100644
index 0000000..019e98a
--- /dev/null
+++ b/native/tower_probe.cpp
@@ -0,0 +1,151 @@
+// Native Qwen3.5 vision tower capture for paired Root qualification.
+//
+// Build against the public Native sources in this repository (qwen3_vl_models.cpp
+// and qwen35_models.cpp) plus the pinned SDK's ATen. It reads a tensor dump
+// produced by dump_vision_tensors.py, constructs the real Qwen3VL tower-only
+// object with the original Options, and writes merged visual rows as F32.
+//
+// This probe does not reimplement the tower; it calls Qwen3VL::image_features.
+
+#include "helpers/options.h"
+#include "models/qwen3_vl_models.h"
+#include <ATen/ATen.h>
+#include <c10/core/InferenceMode.h>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+std::vector<int64_t> parse_shape(const std::string& text) {
+  std::vector<int64_t> shape;
+  std::stringstream stream(text);
+  std::string item;
+  while (std::getline(stream, item, ',')) if (!item.empty()) shape.push_back(std::stoll(item));
+  return shape;
+}
+std::vector<char> read_file(const std::string& path) {
+  std::ifstream stream(path, std::ios::binary);
+  TORCH_CHECK(stream, "cannot open ", path);
+  stream.seekg(0, std::ios::end);
+  const auto size = stream.tellg();
+  stream.seekg(0, std::ios::beg);
+  std::vector<char> bytes(static_cast<size_t>(size));
+  stream.read(bytes.data(), size);
+  TORCH_CHECK(stream, "short read ", path);
+  return bytes;
+}
+std::vector<float> read_f32(const std::string& path, size_t count) {
+  auto bytes = read_file(path);
+  TORCH_CHECK(bytes.size() == count * sizeof(float), "wrong pixel byte count for ", path);
+  std::vector<float> values(count);
+  std::memcpy(values.data(), bytes.data(), bytes.size());
+  return values;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  TORCH_CHECK(argc == 6,
+              "usage: tower_probe TENSOR_ROOT FIXTURES OUT_DIR DTYPE DEVICE");
+  const std::string root = argv[1], fixtures_path = argv[2], out_dir = argv[3];
+  const std::string dtype_name = argv[4], device_name = argv[5];
+  const auto device = c10::Device(device_name);
+  const auto dtype = dtype_name == "float16" ? at::kHalf
+                    : dtype_name == "float32" ? at::kFloat : at::kBFloat16;
+  infinity::Options options;
+  {
+    std::ifstream stream(root + "/options.txt");
+    std::string line;
+    while (std::getline(stream, line)) {
+      const auto tab = line.find('\t');
+      if (tab != std::string::npos) options.values[line.substr(0, tab)] = line.substr(tab + 1);
+    }
+  }
+  auto blob = read_file(root + "/tensors.bin");
+  infinity::Weights weights;
+  {
+    std::ifstream stream(root + "/tensors.txt");
+    std::string line;
+    while (std::getline(stream, line)) {
+      std::stringstream fields(line);
+      std::string name, shape_text, offset_text, bytes_text;
+      std::getline(fields, name, '\t');
+      std::getline(fields, shape_text, '\t');
+      std::getline(fields, offset_text, '\t');
+      std::getline(fields, bytes_text, '\t');
+      const auto shape = parse_shape(shape_text);
+      const auto offset = std::stoull(offset_text);
+      const auto bytes = std::stoull(bytes_text);
+      TORCH_CHECK(offset + bytes <= blob.size(), "tensor range exceeds dump");
+      auto tensor = at::from_blob(blob.data() + offset, shape,
+                                  at::TensorOptions().dtype(dtype)).clone();
+      weights.emplace(name, tensor.to(device));
+    }
+  }
+  c10::InferenceMode inference(true);
+  infinity::Qwen3VL tower(options, weights, device, dtype, /*only_vision=*/true);
+  tower.ready();
+  struct Fixture {
+    std::string name, pixels;
+    int64_t rows, patch_dim, t, h, w, merge, token_start;
+  };
+  std::vector<Fixture> fixtures;
+  {
+    std::ifstream stream(fixtures_path);
+    TORCH_CHECK(stream, "cannot open fixtures ", fixtures_path);
+    std::string line;
+    while (std::getline(stream, line)) {
+      if (line.empty() || line[0] == '#') continue;
+      std::stringstream fields(line);
+      Fixture fixture;
+      std::string rows, patch_dim, t, h, w, merge, token_start;
+      std::getline(fields, fixture.name, '\t');
+      std::getline(fields, rows, '\t');
+      std::getline(fields, patch_dim, '\t');
+      std::getline(fields, t, '\t');
+      std::getline(fields, h, '\t');
+      std::getline(fields, w, '\t');
+      std::getline(fields, merge, '\t');
+      std::getline(fields, token_start, '\t');
+      std::getline(fields, fixture.pixels, '\t');
+      fixture.rows = std::stoll(rows); fixture.patch_dim = std::stoll(patch_dim);
+      fixture.t = std::stoll(t); fixture.h = std::stoll(h); fixture.w = std::stoll(w);
+      fixture.merge = std::stoll(merge); fixture.token_start = std::stoll(token_start);
+      fixtures.push_back(std::move(fixture));
+    }
+  }
+  std::vector<infinity::ImageInput> images;
+  for (const auto& fixture : fixtures) {
+    const auto count = static_cast<size_t>(fixture.rows * fixture.patch_dim);
+    auto values = read_f32(fixture.pixels, count);
+    auto pixels = at::from_blob(values.data(), {fixture.rows, fixture.patch_dim},
+                                at::TensorOptions().dtype(at::kFloat)).clone();
+    infinity::ImageInput image;
+    image.pixels = pixels;
+    image.grid_thw = {fixture.t, fixture.h, fixture.w};
+    image.merge_size = fixture.merge;
+    image.token_start = fixture.token_start;
+    image.token_count = fixture.t * fixture.h * fixture.w / (fixture.merge * fixture.merge);
+    images.push_back(std::move(image));
+  }
+  auto features = tower.image_features(images);
+  TORCH_CHECK(features.size() == images.size(), "tower feature count mismatch");
+  std::ofstream report(out_dir + "/gold.json");
+  report << "{\n  \"arm\": \"native-b66-tower\",\n  \"rows\": [\n";
+  for (size_t index = 0; index < features.size(); ++index) {
+    auto values = features[index].to(at::kFloat).contiguous().cpu();
+    const auto merged = features[index].size(0), hidden = features[index].size(1);
+    const auto path = out_dir + "/" + fixtures[index].name + ".f32";
+    std::ofstream output(path, std::ios::binary);
+    output.write(reinterpret_cast<const char*>(values.const_data_ptr<float>()),
+                 values.numel() * sizeof(float));
+    report << "    {\"name\": \"" << fixtures[index].name << "\", \"merged_rows\": " << merged
+           << ", \"out_hidden\": " << hidden << ", \"path\": \"" << path << "\"}"
+           << (index + 1 == features.size() ? "\n" : ",\n");
+  }
+  report << "  ]\n}\n";
+  std::cout << "native tower captured " << features.size() << " fixtures\n";
+  return 0;
+}
diff --git a/review/INDEPENDENT-REVIEW.md b/review/INDEPENDENT-REVIEW.md
new file mode 100644
index 0000000..d1967b3
--- /dev/null
+++ b/review/INDEPENDENT-REVIEW.md
@@ -0,0 +1,44 @@
+# Independent source review (read-only) and resolutions
+
+Reviewer scope: factory ownership, HostIo/lease/synchronization, dynamic-head FA4,
+F32 correction, checkpoint preservation, MoE separation.
+
+## Blockers/HIGH found and resolved
+
+1. **Tower feature D2H/H2D + per-call sync** — resolved. `forward_image_device`
+   now returns device-resident merged rows (`VisionDeviceOutput`); the serving
+   path has no `to_host_vec`, no feature re-upload, and no successful-path
+   synchronize. `VisionWorkspace::mark_completed` runs only after `lease.wait`;
+   error/drop paths still fence/quarantine.
+2. **Manual `Qwen35VlEngine::new` wrong block route** — resolved. Block
+   checkpoints use the dynamic-block Decision constructor with `causal=false`;
+   `attach` requires a ready run plan and reuses an existing runtime instead of
+   double-attaching.
+3. **Media-free/audio early-return gaps** — resolved. One
+   `validate_media_batch` runs before early returns on both embed and Decision
+   routes; media without a VL runtime and audio are rejected.
+4. **Source pins stale** — re-baselined after the fixes (`source-pins.json`,
+   `freeze.json`, patch, consumer pin).
+
+## Medium items addressed
+
+- Normal factory no longer swallows a declared malformed vision/media config.
+- `whole-factory` uses the normal public backend and `Batch.multimodal`; the
+  controller uses it for paired whole-model capture.
+- Consumer `--pool` is honored.
+
+## Residual, explicitly not claimed
+
+- 35B-A3B remains a typed gap: ratio8 d256 causal mode 26 + MoE text owner.
+- FP16/F32 device recipes remain unsupported until the Native exact recipe.
+- No GPU/device execution was performed by the author.
+
+
+## P1 follow-up (Qwen3VL shared audit)
+
+- Added `Qwen35VlInference` RAII owner constructed before returning
+  `Inference::Deferred`. Uncalled closure Drop fences the inner lease first.
+- On `lease.wait`/fence failure the fusion workspace is forgotten/quarantined,
+  not freed as proven.
+- Added CPU drop-witness test:
+  `dropping_uncalled_vl_deferred_owner_runs_the_fence`.
