+pub const DEFAULT_VISION_ACT: &str = "gelu_pytorch_tanh";
+pub const DEFAULT_TEXT_DTYPE: &str = "bfloat16";
+
+/// Root and nested `model_type` aliases accepted by the Native constructor.
