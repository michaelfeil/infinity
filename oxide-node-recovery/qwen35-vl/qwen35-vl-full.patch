+/// Public cold handle for the Qwen3.5 vision tower. It owns the CUDA context,
+/// stream and generic `LtProvider` so consumers never touch private types.
+pub struct Qwen35VlTower {
+    config: Qwen35VlConfig,
+    inner: qwen35_vl_device::Qwen35VlVisionDevice,
+    lt: lt::LtProvider,
+    _context: Arc<cuda_core::Context>,
+    _stream: Arc<cuda_core::Stream>,
+}
+
+impl Qwen35VlTower {
+    pub fn open(path: &std::path::Path, device_id: u32) -> Result<Self, BackendError> {
+        let config = Qwen35VlConfig::from_path(path)?;
+        let checkpoint = model::Checkpoint::open(path)?;
+        let context = cuda_core::Context::new(device_id as usize).map_err(start)?;
+        let stream = context.new_stream().map_err(start)?;
+        let lt = lt::LtProvider::new(context.clone(), stream.clone())?;
+        let inner = qwen35_vl_device::Qwen35VlVisionDevice::new(
+            &config,
+            &checkpoint,
+            &context,
+            &stream,
+            &lt,
+        )?;
+        Ok(Self {
+            config,
+            inner,
+            lt,
+            _context: context,
+            _stream: stream,
+        })
+    }
+
+    pub(crate) fn attach(
+        config: Qwen35VlConfig,
+        checkpoint: &model::Checkpoint,
+        context: &Arc<cuda_core::Context>,
+        stream: &Arc<cuda_core::Stream>,
+    ) -> Result<Self, BackendError> {
+        let lt = lt::LtProvider::new(context.clone(), stream.clone())?;
+        let inner =
+            qwen35_vl_device::Qwen35VlVisionDevice::new(&config, checkpoint, context, stream, &lt)?;
+        Ok(Self {
+            config,
+            inner,
+            lt,
+            _context: context.clone(),
+            _stream: stream.clone(),
+        })
+    }
+
+    pub fn config(&self) -> &Qwen35VlConfig {
+        &self.config
+    }
+
+    pub fn image_features(&self, images: &[HostImage]) -> Result<Vec<VisionOutput>, BackendError> {
+        images
