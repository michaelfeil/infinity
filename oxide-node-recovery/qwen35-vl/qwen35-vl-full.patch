+            .map(|image| self.inner.forward_image(&self.lt, image))
+            .collect()
+    }
+
+    pub(crate) fn image_features_device(
+        &self,
+        images: &[HostImage],
+    ) -> Result<Vec<qwen35_vl_device::VisionDeviceOutput>, BackendError> {
+        images
+            .iter()
+            .map(|image| self.inner.forward_image_device(&self.lt, image))
+            .collect()
+    }
+}
