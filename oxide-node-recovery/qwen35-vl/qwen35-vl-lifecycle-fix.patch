+    return module
+
+def run(name, func):
+    try:
+        func()
+        checks.append({"name": name, "passed": True})
+    except BaseException as error:
+        checks.append({"name": name, "passed": False, "error": str(error)})
+        raise
+
+def one(name):
+    def register(func):
+        run(name, func)
+        return func
+    return register
+
+@one("argparse_help")
