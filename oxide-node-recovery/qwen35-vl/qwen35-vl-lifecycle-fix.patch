+    fn media_preflight_rejects_text_only_and_audio_but_accepts_validated_vl_images() {
+        assert!(validate_media_preflight(&batch_with_media(false), true).is_ok());
+        assert!(validate_media_preflight(&batch_with_media(false), false).is_err());
