+) -> Result<&'a Fixture, Box<dyn std::error::Error>> {
+    file.fixtures
+        .iter()
+        .find(|fixture| fixture.name == name)
+        .ok_or_else(|| format!("fixture {name} is missing from the manifest").into())
+}
+
+fn embedding_rows(
