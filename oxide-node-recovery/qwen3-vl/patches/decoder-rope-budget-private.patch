 /// for the immutable tables without silently growing at inference.
 const ROPE_TABLE_BYTE_LIMIT: usize = 128 * 1024 * 1024;
 
+/// The table cap above covers only the immutable cosine/sine payload. The
+/// constructor also creates one inverse-frequency `f32` per rotary pair; that
+/// exact, checked scratch rides on top of the table cap. A legal
+/// 262,144-position d128 table is therefore exactly 128 MiB of tables plus
+/// its 256-byte inverse metadata, rather than an over-budget construction.
+fn rope_construction_budget(head_dim: usize) -> Result<usize, BackendError> {
+    let inverse_bytes = (head_dim / 2)
+        .checked_mul(std::mem::size_of::<f32>())
+        .ok_or_else(|| start("decoder RoPE inverse metadata size overflowed usize"))?;
+    ROPE_TABLE_BYTE_LIMIT
+        .checked_add(inverse_bytes)
+        .ok_or_else(|| start("decoder RoPE construction budget overflowed usize"))
+}
