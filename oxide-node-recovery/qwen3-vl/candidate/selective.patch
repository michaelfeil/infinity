+// Concrete Qwen3-VL composition: config -> vision tower -> dense text decoder
+// -> trained readout -> engine `Backend`.
+//
+// The family is deliberately narrow: `qwen3_vl`, `colqwen3` and
+// `qwen3_vl_nemotron_embed`. Qwen3.5-VL is a different text foundation and is
+// handled by its own author through the shared contract in
+// `qwen-vl-shared-plan-v1`.
+
+use crate::checkpoint::start;
+use crate::qwen3_vl_batch::{pack_batch, PackedVlRequest};
+use crate::qwen3_vl_config::{Qwen3VlConfig, ReadoutKind};
+use crate::qwen3_vl_device::{
+    Qwen3VlExecutor, Qwen3VlForwardResult, Qwen3VlPending, Qwen3VlWorkspaces,
+};
+use crate::qwen3_vl_readout::Qwen3VlReadout;
+use crate::staging::HostIoLease;
+use cuda_core::{Context, Stream};
+use infinity_v3_backend_core::{
+    Backend, BackendError, Batch, Embedding, Embeddings, Inference, Pool, Predictions,
+    TokenPredictions,
+};
+use std::path::Path;
+use std::sync::Arc;
+
+/// Config-aware media preflight used by every public route before an empty
+/// selector shortcut or any GPU work. The descriptor's own patch_dim is not
+/// trusted: the loaded tower's patch dimension and merge size are authoritative.
+pub(crate) fn validate_media_against_config(
+    config: &Qwen3VlConfig,
+    request: &PackedVlRequest,
+) -> Result<(), BackendError> {
+    let patch_dim = config.vision.patch_dim()?;
+    if patch_dim == 0 {
+        return Err(start("vision patch dimension is zero"));
+    }
+    for image in &request.forward.images {
+        let patch_rows = image.patch_rows()?;
+        let expected = patch_rows
+            .checked_mul(patch_dim)
+            .ok_or_else(|| start("configured image payload overflow"))?;
+        if image.pixels.len() != expected {
+            return Err(start(format!(
+                "{} pixel payload {} does not match configured patch_dim {} x {} rows",
+                image.name,
+                image.pixels.len(),
+                patch_dim,
+                patch_rows
+            )));
+        }
+        if image.merge_size != config.vision.spatial_merge_size {
+            return Err(start(format!(
+                "{} merge size {} does not match configured {}",
+                image.name, image.merge_size, config.vision.spatial_merge_size
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Validate selection bounds and duplicates before any lease/ticket. Mixed
+/// pooled+raw selection is rejected because this engine's readout emits one
+/// result kind per request.
+pub(crate) fn validate_selectors(batch: &Batch, sequences: usize) -> Result<(), BackendError> {
+    if !batch.pooled_indices.is_empty() && !batch.raw_indices.is_empty() {
+        return Err(start(
+            "Qwen3-VL does not serve mixed pooled and raw selections",
+        ));
+    }
+    for (label, indices) in [
+        ("pooled", batch.pooled_indices.as_slice()),
+        ("raw", batch.raw_indices.as_slice()),
+    ] {
+        let mut seen = std::collections::BTreeSet::new();
+        for &index in indices {
+            if index as usize >= sequences {
+                return Err(start(format!(
+                    "{label} selection {index} exceeds {sequences} sequences"
+                )));
+            }
+            if !seen.insert(index) {
+                return Err(start(format!("duplicate {label} selection {index}")));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// One CPU preflight used by the async Backend submit and the public sync
+/// Batch route. Media, config consistency and selector bounds all run before
+/// an empty-selector success or any GPU work.
+pub(crate) fn prepare_batch(
+    config: &Qwen3VlConfig,
+    batch: &Batch,
+    pool: Pool,
+    raw: bool,
+) -> Result<PackedVlRequest, BackendError> {
+    let request = pack_batch(batch, pool, raw)?;
+    validate_media_against_config(config, &request)?;
+    validate_selectors(batch, request.sequences)?;
+    Ok(request)
+}
+
+fn product(left: usize, right: usize) -> Result<usize, BackendError> {
+    left.checked_mul(right)
+        .ok_or_else(|| start("dimension overflow"))
+}
+
+#[derive(Clone, Debug)]
+pub struct Qwen3VlBatchOutput {
+    pub pooled: Option<Vec<f32>>,
+    pub tokens: Option<Vec<f32>>,
+    pub width: usize,
+    pub sequences: usize,
+    pub cumulative: Vec<u32>,
+}
+
+pub struct Qwen3VlModel {
+    config: Qwen3VlConfig,
+    executor: Qwen3VlExecutor,
+    readout: Option<Qwen3VlReadout>,
+    stream: Arc<Stream>,
+}
+
+impl Qwen3VlModel {
+    pub fn open(
+        checkpoint: &Path,
+        context: &Arc<Context>,
+        stream: &Arc<Stream>,
+    ) -> Result<Self, BackendError> {
+        Self::open_with_readout(checkpoint, context, stream, None)
+    }
+
+    /// Open with an explicit trained readout override. No Native Qwen3-VL
+    /// `model_type` selects `ReadoutConfig::rerank()`; a caller must opt in
+    /// only after verifying the checkpoint's `score.weight`.
+    pub fn open_with_readout(
+        checkpoint: &Path,
+        context: &Arc<Context>,
+        stream: &Arc<Stream>,
+        override_readout: Option<crate::qwen3_vl_config::ReadoutConfig>,
+    ) -> Result<Self, BackendError> {
+        let mut config = Qwen3VlConfig::from_path(checkpoint)?;
+        if let Some(readout) = override_readout {
+            config.readout = readout;
+            config.validate()?;
+        }
+        let executor = Qwen3VlExecutor::new(checkpoint, context, stream)?;
+        let readout =
+            if config.readout.kind == ReadoutKind::Embedding && !config.readout.multi_vector {
+                None
+            } else {
+                Some(Qwen3VlReadout::load(
+                    checkpoint,
+                    &config.readout,
+                    config.text.hidden_size,
+                )?)
+            };
+        if config.readout.multi_vector && !config.readout.normalize {
+            return Err(start(
+                "multi-vector Qwen3-VL requires per-row normalization",
+            ));
+        }
+        Ok(Self {
+            config,
+            executor,
+            readout,
+            stream: stream.clone(),
+        })
+    }
+
+    pub fn config(&self) -> &Qwen3VlConfig {
+        &self.config
+    }
+
+    pub fn synchronize(&self) -> Result<(), BackendError> {
+        self.stream.synchronize().map_err(start)
+    }
+
+    pub fn supports_images(&self) -> bool {
+        true
+    }
+
+    pub fn supports_video(&self) -> bool {
+        true
+    }
+
+    pub fn supports_raw(&self) -> bool {
+        true
+    }
+
+    pub fn supports_multi_vector(&self) -> bool {
+        self.config.readout.multi_vector
+    }
+
+    pub fn output_width(&self) -> usize {
+        self.readout
+            .as_ref()
+            .map_or(self.config.text.hidden_size, Qwen3VlReadout::output_width)
+    }
+
+    pub(crate) fn hidden(&self) -> usize {
+        self.config.text.hidden_size
+    }
+
+    pub(crate) fn stream(&self) -> Arc<Stream> {
+        self.stream.clone()
+    }
+
+    pub(crate) fn bind_context(&self) -> Result<(), BackendError> {
+        self.stream.context().bind_to_thread().map_err(start)
+    }
+
+    pub(crate) fn workspace() -> Qwen3VlWorkspaces {
+        Qwen3VlWorkspaces::default()
+    }
+
+    pub(crate) fn launch_packed(
+        &mut self,
+        request: &PackedVlRequest,
+        workspaces: &mut Qwen3VlWorkspaces,
+        lease: &mut HostIoLease,
+    ) -> Result<Qwen3VlPending, BackendError> {
+        match self
+            .executor
+            .forward_outputs_with(&request.forward, workspaces, Some(lease))?
+        {
+            Qwen3VlForwardResult::Launched(pending) => Ok(pending),
+            Qwen3VlForwardResult::Ready(_) => Err(start(
+                "VL async launch unexpectedly completed without a host lease",
+            )),
+        }
+    }
+
+    /// Pack raw token rows from the request's pinned host output after the
+    /// ordered fence. The readout projection is the checkpoint's trained one.
+    /// Actual raw-output contract: plain Qwen3-VL returns the final hidden rows
+    /// unchanged (Native MultiVectorModel is not applied); trained multi-vector
+    /// wrappers apply their projection/normalization; Nemotron applies row L2.
+    pub(crate) fn raw_output_rows(
+        readout: Option<&Qwen3VlReadout>,
+        raw: &[f32],
+        tokens: usize,
+        hidden: usize,
+        multi_vector: bool,
+    ) -> Result<(Vec<f32>, usize), BackendError> {
+        match readout {
+            Some(readout) => Ok((readout.apply_rows(raw, tokens)?, readout.output_width())),
+            None if !multi_vector => Ok((raw.to_vec(), hidden)),
+            None => Err(start(
+                "multi-vector raw output requires a trained projection/normalization readout",
+            )),
+        }
+    }
+
+    pub(crate) fn pack_raw(
+        &self,
+        batch: &Batch,
+        pool: Pool,
+        raw_tokens: bool,
+        raw: &[f32],
+    ) -> Result<Embeddings, BackendError> {
+        let hidden = self.config.text.hidden_size;
+        let tokens = batch.input_ids.len();
+        let sequences = batch
+            .cumulative_seq_lengths
+            .len()
+            .checked_sub(1)
+            .ok_or_else(|| start("missing cumulative boundaries"))?;
+        if raw.len() != product(tokens, hidden)? {
+            return Err(start("pinned VL output row count mismatch"));
+        }
+        let mut embeddings = Embeddings::default();
+        if raw_tokens {
+            let (rows, width) = Self::raw_output_rows(
+                self.readout.as_ref(),
+                raw,
+                tokens,
+                hidden,
+                self.config.readout.multi_vector,
+            )?;
+            for &index in &batch.raw_indices {
+                let row = index as usize;
+                let begin = *batch
+                    .cumulative_seq_lengths
+                    .get(row)
+                    .ok_or_else(|| start("raw sequence index out of range"))?
+                    as usize;
+                let end = *batch
+                    .cumulative_seq_lengths
+                    .get(row + 1)
+                    .ok_or_else(|| start("raw sequence end out of range"))?
+                    as usize;
+                let vectors = rows
+                    .get(begin * width..end * width)
+                    .ok_or_else(|| start("raw token rows missing"))?
+                    .chunks_exact(width)
+                    .map(|row| row.to_vec())
+                    .collect();
+                embeddings.insert(row, Embedding::All(vectors));
+            }
+            return Ok(embeddings);
+        }
+        let mut pooled = Vec::with_capacity(sequences * hidden);
+        for pair in batch.cumulative_seq_lengths.windows(2) {
+            let begin = pair[0] as usize;
+            let end = pair[1] as usize;
+            match pool {
+                Pool::Cls => pooled.extend_from_slice(&raw[begin * hidden..(begin + 1) * hidden]),
+                Pool::LastToken => {
+                    let last = end - 1;
+                    pooled.extend_from_slice(&raw[last * hidden..(last + 1) * hidden]);
+                }
+                Pool::Mean => {
+                    let count = (end - begin) as f32;
+                    for column in 0..hidden {
+                        let mut sum = 0f32;
+                        for row in begin..end {
+                            sum += raw[row * hidden + column];
+                        }
+                        pooled.push(sum / count);
+                    }
+                }
+                Pool::Splade => return Err(start("Oxide Qwen3-VL SPLADE pooling is unsupported")),
+            }
+        }
+        if let Some(readout) = self.readout.as_ref() {
+            if readout.config.kind == ReadoutKind::Rerank {
+                let scores = readout.apply_scores(&pooled, sequences)?;
+                for &index in &batch.pooled_indices {
+                    let row = index as usize;
+                    embeddings.insert(row, Embedding::Pooled(scores[row..row + 1].to_vec()));
+                }
+                return Ok(embeddings);
+            }
+        }
+        for &index in &batch.pooled_indices {
+            let row = index as usize;
+            let begin = row
+                .checked_mul(hidden)
+                .ok_or_else(|| start("pooled row offset overflow"))?;
+            embeddings.insert(
+                row,
+                Embedding::Pooled(pooled[begin..begin + hidden].to_vec()),
+            );
+        }
+        Ok(embeddings)
+    }
+
+    pub fn forward_batch(
+        &mut self,
+        batch: &Batch,
+        pool: Pool,
+    ) -> Result<Qwen3VlBatchOutput, BackendError> {
+        let multi_vector = self.config.readout.multi_vector;
+        if multi_vector && !batch.pooled_indices.is_empty() {
+            return Err(start(
+                "Qwen3-VL multi-vector wrappers return token rows and reject pooling",
+            ));
+        }
+        let raw_tokens = multi_vector || !batch.raw_indices.is_empty();
+        // Validate media, config consistency and selectors before the empty shortcut.
+        let request = prepare_batch(&self.config, batch, pool, raw_tokens)?;
+        let pooled_request = batch.pooled_indices.len();
+        let raw_request = batch.raw_indices.len();
+        if pooled_request == 0 && raw_request == 0 {
+            return Ok(Qwen3VlBatchOutput {
+                pooled: Some(Vec::new()),
+                tokens: None,
+                width: self.output_width(),
+                sequences: request.sequences,
+                cumulative: batch.cumulative_seq_lengths.clone(),
+            });
+        }
+        let output = self.executor.forward_outputs(&request.forward)?;
+        if let Some(tokens) = output.raw {
+            let readout = self
+                .readout
+                .as_ref()
+                .ok_or_else(|| start("raw Qwen3-VL output requires a configured readout"))?;
+            let rows = readout.apply_rows(&tokens, request.tokens)?;
+            return Ok(Qwen3VlBatchOutput {
+                pooled: None,
+                tokens: Some(rows),
+                width: readout.output_width(),
+                sequences: request.sequences,
+                cumulative: batch.cumulative_seq_lengths.clone(),
+            });
+        }
+        let pooled = output
+            .pooled
+            .ok_or_else(|| start("Qwen3-VL request produced no output"))?;
+        if let Some(readout) = self.readout.as_ref() {
+            if readout.config.kind == ReadoutKind::Rerank {
+                return Ok(Qwen3VlBatchOutput {
+                    pooled: Some(readout.apply_scores(&pooled, request.sequences)?),
+                    tokens: None,
+                    width: 1,
+                    sequences: request.sequences,
+                    cumulative: batch.cumulative_seq_lengths.clone(),
+                });
+            }
+        }
+        Ok(Qwen3VlBatchOutput {
+            pooled: Some(pooled),
+            tokens: None,
+            width: self.output_width(),
+            sequences: request.sequences,
+            cumulative: batch.cumulative_seq_lengths.clone(),
+        })
+    }
+}
+
+pub struct Qwen3VlBackend {
+    engine: crate::qwen3_vl_engine::Qwen3VlEngine,
+}
+
+impl Qwen3VlBackend {
+    pub fn new(checkpoint: &Path, dtype: &str, device_id: usize) -> Result<Self, BackendError> {
+        Self::new_with_pool(checkpoint, dtype, device_id, Pool::LastToken)
+    }
+
+    pub fn new_with_pool(
+        checkpoint: &Path,
+        dtype: &str,
+        device_id: usize,
+        pool: Pool,
+    ) -> Result<Self, BackendError> {
+        if dtype != "bfloat16" {
+            return Err(start(
+                "Qwen3-VL Oxide concrete execution currently requires bfloat16",
+            ));
+        }
+        let context = Context::new(device_id).map_err(start)?;
+        let stream = context.new_stream().map_err(start)?;
+        let model = Qwen3VlModel::open(checkpoint, &context, &stream)?;
+        let engine = crate::qwen3_vl_engine::Qwen3VlEngine::new(model, context, pool)?;
+        Ok(Self { engine })
+    }
+
+    pub fn config(&self) -> Result<Qwen3VlConfig, BackendError> {
+        self.engine.config()
+    }
+
+    pub fn output_width(&self) -> Result<usize, BackendError> {
+        self.engine.output_width()
+    }
+
+    /// Explicit-pool submission on the same owning Backend route. Used by the
+    /// quality consumer to emit Native-comparable Cls/Mean/LastToken/raw rows
+    /// without constructing additional model instances.
+    pub fn submit_with_pool(
+        &self,
+        batch: Batch,
+        pool: Pool,
+    ) -> Result<Inference<Embeddings>, BackendError> {
+        self.engine.submit_with_pool(batch, pool)
+    }
+}
+
+impl Backend for Qwen3VlBackend {
+    fn health(&self) -> Result<(), BackendError> {
+        self.engine.health()
+    }
+
+    fn max_batch_size(&self) -> Option<usize> {
+        None
+    }
+
+    fn embed(&self, batch: Batch) -> Result<Embeddings, BackendError> {
+        self.submit_embed(batch)?.complete()
+    }
+
+    fn submit_embed(&self, batch: Batch) -> Result<Inference<Embeddings>, BackendError> {
+        self.engine.submit(batch)
+    }
+
+    fn predict(&self, _batch: Batch) -> Result<Predictions, BackendError> {
+        Err(start(
+            "Qwen3-VL does not select a Native sequence-classification wrapper",
+        ))
+    }
+
+    fn predict_tokens(&self, _batch: Batch) -> Result<TokenPredictions, BackendError> {
+        Err(start(
+            "Qwen3-VL does not select a Native token-classification wrapper",
+        ))
+    }
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_text.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_text.rs
new file mode 100644
index 0000000..36a04a2
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_text.rs
@@ -0,0 +1,315 @@
+// Text-side fusion contract for Qwen3-VL: interleaved mRoPE, marker spans,
+// deepstack stage mapping and cached-prefix placeholders.
+//
+// `image_position_ids` is a selective extraction of the frozen media
+// foundation v2 implementation (`backends/core/src/media/packed.rs`). It keeps
+// the same checked ordering and arithmetic so the Oxide processor and executor
+// cannot drift from the shared Qwen3Vl policy.
+
+use crate::checkpoint::start;
+use crate::qwen3_vl_config::TextConfig;
+use crate::qwen3_vl_vision::ImageGrid;
+use infinity_v3_backend_core::BackendError;
+
+/// Native Qwen3-VL interleaved mRoPE axis assignment.
+pub fn mrope_axis_map(text_dim: usize, sections: [usize; 3]) -> Result<Vec<u8>, BackendError> {
+    if text_dim == 0 || !text_dim.is_multiple_of(2) {
+        return Err(start("text head dimension must be positive and even"));
+    }
+    let sum = sections
+        .iter()
+        .try_fold(0usize, |sum, value| sum.checked_add(*value))
+        .ok_or_else(|| start("mRoPE section sum overflow"))?;
+    if sum != text_dim / 2 {
+        return Err(start(format!(
+            "mRoPE sections {sections:?} do not sum to head_dim/2 ({})",
+            text_dim / 2
+        )));
+    }
+    let s1 = sections[1];
+    let s2 = sections[2];
+    let mut axes = Vec::with_capacity(text_dim / 2);
+    for j in 0..text_dim / 2 {
+        let axis = if j % 3 == 1 && j < s1 * 3 {
+            1
+        } else if j % 3 == 2 && j < s2 * 3 {
+            2
+        } else {
+            0
+        };
+        axes.push(axis);
+    }
+    Ok(axes)
+}
+
+/// `freq[j] = 1 / theta^(2j/text_dim)` in F32, as Native builds the external
+/// multimodal table (`rope_theta` default 1e6 for Qwen3-VL).
+pub fn mrope_frequencies(text_dim: usize, theta: f64) -> Result<Vec<f32>, BackendError> {
+    if text_dim == 0 || !text_dim.is_multiple_of(2) {
+        return Err(start("text head dimension must be positive and even"));
+    }
+    if !(theta.is_finite() && theta > 0.0) {
+        return Err(start("rope theta must be positive and finite"));
+    }
+    let mut out = Vec::with_capacity(text_dim / 2);
+    for j in 0..text_dim / 2 {
+        out.push((1.0f64 / theta.powf(2.0 * j as f64 / text_dim as f64)) as f32);
+    }
+    Ok(out)
+}
+
+/// Build the Native Qwen mRoPE position remap. Image spans are canonicalized by
+/// token start. Text gaps advance all axes together. Returned arrays are
+/// `[axis0, axis1, axis2]`, each of length `tokens`.
+pub fn image_position_ids(
+    tokens: usize,
+    images: &[ImageGrid],
+) -> Result<[Vec<u32>; 3], BackendError> {
+    let mut ordered: Vec<&ImageGrid> = images.iter().collect();
+    ordered.sort_unstable_by_key(|image| image.token_start);
+    let mut axes: [Vec<u32>; 3] = std::array::from_fn(|_| Vec::new());
+    for axis in &mut axes {
+        axis.try_reserve_exact(tokens)
+            .map_err(|_| start("multimodal position allocation"))?;
+    }
+    let mut cursor = 0usize;
+    let mut next = 0u32;
+    for image in ordered {
+        let patches = image
+            .frames
+            .checked_mul(image.height)
+            .and_then(|value| value.checked_mul(image.width))
+            .ok_or_else(|| start("image grid overflow"))?;
+        let merge_area = image
+            .merge_size
+            .checked_mul(image.merge_size)
+            .filter(|value| *value > 0)
+            .ok_or_else(|| start("invalid image merge size"))?;
+        if patches == 0
+            || image.height % image.merge_size != 0
+            || image.width % image.merge_size != 0
+            || !patches.is_multiple_of(merge_area)
+        {
+            return Err(start("invalid image grid for merge"));
+        }
+        let length = patches / merge_area;
+        if length == 0 || image.token_count != length {
+            return Err(start("image token count does not match merged geometry"));
+        }
+        let end = image
+            .token_start
+            .checked_add(length)
+            .filter(|end| *end <= tokens)
+            .ok_or_else(|| start("image token span exceeds token count"))?;
+        if image.token_start < cursor {
+            return Err(start("overlapping image token spans"));
+        }
+        for _ in cursor..image.token_start {
+            for axis in &mut axes {
+                axis.push(next);
+            }
+            next = next
+                .checked_add(1)
+                .ok_or_else(|| start("multimodal position overflow"))?;
+        }
+        let height = image.height / image.merge_size;
+        let width = image.width / image.merge_size;
+        for frame in 0..image.frames {
+            let temporal = next
+                .checked_add(u32::try_from(frame).map_err(start)?)
+                .ok_or_else(|| start("temporal position overflow"))?;
+            for row in 0..height {
+                let row = next
+                    .checked_add(u32::try_from(row).map_err(start)?)
+                    .ok_or_else(|| start("row position overflow"))?;
+                for column in 0..width {
+                    let column = next
+                        .checked_add(u32::try_from(column).map_err(start)?)
+                        .ok_or_else(|| start("column position overflow"))?;
+                    axes[0].push(temporal);
+                    axes[1].push(row);
+                    axes[2].push(column);
+                }
+            }
+        }
+        let advance = height.max(width).max(image.frames);
+        next = next
+            .checked_add(u32::try_from(advance).map_err(start)?)
+            .ok_or_else(|| start("position advance overflow"))?;
+        cursor = end;
+    }
+    for _ in cursor..tokens {
+        for axis in &mut axes {
+            axis.push(next);
+        }
+        next = next
+            .checked_add(1)
+            .ok_or_else(|| start("text position overflow"))?;
+    }
+    if axes.iter().any(|axis| axis.len() != tokens) {
+        return Err(start("multimodal position length mismatch"));
+    }
+    Ok(axes)
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct MropePhases {
+    pub tokens: usize,
+    pub half_dim: usize,
+    pub cos: Vec<f32>,
+    pub sin: Vec<f32>,
+}
+
+impl MropePhases {
+    pub fn row(&self, token: usize) -> Option<(&[f32], &[f32])> {
+        if token >= self.tokens {
+            return None;
+        }
+        let start = token.checked_mul(self.half_dim)?;
+        let end = start.checked_add(self.half_dim)?;
+        Some((self.cos.get(start..end)?, self.sin.get(start..end)?))
+    }
+}
+
+pub fn mrope_phases(
+    positions: &[Vec<u32>; 3],
+    axes: &[u8],
+    frequency: &[f32],
+) -> Result<MropePhases, BackendError> {
+    if positions[0].len() != positions[1].len() || positions[0].len() != positions[2].len() {
+        return Err(start("mRoPE axes have different lengths"));
+    }
+    if axes.len() != frequency.len() {
+        return Err(start("mRoPE axis/frequency length mismatch"));
+    }
+    let tokens = positions[0].len();
+    let half_dim = axes.len();
+    let total = tokens
+        .checked_mul(half_dim)
+        .ok_or_else(|| start("mRoPE phase size overflow"))?;
+    let mut cos = Vec::with_capacity(total);
+    let mut sin = Vec::with_capacity(total);
+    for ((axis0, axis1), axis2) in positions[0]
+        .iter()
+        .zip(positions[1].iter())
+        .zip(positions[2].iter())
+    {
+        for (j, axis) in axes.iter().enumerate() {
+            let position = match axis {
+                0 => *axis0,
+                1 => *axis1,
+                2 => *axis2,
+                _ => return Err(start("invalid mRoPE axis")),
+            };
+            let angle = position as f32 * frequency[j];
+            cos.push(angle.cos());
+            sin.push(angle.sin());
+        }
+    }
+    Ok(MropePhases {
+        tokens,
+        half_dim,
+        cos,
+        sin,
+    })
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct MarkerSpan {
+    pub token_start: usize,
+    pub token_count: usize,
+}
+
+pub fn marker_spans(images: &[ImageGrid], tokens: usize) -> Result<Vec<MarkerSpan>, BackendError> {
+    let mut spans = Vec::with_capacity(images.len());
+    let mut previous_end = 0usize;
+    let mut ordered: Vec<&ImageGrid> = images.iter().collect();
+    ordered.sort_unstable_by_key(|image| image.token_start);
+    for image in ordered {
+        let end = image
+            .token_start
+            .checked_add(image.token_count)
+            .filter(|end| *end <= tokens)
+            .ok_or_else(|| start("image marker span exceeds tokens"))?;
+        if image.token_start < previous_end || image.token_count == 0 {
+            return Err(start("overlapping or empty image marker span"));
+        }
+        spans.push(MarkerSpan {
+            token_start: image.token_start,
+            token_count: image.token_count,
+        });
+        previous_end = end;
+    }
+    Ok(spans)
+}
+
+/// Native uses the first `deepstack.len()` text layers in capture order.
+pub fn deepstack_text_layers(
+    text_layers: usize,
+    deepstack_tensors: usize,
+) -> Result<Vec<usize>, BackendError> {
+    if deepstack_tensors > text_layers {
+        return Err(start(format!(
+            "{deepstack_tensors} deepstack tensors exceed {text_layers} text layers"
+        )));
+    }
+    Ok((0..deepstack_tensors).collect())
+}
+
+/// Cached visual-prefix requests with no current images still receive one empty
+/// placeholder per configured deepstack stage so the text suffix keeps its
+/// original stage accounting.
+pub fn empty_prefix_deepstack(
+    config: &TextConfig,
+    configured: usize,
+) -> Result<Vec<[usize; 2]>, BackendError> {
+    let layers = deepstack_text_layers(config.num_hidden_layers, configured)?;
+    Ok(layers
+        .into_iter()
+        .map(|_| [0, config.hidden_size])
+        .collect::<Vec<[usize; 2]>>())
+}
+
+#[derive(Clone, Debug)]
+pub struct TextFusionPlan {
+    pub tokens: usize,
+    pub markers: Vec<MarkerSpan>,
+    pub positions: [Vec<u32>; 3],
+    pub axes: Vec<u8>,
+    pub frequency: Vec<f32>,
+    pub phases: MropePhases,
+    pub deepstack_layers: Vec<usize>,
+}
+
+pub fn prepare_text_fusion(
+    config: &TextConfig,
+    tokens: usize,
+    images: &[ImageGrid],
+    deepstack_tensors: usize,
+) -> Result<TextFusionPlan, BackendError> {
+    if tokens == 0 {
+        return Err(start("text fusion requires at least one token"));
+    }
+    let markers = marker_spans(images, tokens)?;
+    let positions = if images.is_empty() {
+        let plain: Vec<u32> = (0..tokens)
+            .map(|token| u32::try_from(token).map_err(start))
+            .collect::<Result<Vec<_>, _>>()?;
+        [plain.clone(), plain.clone(), plain]
+    } else {
+        image_position_ids(tokens, images)?
+    };
+    let axes = mrope_axis_map(config.text_dim(), config.mrope_section)?;
+    let frequency = mrope_frequencies(config.text_dim(), config.rope_theta)?;
+    let phases = mrope_phases(&positions, &axes, &frequency)?;
+    let deepstack_layers = deepstack_text_layers(config.num_hidden_layers, deepstack_tensors)?;
+    Ok(TextFusionPlan {
+        tokens,
+        markers,
+        positions,
+        axes,
+        frequency,
+        phases,
+        deepstack_layers,
+    })
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_vision.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_vision.rs
new file mode 100644
index 0000000..9839886
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_vision.rs
@@ -0,0 +1,332 @@
+// Structural vision-tower preparation shared by the full and tower-only paths.
+//
+// Every function is pure host arithmetic. It reproduces the actual Native
+// pre-processing order: merge-group-major patch rows, four-corner learned
+// position interpolation, 2-D split-half rotary phases, per-frame attention
+// isolation, equal-length frame batching for multi-vector mode, and the
+// workspace-driven image batching heuristic from `helpers/vision_batch.h`.
+
+use crate::checkpoint::start;
+use infinity_v3_backend_core::BackendError;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ImageGrid {
+    pub frames: usize,
+    pub height: usize,
+    pub width: usize,
+    pub merge_size: usize,
+    pub token_start: usize,
+    pub token_count: usize,
+}
+
+impl ImageGrid {
+    pub fn new(
+        frames: usize,
+        height: usize,
+        width: usize,
+        merge_size: usize,
+        token_start: usize,
+        token_count: usize,
+    ) -> Result<Self, BackendError> {
+        if frames == 0 || height == 0 || width == 0 || merge_size == 0 {
+            return Err(start("image grid dimensions must be positive"));
+        }
+        if !height.is_multiple_of(merge_size) || !width.is_multiple_of(merge_size) {
+            return Err(start("image grid is not divisible by merge size"));
+        }
+        let merged = merged_count(frames, height, width, merge_size)?;
+        if token_count != merged {
+            return Err(start(format!(
+                "image span declares {token_count} tokens but grid {frames}x{height}x{width} with merge {merge_size} requires {merged}"
+            )));
+        }
+        Ok(Self {
+            frames,
+            height,
+            width,
+            merge_size,
+            token_start,
+            token_count,
+        })
+    }
+
+    pub fn patch_rows(&self) -> Result<usize, BackendError> {
+        self.frames
+            .checked_mul(self.height)
+            .and_then(|value| value.checked_mul(self.width))
+            .ok_or_else(|| start("image patch rows overflow"))
+    }
+}
+
+pub fn merged_count(
+    frames: usize,
+    height: usize,
+    width: usize,
+    merge: usize,
+) -> Result<usize, BackendError> {
+    if frames == 0 || height == 0 || width == 0 || merge == 0 {
+        return Err(start("image grid dimensions must be positive"));
+    }
+    if !height.is_multiple_of(merge) || !width.is_multiple_of(merge) {
+        return Err(start("image grid is not divisible by merge size"));
+    }
+    let patches = frames
+        .checked_mul(height)
+        .and_then(|value| value.checked_mul(width))
+        .ok_or_else(|| start("image patch count overflow"))?;
+    let area = merge
+        .checked_mul(merge)
+        .ok_or_else(|| start("merge area overflow"))?;
+    patches
+        .checked_div(area)
+        .filter(|count| *count > 0)
+        .ok_or_else(|| start("image merge count is zero"))
+}
+
+/// Recover the original spatial `(row, column)` from the processor's
+/// merge-group-major patch index. `index` is relative to the frame, matching
+/// the Native modulo recovery after subtracting the frame offset.
+pub fn merge_major_coords(
+    index: usize,
+    merge: usize,
+    height: usize,
+    width: usize,
+) -> Result<(usize, usize), BackendError> {
+    if merge == 0 || height == 0 || width == 0 {
+        return Err(start("invalid merge-major geometry"));
+    }
+    if !height.is_multiple_of(merge) || !width.is_multiple_of(merge) {
+        return Err(start("merge-major geometry is not divisible by merge"));
+    }
+    if index >= height * width {
+        return Err(start("merge-major index exceeds frame"));
+    }
+    let merge_area = merge
+        .checked_mul(merge)
+        .ok_or_else(|| start("merge area overflow"))?;
+    let width_blocks = width / merge;
+    let height_blocks = height / merge;
+    let column = index % merge + ((index / merge_area) % width_blocks) * merge;
+    let row = (index / merge) % merge + ((index / (merge * width)) % height_blocks) * merge;
+    Ok((row, column))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PositionCorner {
+    pub row: f32,
+    pub column: f32,
+    pub r0: usize,
+    pub r1: usize,
+    pub c0: usize,
+    pub c1: usize,
+    pub dr: f32,
+    pub dc: f32,
+}
+
+pub fn position_interpolation(
+    side: usize,
+    height: usize,
+    width: usize,
+    merge: usize,
+) -> Result<Vec<PositionCorner>, BackendError> {
+    if side == 0 {
+        return Err(start("position table side must be positive"));
+    }
+    let rows = height
+        .checked_mul(width)
+        .ok_or_else(|| start("position row count overflow"))?;
+    let row_scale = if height == 1 {
+        0.0
+    } else {
+        (side - 1) as f32 / (height - 1) as f32
+    };
+    let column_scale = if width == 1 {
+        0.0
+    } else {
+        (side - 1) as f32 / (width - 1) as f32
+    };
+    let mut out = Vec::with_capacity(rows);
+    for index in 0..rows {
+        let (row, column) = merge_major_coords(index, merge, height, width)?;
+        let row_f = row as f32 * row_scale;
+        let column_f = column as f32 * column_scale;
+        let r0 = row_f.floor() as usize;
+        let c0 = column_f.floor() as usize;
+        let r1 = (row_f.ceil() as usize).min(side - 1);
+        let c1 = (column_f.ceil() as usize).min(side - 1);
+        out.push(PositionCorner {
+            row: row_f,
+            column: column_f,
+            r0,
+            r1,
+            c0,
+            c1,
+            dr: row_f - r0 as f32,
+            dc: column_f - c0 as f32,
+        });
+    }
+    Ok(out)
+}
+
+/// `freq[j] = 1 / 10000^(2j/(dim/2))` for `j < dim/4` (Native vision table).
+pub fn vision_frequency(dim: usize) -> Result<Vec<f32>, BackendError> {
+    if dim == 0 || !dim.is_multiple_of(4) {
+        return Err(start("vision head dimension must be divisible by 4"));
+    }
+    let count = dim / 4;
+    let mut out = Vec::with_capacity(count);
+    for j in 0..count {
+        out.push(1.0f32 / 10_000f32.powf(2.0 * j as f32 / (dim as f32 / 2.0)));
+    }
+    Ok(out)
+}
+
+pub fn vision_angles(dim: usize, row: f32, column: f32) -> Result<Vec<f32>, BackendError> {
+    let frequency = vision_frequency(dim)?;
+    let mut angles = Vec::with_capacity(frequency.len() * 2);
+    for value in &frequency {
+        angles.push(row * value);
+    }
+    for value in &frequency {
+        angles.push(column * value);
+    }
+    Ok(angles)
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct FramePlan {
+    pub cu_seqlens: Vec<i32>,
+    pub frame_lengths: Vec<usize>,
+    pub image_frame_spans: Vec<(usize, usize)>,
+    pub merged_counts: Vec<usize>,
+    pub max_frame: usize,
+}
+
+pub fn frame_plan(images: &[ImageGrid]) -> Result<FramePlan, BackendError> {
+    let mut cu_seqlens = Vec::with_capacity(images.len() + 1);
+    cu_seqlens.push(0i32);
+    let mut frame_lengths = Vec::new();
+    let mut image_frame_spans = Vec::with_capacity(images.len());
+    let mut merged_counts = Vec::with_capacity(images.len());
+    let mut max_frame = 0usize;
+    for image in images {
+        let frame_length = image
+            .height
+            .checked_mul(image.width)
+            .ok_or_else(|| start("frame length overflow"))?;
+        let first_frame = frame_lengths.len();
+        for _ in 0..image.frames {
+            let next = (*cu_seqlens.last().unwrap_or(&0) as usize)
+                .checked_add(frame_length)
+                .ok_or_else(|| start("frame offset overflow"))?;
+            if next > i32::MAX as usize {
+                return Err(start("vision frame offsets exceed i32"));
+            }
+            cu_seqlens.push(next as i32);
+            frame_lengths.push(frame_length);
+        }
+        image_frame_spans.push((first_frame, frame_lengths.len()));
+        merged_counts.push(merged_count(
+            image.frames,
+            image.height,
+            image.width,
+            image.merge_size,
+        )?);
+        max_frame = max_frame.max(frame_length);
+    }
+    Ok(FramePlan {
+        cu_seqlens,
+        frame_lengths,
+        image_frame_spans,
+        merged_counts,
+        max_frame,
+    })
+}
+
+/// Equal-length frame grouping used only by the multi-vector fallback.
+pub fn frame_groups(plan: &FramePlan) -> BTreeMap<usize, Vec<usize>> {
+    let mut groups: BTreeMap<usize, Vec<usize>> = BTreeMap::new();
+    for (frame, length) in plan.frame_lengths.iter().enumerate() {
+        groups.entry(*length).or_default().push(frame);
+    }
+    groups
+}
+
+/// Mirror of `vision_batches` with a caller-supplied byte budget. A single
+/// oversized image always forms its own batch and image order is preserved.
+pub fn vision_batches(
+    patch_rows: &[usize],
+    hidden: usize,
+    intermediate: usize,
+    budget_bytes: u64,
+) -> Result<Vec<(usize, usize)>, BackendError> {
+    if hidden == 0 || intermediate == 0 {
+        return Err(start("vision batching geometry must be positive"));
+    }
+    let per_row = 4u64
+        .checked_mul(
+            (8u64
+                .checked_mul(hidden as u64)
+                .ok_or_else(|| start("vision batching hidden overflow"))?)
+            .checked_add(
+                2u64.checked_mul(intermediate as u64)
+                    .ok_or_else(|| start("vision batching width overflow"))?,
+            )
+            .ok_or_else(|| start("vision batching row estimate overflow"))?,
+        )
+        .ok_or_else(|| start("vision batching row estimate overflow"))?;
+    let limit = usize::try_from((budget_bytes / per_row).max(1)).map_err(start)?;
+    let mut batches = Vec::new();
+    let mut batch_start = 0usize;
+    let mut patches = 0usize;
+    for (index, count) in patch_rows.iter().enumerate() {
+        if index > batch_start && (patches >= limit || *count > limit.saturating_sub(patches)) {
+            batches.push((batch_start, index));
+            batch_start = index;
+            patches = 0;
+        }
+        patches = patches
+            .checked_add(*count)
+            .ok_or_else(|| start("vision batch patch count overflow"))?;
+    }
+    if batch_start < patch_rows.len() {
+        batches.push((batch_start, patch_rows.len()));
+    }
+    Ok(batches)
+}
+
+pub fn image_feature_slices(images: &[ImageGrid]) -> Result<Vec<(usize, usize)>, BackendError> {
+    let mut offset = 0usize;
+    let mut slices = Vec::with_capacity(images.len());
+    for image in images {
+        slices.push((offset, image.token_count));
+        offset = offset
+            .checked_add(image.token_count)
+            .ok_or_else(|| start("merged feature offset overflow"))?;
+    }
+    Ok(slices)
+}
+
+/// Deepstack tensors are collected in increasing tower layer order even if the
+/// config list is unsorted; `deepstack_merger_list.i` is keyed by list position.
+pub fn deepstack_capture_order(
+    indexes: &[usize],
+    depth: usize,
+) -> Result<Vec<(usize, usize)>, BackendError> {
+    let mut seen = std::collections::BTreeSet::new();
+    let mut order = Vec::with_capacity(indexes.len());
+    for (name_index, layer) in indexes.iter().enumerate() {
+        if *layer >= depth {
+            return Err(start(format!(
+                "deepstack layer {layer} is outside vision depth {depth}"
+            )));
+        }
+        if !seen.insert(*layer) {
+            return Err(start(format!("duplicate deepstack layer {layer}")));
+        }
+        order.push((*layer, name_index));
+    }
+    order.sort_unstable_by_key(|(layer, _)| *layer);
+    Ok(order)
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_weights.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_weights.rs
