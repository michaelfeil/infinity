+
+impl<'a> ConsumerPlan<'a> {
+    pub fn from_packet(packet: &'a RootControlPacket) -> Self {
+        let mut options: Vec<(&str, &str)> = packet
+            .config_options
+            .iter()
+            .chain(packet.runtime_options.iter())
+            .map(|(key, value)| (key.as_str(), value.as_str()))
+            .collect();
+        options.sort_unstable();
+        let mut shards = Vec::new();
+        for summary in &packet.inventory.shards {
+            let weights = packet
+                .weights
+                .iter()
+                .filter(|weight| weight.shard == summary.shard)
+                .map(|weight| {
+                    (
+                        weight.original_name.as_str(),
+                        weight.shape.iter().map(|dim| *dim as i64).collect(),
+                        match weight.dtype.as_str() {
+                            "F32" => 0,
+                            "F16" => 1,
+                            _ => 2,
+                        },
+                        weight.source_offset,
+                        weight.source_length,
+                    )
+                })
+                .collect();
+            shards.push(ConsumerShard {
+                path: summary.shard.as_str(),
+                data_start: summary.data_start,
+                data_length: summary.data_length,
+                weights,
+            });
+        }
+        Self {
+            config: packet.tei_config,
+            device: "cuda",
+            dtype: 2,
+            options,
+            shards,
+            fixtures: Vec::new(),
+        }
+    }
+
+    /// Actual b66 CAPI sequence. Only a Root GPU process with a loaded b66
+    /// library and real fixtures should call this. The CPU evidence never does.
+    ///
+    /// # Safety
+    ///
+    /// Every function pointer in `api` must come from a b66-compatible
+    /// `libtei_torch.so`. `root` must contain the shards named by the packet,
+    /// and `fixture` buffers must outlive the call. The caller must own the GPU
+    /// and stream lifetime.
+    pub unsafe fn run(
+        &self,
+        api: &NativeB66Api,
+        root: &Path,
+        fixture: &ForwardFixture,
+    ) -> Result<Vec<f32>, String> {
+        unsafe {
+            let device = CString::new(self.device).map_err(|error| error.to_string())?;
+            let status = (api.device_preflight)(device.as_ptr());
+            if status != 0 {
+                return Err(error_text(api));
+            }
+            let handle = (api.create)(&self.config, device.as_ptr(), self.dtype);
+            if handle.is_null() {
+                return Err(error_text(api));
+            }
+            let guard = HandleGuard {
+                handle,
+                destroy: api.destroy,
+            };
+            for (key, value) in &self.options {
+                let key = CString::new(*key).map_err(|error| error.to_string())?;
+                let value = CString::new(*value).map_err(|error| error.to_string())?;
+                if (api.option)(guard.handle, key.as_ptr(), value.as_ptr()) != 0 {
+                    return Err(error_text(api));
+                }
+            }
+            for shard in &self.shards {
+                let path = root.join(shard.path);
+                let file = std::fs::File::open(&path).map_err(|error| error.to_string())?;
+                let mut names = Vec::with_capacity(shard.weights.len());
+                let mut shapes = Vec::with_capacity(shard.weights.len());
+                let mut native = Vec::with_capacity(shard.weights.len());
+                for (name, shape, _dtype, _offset, _length) in &shard.weights {
+                    names.push(CString::new(*name).map_err(|error| error.to_string())?);
+                    shapes.push(shape.clone());
+                    native.push(null_weight());
+                }
+                for (index, weight) in native.iter_mut().enumerate() {
+                    weight.name = names[index].as_ptr();
+                    weight.shape = shapes[index].as_ptr();
+                    weight.rank = shapes[index].len();
+                    weight.dtype = shard.weights[index].2;
+                    weight.offset = shard.weights[index].3;
+                    weight.length = shard.weights[index].4;
+                }
+                use std::os::fd::AsRawFd;
+                let status = (api.load_safetensors)(
+                    guard.handle,
+                    file.as_raw_fd(),
+                    shard.data_start,
+                    shard.data_length,
+                    native.as_ptr(),
+                    native.len(),
+                    4,
+                    64 * 1024 * 1024,
+                    0,
+                );
+                if status != 0 {
+                    return Err(error_text(api));
+                }
+            }
+            if (api.ready)(guard.handle) != 0 {
+                return Err(error_text(api));
+            }
+            let mut output = vec![0f32; fixture.capacity.max(1)];
+            let mut images = Vec::with_capacity(fixture.images.len());
+            for image in &fixture.images {
+                if image.pixels.len()
+                    != image
+                        .rows
+                        .checked_mul(image.patch_dim)
+                        .ok_or_else(|| "image pixel size overflow".to_owned())?
+                {
+                    return Err("fixture image pixel length mismatch".to_owned());
+                }
+                images.push(TeiImage {
+                    pixels: image.pixels.as_ptr(),
+                    rows: image.rows as i64,
+                    patch_dim: image.patch_dim as i64,
+                    grid: [
+                        image.grid[0] as i64,
+                        image.grid[1] as i64,
+                        image.grid[2] as i64,
+                    ],
+                    merge_size: image.merge_size as i64,
+                    token_start: image.token_start as i64,
+                    token_count: image.token_count as i64,
+                    sequence_start: image.sequence_start as i64,
+                    feature_key: [0u8; 32],
+                    has_feature_key: 0,
+                });
+            }
+            let pooled: Vec<i64> = fixture.pooled.clone();
+            let tokens = fixture.cumulative.last().copied().unwrap_or(0).max(0) as usize;
+            if fixture.ids.len() != tokens
+                || fixture.types.len() != tokens
+                || fixture.positions.len() != tokens
+            {
+                return Err("fixture token buffers do not match cumulative token count".to_owned());
+            }
+            if let Some(media) = fixture.media_positions.as_ref() {
+                if media.len() != tokens.saturating_mul(3) {
+                    return Err("fixture media_positions length is not 3*tokens".to_owned());
+                }
+            }
+            let mut max_sequence = 0i64;
+            for pair in fixture.cumulative.windows(2) {
+                if pair[0] < 0 || pair[1] < pair[0] {
+                    return Err("fixture cumulative offsets are not monotonic".to_owned());
+                }
+                max_sequence = max_sequence.max(i64::from(pair[1] - pair[0]));
+            }
+            if max_sequence <= 0 || max_sequence as usize > tokens {
+                return Err("fixture max_sequence is invalid".to_owned());
+            }
+            if fixture
+                .raw
+                .iter()
+                .any(|index| *index < 0 || *index >= fixture.cumulative.len() as i64 - 1)
+            {
+                return Err("fixture raw sequence index is out of range".to_owned());
+            }
+            let media_positions = fixture.media_positions.as_deref();
+            let media_ptr = media_positions.map_or(std::ptr::null(), |values| values.as_ptr());
+            let status = (api.forward)(
+                guard.handle,
+                fixture.ids.as_ptr(),
+                fixture.types.as_ptr(),
+                fixture.positions.as_ptr(),
+                fixture.cumulative.as_ptr(),
+                fixture.cumulative.len() as i64 - 1,
+                max_sequence,
+                0,
+                if pooled.is_empty() {
+                    std::ptr::null()
+                } else {
+                    pooled.as_ptr()
+                },
+                pooled.len(),
+                if fixture.raw.is_empty() {
+                    std::ptr::null()
+                } else {
+                    fixture.raw.as_ptr()
+                },
+                fixture.raw.len(),
+                output.as_mut_ptr(),
+                output.len(),
+                media_ptr,
+                if images.is_empty() {
+                    std::ptr::null()
+                } else {
+                    images.as_ptr()
+                },
+                images.len(),
+                std::ptr::null(),
+                0,
+            );
+            if status != 0 {
+                return Err(error_text(api));
+            }
+            Ok(output)
+        }
+    }
+}
+
+struct HandleGuard {
+    handle: *mut c_void,
+    destroy: TeiDestroy,
+}
+
+impl Drop for HandleGuard {
+    fn drop(&mut self) {
+        unsafe { (self.destroy)(self.handle) };
+    }
+}
+
+fn null_weight() -> TeiWeight {
+    TeiWeight {
+        name: std::ptr::null(),
+        shape: std::ptr::null(),
+        rank: 0,
+        dtype: 0,
+        offset: 0,
+        length: 0,
+    }
+}
+
+unsafe fn error_text(api: &NativeB66Api) -> String {
+    unsafe {
+        let pointer = (api.error)();
+        if pointer.is_null() {
+            return "Native b66 call failed without an error string".to_owned();
+        }
+        std::ffi::CStr::from_ptr(pointer)
+            .to_string_lossy()
+            .into_owned()
+    }
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_config.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_config.rs
new file mode 100644
index 0000000..3a9a7ed
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_config.rs
@@ -0,0 +1,692 @@
+// Checked cold configuration for Qwen3-VL.
+//
+// The field names, defaults and validation follow the actual Native constructor
+// in `backends/libtorch/cpp/models/qwen3_vl_models.cpp` and the dense Qwen3
+// decoder in `decoder_models.cpp`. The original JSON value is retained verbatim;
+// no caller-visible config key is rewritten or synthesized.
+
+use crate::checkpoint::{read_json, start};
+use infinity_v3_backend_core::BackendError;
+use serde_json::{Map, Value};
+use std::path::Path;
+
+pub const DEFAULT_RMS_NORM_EPS: f64 = 1e-6;
+pub const DEFAULT_ROPE_THETA: f64 = 1_000_000.0;
+pub const DEFAULT_VISION_ACT: &str = "gelu_pytorch_tanh";
+pub const DEFAULT_TEXT_ACT: &str = "silu";
+/// ColQwen3 checkpoints project token states to this width before MaxSim.
+pub const COLQWEN3_TOKEN_WIDTH: usize = 320;
+const DEFAULT_MAX_POSITION_EMBEDDINGS: usize = 32_768;
+
+/// Native aliases that share the concrete Qwen3-VL adapter. These are the only
+/// aliases admitted here; the generic Qwen3/Mistral families are owned by other
+/// agents and must not be routed through this module.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum QwenVlAlias {
+    Qwen3Vl,
+    ColQwen3,
+    NemotronColEmbed,
+}
+
+impl QwenVlAlias {
+    pub fn from_model_type(model_type: &str) -> Option<Self> {
+        match model_type {
+            "qwen3_vl" => Some(Self::Qwen3Vl),
+            "colqwen3" => Some(Self::ColQwen3),
+            "qwen3_vl_nemotron_embed" => Some(Self::NemotronColEmbed),
+            _ => None,
+        }
+    }
+
+    pub const fn model_type(self) -> &'static str {
+        match self {
+            Self::Qwen3Vl => "qwen3_vl",
+            Self::ColQwen3 => "colqwen3",
+            Self::NemotronColEmbed => "qwen3_vl_nemotron_embed",
+        }
+    }
+}
+
+/// Trained readout/wrapper actually selected by the Native LibTorch loader.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ReadoutKind {
+    Embedding,
+    ColQwen3,
+    NemotronColEmbed,
+    /// Generic trained relevance head over pooled VL rows. This is not a
+    /// Native Qwen3-VL family; it is admitted only when the checkpoint carries
+    /// a real `score.weight` and the caller explicitly asks for it.
+    Rerank,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ReadoutConfig {
+    pub kind: ReadoutKind,
+    pub multi_vector: bool,
+    pub skip_final_norm: bool,
+    pub transformers_math: bool,
+    pub token_projection_width: Option<usize>,
+    pub normalize: bool,
+    /// L2 denominator floor. ColQwen3 uses `finfo(dtype).eps`.
+    pub norm_eps: f64,
+}
+
+impl ReadoutConfig {
+    pub fn embedding() -> Self {
+        Self {
+            kind: ReadoutKind::Embedding,
+            multi_vector: false,
+            skip_final_norm: false,
+            transformers_math: false,
+            token_projection_width: None,
+            normalize: false,
+            norm_eps: 1e-12,
+        }
+    }
+
+    /// Explicit opt-in trained relevance head. No Native Qwen3-VL model_type
+    /// selects this wrapper; it is provided for a caller that verified the
+    /// checkpoint's `score.weight`.
+    pub fn rerank() -> Self {
+        Self {
+            kind: ReadoutKind::Rerank,
+            multi_vector: false,
+            skip_final_norm: false,
+            transformers_math: false,
+            token_projection_width: None,
+            normalize: false,
+            norm_eps: 1e-12,
+        }
+    }
+
+    fn from_model(alias: QwenVlAlias, architectures: &[String]) -> Self {
+        match alias {
+            QwenVlAlias::ColQwen3 => Self {
+                kind: ReadoutKind::ColQwen3,
+                multi_vector: true,
+                skip_final_norm: false,
+                transformers_math: true,
+                token_projection_width: Some(COLQWEN3_TOKEN_WIDTH),
+                normalize: true,
+                norm_eps: 1e-12,
+            },
+            QwenVlAlias::NemotronColEmbed => Self {
+                kind: ReadoutKind::NemotronColEmbed,
+                multi_vector: true,
+                skip_final_norm: true,
+                transformers_math: true,
+                token_projection_width: None,
+                normalize: true,
+                norm_eps: 1e-12,
+            },
+            QwenVlAlias::Qwen3Vl if architectures.iter().any(|value| value == "HF_ColBERT") => {
+                Self {
+                    kind: ReadoutKind::Embedding,
+                    multi_vector: true,
+                    skip_final_norm: false,
+                    transformers_math: false,
+                    token_projection_width: None,
+                    normalize: true,
+                    norm_eps: 1e-12,
+                }
+            }
+            QwenVlAlias::Qwen3Vl => Self::embedding(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Dtype {
+    F16,
+    Bf16,
+    F32,
+}
+
+impl Dtype {
+    pub fn parse(name: &str) -> Result<Self, BackendError> {
+        match name {
+            "float16" | "f16" | "half" => Ok(Self::F16),
+            "bfloat16" | "bf16" => Ok(Self::Bf16),
+            "float32" | "f32" => Ok(Self::F32),
+            other => Err(start(format!("unsupported model dtype {other}"))),
+        }
+    }
+
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::F16 => "float16",
+            Self::Bf16 => "bfloat16",
+            Self::F32 => "float32",
+        }
+    }
+
+    pub const fn width(self) -> usize {
+        match self {
+            Self::F16 | Self::Bf16 => 2,
+            Self::F32 => 4,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct VisionConfig {
+    pub hidden_size: usize,
+    pub num_heads: usize,
+    pub spatial_merge_size: usize,
+    pub depth: usize,
+    pub intermediate_size: usize,
+    pub patch_size: usize,
+    pub temporal_patch_size: usize,
+    pub in_channels: usize,
+    pub num_position_embeddings: usize,
+    pub out_hidden_size: usize,
+    pub hidden_act: String,
+    pub deepstack_visual_indexes: Vec<usize>,
+    pub dtype: Dtype,
+}
+
+impl VisionConfig {
+    pub fn head_dim(&self) -> usize {
+        self.hidden_size / self.num_heads
+    }
+
+    /// Native derives `side = round(sqrt(pos_embed.size(0)))` and requires a
+    /// square table. Validation enforces the same invariant.
+    pub fn position_side(&self) -> usize {
+        (self.num_position_embeddings as f64).sqrt().round() as usize
+    }
+
+    pub fn patch_dim(&self) -> Result<usize, BackendError> {
+        self.in_channels
+            .checked_mul(self.temporal_patch_size)
+            .and_then(|value| value.checked_mul(self.patch_size))
+            .and_then(|value| value.checked_mul(self.patch_size))
+            .ok_or_else(|| start("vision patch dimension overflow"))
+    }
+
+    pub fn merge_area(&self) -> Result<usize, BackendError> {
+        self.spatial_merge_size
+            .checked_mul(self.spatial_merge_size)
+            .ok_or_else(|| start("vision merge area overflow"))
+    }
+
+    pub fn merged_tokens(&self, grid_thw: [usize; 3]) -> Result<usize, BackendError> {
+        let patches = grid_thw.iter().try_fold(1usize, |count, dim| {
+            count
+                .checked_mul(*dim)
+                .ok_or_else(|| start("image patch count overflow"))
+        })?;
+        let area = self.merge_area()?;
+        if grid_thw.contains(&0)
+            || area == 0
+            || !grid_thw[1].is_multiple_of(self.spatial_merge_size)
+            || !grid_thw[2].is_multiple_of(self.spatial_merge_size)
+            || !patches.is_multiple_of(area)
+        {
+            return Err(start(format!(
+                "invalid Qwen3-VL image grid {grid_thw:?} for merge {}",
+                self.spatial_merge_size
+            )));
+        }
+        Ok(patches / area)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct TextConfig {
+    pub hidden_size: usize,
+    pub num_attention_heads: usize,
+    pub num_key_value_heads: usize,
+    pub head_dim: usize,
+    pub intermediate_size: usize,
+    pub num_hidden_layers: usize,
+    pub vocab_size: usize,
+    pub rms_norm_eps: f64,
+    pub hidden_act: String,
+    pub max_position_embeddings: usize,
+    pub rope_theta: f64,
+    pub mrope_interleaved: bool,
+    pub mrope_section: [usize; 3],
+    pub dtype: Dtype,
+    pub model_type: String,
+}
+
+impl TextConfig {
+    pub fn q_width(&self) -> Result<usize, BackendError> {
+        checked_product(self.num_attention_heads, self.head_dim, "query width")
+    }
+
+    pub fn kv_width(&self) -> Result<usize, BackendError> {
+        checked_product(self.num_key_value_heads, self.head_dim, "key/value width")
+    }
+
+    pub fn text_dim(&self) -> usize {
+        self.head_dim
+    }
+
+    pub fn mrope_section_sum(&self) -> Result<usize, BackendError> {
+        self.mrope_section.iter().try_fold(0usize, |sum, value| {
+            sum.checked_add(*value)
+                .ok_or_else(|| start("mRoPE section sum overflow"))
+        })
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Qwen3VlConfig {
+    pub raw: Value,
+    pub architectures: Vec<String>,
+    pub model_type: String,
+    pub alias: QwenVlAlias,
+    pub readout: ReadoutConfig,
+    pub tie_word_embeddings: bool,
+    pub text: TextConfig,
+    pub vision: VisionConfig,
+    pub image_token_id: Option<i64>,
+    pub video_token_id: Option<i64>,
+    pub vision_start_token_id: Option<i64>,
+    pub vision_end_token_id: Option<i64>,
+}
+
+fn object<'a>(value: &'a Value, name: &str) -> Result<&'a Map<String, Value>, BackendError> {
+    value
+        .get(name)
+        .and_then(Value::as_object)
+        .ok_or_else(|| start(format!("missing object {name}")))
+}
+
+fn req_usize(object: &Map<String, Value>, name: &str) -> Result<usize, BackendError> {
+    object
+        .get(name)
+        .and_then(Value::as_u64)
+        .and_then(|value| usize::try_from(value).ok())
+        .ok_or_else(|| start(format!("missing or invalid positive integer {name}")))
+}
+
+fn opt_usize(
+    object: &Map<String, Value>,
+    name: &str,
+    fallback: usize,
+) -> Result<usize, BackendError> {
+    match object.get(name) {
+        None | Some(Value::Null) => Ok(fallback),
+        Some(value) => value
+            .as_u64()
+            .and_then(|value| usize::try_from(value).ok())
+            .ok_or_else(|| start(format!("invalid integer {name}"))),
+    }
+}
+
+fn opt_f64(object: &Map<String, Value>, name: &str, fallback: f64) -> Result<f64, BackendError> {
+    match object.get(name) {
+        None | Some(Value::Null) => Ok(fallback),
+        Some(value) => value
+            .as_f64()
+            .ok_or_else(|| start(format!("invalid real {name}"))),
+    }
+}
+
+fn opt_bool(object: &Map<String, Value>, name: &str, fallback: bool) -> Result<bool, BackendError> {
+    match object.get(name) {
+        None | Some(Value::Null) => Ok(fallback),
+        Some(value) => value
+            .as_bool()
+            .ok_or_else(|| start(format!("invalid boolean {name}"))),
+    }
+}
+
+fn opt_string(
+    object: &Map<String, Value>,
+    name: &str,
+    fallback: &str,
+) -> Result<String, BackendError> {
+    match object.get(name) {
+        None | Some(Value::Null) => Ok(fallback.to_owned()),
+        Some(value) => value
+            .as_str()
+            .map(str::to_owned)
+            .ok_or_else(|| start(format!("invalid string {name}"))),
+    }
+}
+
+fn checked_product(left: usize, right: usize, name: &str) -> Result<usize, BackendError> {
+    left.checked_mul(right)
+        .ok_or_else(|| start(format!("{name} overflow")))
+}
+
+fn parse_dtype(
+    object: &Map<String, Value>,
+    fallback: Option<Dtype>,
+) -> Result<Dtype, BackendError> {
+    match object.get("dtype").or_else(|| object.get("torch_dtype")) {
+        Some(value) => Dtype::parse(
+            value
+                .as_str()
+                .ok_or_else(|| start("dtype must be a string"))?,
+        ),
+        None => fallback.ok_or_else(|| start("missing dtype")),
+    }
+}
+
+fn parse_vision(value: &Value, effective: Dtype) -> Result<VisionConfig, BackendError> {
+    let object = object(value, "vision_config")?;
+    let indexes = match object.get("deepstack_visual_indexes") {
+        None | Some(Value::Null) => Vec::new(),
+        Some(Value::Array(values)) => values
+            .iter()
+            .map(|entry| {
+                entry
+                    .as_u64()
+                    .and_then(|value| usize::try_from(value).ok())
+                    .ok_or_else(|| start("invalid deepstack_visual_indexes entry"))
+            })
+            .collect::<Result<Vec<_>, _>>()?,
+        Some(_) => return Err(start("deepstack_visual_indexes must be an array")),
+    };
+    Ok(VisionConfig {
+        hidden_size: req_usize(object, "hidden_size")?,
+        num_heads: req_usize(object, "num_heads")?,
+        spatial_merge_size: opt_usize(object, "spatial_merge_size", 2)?,
+        depth: req_usize(object, "depth")?,
+        intermediate_size: req_usize(object, "intermediate_size")?,
+        patch_size: req_usize(object, "patch_size")?,
+        temporal_patch_size: req_usize(object, "temporal_patch_size")?,
+        in_channels: opt_usize(object, "in_channels", 3)?,
+        num_position_embeddings: req_usize(object, "num_position_embeddings")?,
+        out_hidden_size: req_usize(object, "out_hidden_size")?,
+        hidden_act: opt_string(object, "hidden_act", DEFAULT_VISION_ACT)?,
+        deepstack_visual_indexes: indexes,
+        dtype: effective,
+    })
+}
+
+fn parse_text(value: &Value, effective: Dtype) -> Result<TextConfig, BackendError> {
+    let object = object(value, "text_config")?;
+    let hidden_size = req_usize(object, "hidden_size")?;
+    let num_attention_heads = req_usize(object, "num_attention_heads")?;
+    let head_dim = opt_usize(object, "head_dim", hidden_size / num_attention_heads.max(1))?;
+    // Native normalizes Nemotron ColEmbed's `rope_parameters` into
+    // `text_config.rope_scaling` before constructing the Qwen3-VL adapter.
+    // Both spellings are accepted here and the original JSON is untouched.
+    let rope = object
+        .get("rope_scaling")
+        .or_else(|| object.get("rope_parameters"))
+        .and_then(Value::as_object);
+    let mrope_interleaved = match rope.and_then(|rope| rope.get("mrope_interleaved")) {
+        Some(value) => value
+            .as_bool()
+            .ok_or_else(|| start("invalid mrope_interleaved"))?,
+        None => false,
+    };
+    let mrope_section = match rope.and_then(|rope| rope.get("mrope_section")) {
+        Some(Value::Array(values)) if values.len() == 3 => {
+            let parse = |entry: &Value| {
+                entry
+                    .as_u64()
+                    .and_then(|value| usize::try_from(value).ok())
+                    .ok_or_else(|| start("invalid mrope_section entry"))
+            };
+            [parse(&values[0])?, parse(&values[1])?, parse(&values[2])?]
+        }
+        Some(_) => return Err(start("mrope_section must have exactly three entries")),
+        None => [0, 0, 0],
+    };
+    Ok(TextConfig {
+        hidden_size,
+        num_attention_heads,
+        num_key_value_heads: opt_usize(object, "num_key_value_heads", num_attention_heads)?,
+        head_dim,
+        intermediate_size: req_usize(object, "intermediate_size")?,
+        num_hidden_layers: req_usize(object, "num_hidden_layers")?,
+        vocab_size: req_usize(object, "vocab_size")?,
+        rms_norm_eps: opt_f64(object, "rms_norm_eps", DEFAULT_RMS_NORM_EPS)?,
+        hidden_act: opt_string(object, "hidden_act", DEFAULT_TEXT_ACT)?,
+        max_position_embeddings: opt_usize(
+            object,
+            "max_position_embeddings",
+            DEFAULT_MAX_POSITION_EMBEDDINGS,
+        )?,
+        rope_theta: if object.get("rope_theta").is_some() {
+            opt_f64(object, "rope_theta", DEFAULT_ROPE_THETA)?
+        } else {
+            rope.and_then(|rope| rope.get("rope_theta"))
+                .and_then(Value::as_f64)
+                .unwrap_or(DEFAULT_ROPE_THETA)
+        },
+        mrope_interleaved,
+        mrope_section,
+        dtype: effective,
+        model_type: opt_string(object, "model_type", "qwen3_vl_text")?,
+    })
+}
+
+fn opt_id(object: &Map<String, Value>, name: &str) -> Option<i64> {
+    object.get(name).and_then(Value::as_i64)
+}
+
+/// Detect a Qwen3-VL-family checkpoint without building the full config.
+/// Requires a real `vision_config`; text-only configs are not routed here.
+pub fn detect_alias(root: &Path) -> Result<Option<QwenVlAlias>, BackendError> {
+    let raw: Value = read_json(&root.join("config.json"))?;
+    let Some(object) = raw.as_object() else {
+        return Ok(None);
+    };
+    if !object.get("vision_config").is_some_and(Value::is_object) {
+        return Ok(None);
+    }
+    Ok(object
+        .get("model_type")
+        .and_then(Value::as_str)
+        .and_then(QwenVlAlias::from_model_type))
+}
+
+impl Qwen3VlConfig {
+    pub fn from_path(root: &Path) -> Result<Self, BackendError> {
+        let raw: Value = read_json(&root.join("config.json"))?;
+        Self::from_value(raw)
+    }
+
+    pub fn from_json(bytes: &[u8]) -> Result<Self, BackendError> {
+        let raw: Value = serde_json::from_slice(bytes).map_err(start)?;
+        Self::from_value(raw)
+    }
+
+    pub fn from_value(raw: Value) -> Result<Self, BackendError> {
+        let object = raw
+            .as_object()
+            .ok_or_else(|| start("config.json is not an object"))?;
+        let architectures = match object.get("architectures") {
+            Some(Value::Array(values)) => values
+                .iter()
+                .map(|value| {
+                    value
+                        .as_str()
+                        .map(str::to_owned)
+                        .ok_or_else(|| start("invalid architectures entry"))
+                })
+                .collect::<Result<Vec<_>, _>>()?,
+            Some(_) => return Err(start("architectures must be an array")),
+            None => Vec::new(),
+        };
+        let model_type = opt_string(object, "model_type", "")?;
+        let alias = QwenVlAlias::from_model_type(&model_type).ok_or_else(|| {
+            start(format!(
+                "expected model_type qwen3_vl/colqwen3/qwen3_vl_nemotron_embed, got {model_type}"
+            ))
+        })?;
+        // The runtime/checkpoint storage dtype is the top-level dtype. A
+        // ColQwen3 config can declare `text_config.dtype=float32` while its
+        // safetensors are BF16 and the model runs BF16; Native converts weights
+        // to the selected runtime dtype, so sub-config dtype is not the adapter
+        // storage contract. Keep the original JSON in `raw`.
+        let top_dtype = match parse_dtype(object, None) {
+            Ok(dtype) => dtype,
+            Err(top_error) => {
+                let text_dtype = raw
+                    .get("text_config")
+                    .and_then(Value::as_object)
+                    .ok_or_else(|| start(top_error.to_string()))
+                    .and_then(|text| parse_dtype(text, None))?;
+                text_dtype
+            }
+        };
+        let mut readout = ReadoutConfig::from_model(alias, &architectures);
+        if readout.multi_vector {
+            readout.norm_eps = match top_dtype {
+                Dtype::Bf16 => 1.0 / 128.0,
+                Dtype::F16 => 1.0 / 1024.0,
+                Dtype::F32 => f32::EPSILON as f64,
+            };
+        }
+        let config = Self {
+            readout,
+            architectures,
+            model_type,
+            alias,
+            tie_word_embeddings: opt_bool(object, "tie_word_embeddings", false)?,
+            text: parse_text(&raw, top_dtype)?,
+            vision: parse_vision(&raw, top_dtype)?,
+            image_token_id: opt_id(object, "image_token_id"),
+            video_token_id: opt_id(object, "video_token_id"),
+            vision_start_token_id: opt_id(object, "vision_start_token_id"),
+            vision_end_token_id: opt_id(object, "vision_end_token_id"),
+            raw,
+        };
+        config.validate()?;
+        Ok(config)
+    }
+
+    pub fn plain_text_dim(&self) -> usize {
+        self.text.text_dim()
+    }
+
+    pub fn is_tower_only_compatible(&self) -> bool {
+        QwenVlAlias::from_model_type(&self.model_type).is_some()
+    }
+
+    pub fn validate(&self) -> Result<(), BackendError> {
+        QwenVlAlias::from_model_type(&self.model_type).ok_or_else(|| {
+            start(format!(
+                "expected model_type qwen3_vl/colqwen3/qwen3_vl_nemotron_embed, got {}",
+                self.model_type
+            ))
+        })?;
+        let vision = &self.vision;
+        if vision.hidden_size == 0
+            || vision.num_heads == 0
+            || vision.depth == 0
+            || vision.spatial_merge_size == 0
+            || vision.patch_size == 0
+            || vision.temporal_patch_size != 2
+            || vision.in_channels != 3
+        {
+            return Err(start("invalid Qwen3-VL vision geometry"));
+        }
+        if !vision.hidden_size.is_multiple_of(vision.num_heads)
+            || !vision.head_dim().is_multiple_of(4)
+        {
+            return Err(start(
+                "vision hidden_size must divide by num_heads and head_dim must be divisible by 4",
+            ));
+        }
+        if vision.num_position_embeddings == 0 || vision.out_hidden_size != self.text.hidden_size {
+            return Err(start(
+                "vision num_position_embeddings/out_hidden_size is inconsistent with text",
+            ));
+        }
+        let side = (vision.num_position_embeddings as f64).sqrt().round() as usize;
+        if side == 0 || side.saturating_mul(side) != vision.num_position_embeddings {
+            return Err(start(
+                "vision num_position_embeddings must be a perfect square (pos_embed table)",
+            ));
+        }
+        for index in &vision.deepstack_visual_indexes {
+            if *index >= vision.depth {
+                return Err(start(format!(
+                    "deepstack vision index {index} is outside depth {}",
+                    vision.depth
+                )));
+            }
+        }
+        let mut seen = std::collections::BTreeSet::new();
+        for index in &vision.deepstack_visual_indexes {
+            if !seen.insert(*index) {
+                return Err(start(format!("duplicate deepstack vision index {index}")));
+            }
+        }
+        let text = &self.text;
+        if text.hidden_size == 0
+            || text.num_attention_heads == 0
+            || text.num_key_value_heads == 0
+            || text.head_dim == 0
+            || text.intermediate_size == 0
+            || text.num_hidden_layers == 0
+            || text.vocab_size == 0
+        {
+            return Err(start("invalid Qwen3-VL text geometry"));
+        }
+        if text.num_key_value_heads > text.num_attention_heads
+            || !text
+                .num_attention_heads
+                .is_multiple_of(text.num_key_value_heads)
+        {
+            return Err(start("text num_key_value_heads is invalid"));
+        }
+        if !(text.rms_norm_eps.is_finite() && text.rms_norm_eps > 0.0) {
+            return Err(start("text rms_norm_eps must be positive and finite"));
+        }
+        if !(text.rope_theta.is_finite() && text.rope_theta > 0.0) {
+            return Err(start("text rope_theta must be positive and finite"));
+        }
+        if !text.mrope_interleaved {
+            return Err(start(
+                "Qwen3-VL requires interleaved text mRoPE (mrope_interleaved=true)",
+            ));
+        }
+        if text.mrope_section_sum()? != text.text_dim() / 2 {
+            return Err(start(format!(
+                "mRoPE sections {:?} do not sum to head_dim/2 ({})",
+                text.mrope_section,
+                text.text_dim() / 2
+            )));
+        }
+        if self.readout.multi_vector
+            && self.readout.kind == ReadoutKind::Embedding
+            && self.architectures.iter().all(|value| value != "HF_ColBERT")
+        {
+            return Err(start(
+                "multi-vector Qwen3-VL requires HF_ColBERT, colqwen3 or qwen3_vl_nemotron_embed",
+            ));
+        }
+        if self
+            .readout
+            .token_projection_width
+            .is_some_and(|width| width == 0)
+        {
+            return Err(start("multi-vector token projection width is zero"));
+        }
+        if self.vision.dtype != self.text.dtype {
+            return Err(start(
+                "vision and text checkpoint dtypes must match for this adapter",
+            ));
+        }
+        if self.vision.dtype == Dtype::F32 {
+            return Err(start(
+                "F32 Qwen3-VL weights are outside the BF16/F16 adapter contract",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Native defaults to the non-exact BF16 path for published Qwen3-VL
+    /// checkpoints. The exact FP16 temporal split additionally requires a
+    /// `qwen3_5*` model type; this adapter owns `qwen3_vl`, so it always reports
+    /// the default path unless a caller explicitly selects multi-vector mode.
+    pub fn vision_profile(&self, multi_vector: bool) -> crate::qwen3_vl_contract::VisionProfile {
+        if multi_vector || self.readout.multi_vector {
+            crate::qwen3_vl_contract::VisionProfile::MultiVector
+        } else {
+            crate::qwen3_vl_contract::VisionProfile::Default16
+        }
+    }
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_contract.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_contract.rs
new file mode 100644
index 0000000..fbf988e
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_contract.rs
@@ -0,0 +1,202 @@
+// Explicit numerical and ordering contract of the actual Native Qwen3-VL
+// implementation (`qwen3_vl_models.cpp`, `helpers/dense_mlp.cpp`,
+// `decoder_models.cpp`).
+//
+// The contract is named instead of inferred so an Oxide executor cannot
+// accidentally call the tower-only path "full forward", or describe the
+// multi-vector retrieval profile as the default BF16 profile.
+
+use crate::qwen3_vl_config::{Dtype, Qwen3VlConfig, DEFAULT_VISION_ACT};
+use infinity_v3_backend_core::BackendError;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum VisionProfile {
+    /// Published Qwen3-VL BF16/F16 non-multi-vector path.
+    Default16,
+    /// ColQwen/retrieval 5-D Conv3D path with equal-length frame grouping and
+    /// exact-erf merger GELU.
+    MultiVector,
+    /// Candle FP16 temporal split, reachable only for `qwen3_5*` checkpoints.
+    ExactFp16,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum VisionActivation {
+    GeluPytorchTanh,
+    GeluExact,
+    Silu,
+}
+
+impl VisionActivation {
+    pub const fn label(self) -> &'static str {
+        match self {
+            Self::GeluPytorchTanh => "tanh-approx GELU (ATen gelu_pytorch_tanh)",
+            Self::GeluExact => "exact-erf GELU",
+            Self::Silu => "SiLU",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CornerSumOrder {
+    /// `corners.sum(0)` in table dtype (default BF16 path).
+    DefaultSum,
+    /// `(c00 + c10) + (c01 + c11)` (exact FP16 path).
+    ExactPair,
+    /// `((c00 + c01) + c10) + c11` (multi-vector path).
+    MultiVectorLeft,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum MergeNorm {
+    /// Final merger normalizes ungrouped patch rows before `view(-1, H*merge^2)`.
+    PreGroup,
+    /// Deepstack merger groups first and normalizes width `H*merge^2`.
+    PostGroup,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum TextRopeSource {
+    /// Caller supplies `[3, tokens]` media positions; all three axes are used.
+    MultimodalAxes,
+    /// Missing media positions: Native expands a single position row to all axes.
+    PlainPositions,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DeepstackInjection {
+    /// `index_add` into the text residual after the end of text layer `i`.
+    AdditiveAfterTextLayer,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct VisionContract {
+    pub profile: VisionProfile,
+    pub activation: VisionActivation,
+    pub merger_activation: VisionActivation,
+    pub corner_sum: CornerSumOrder,
+    pub final_merger: MergeNorm,
+    pub deepstack_merger: MergeNorm,
+    pub layer_norm_epsilon: f32,
+    pub patch_projection: &'static str,
+    pub attention_isolation: &'static str,
+    pub rotary_layout: &'static str,
+    pub deepstack_capture: &'static str,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TextContract {
+    pub rope_source: TextRopeSource,
+    pub rope_application: &'static str,
+    pub marker_injection: &'static str,
+    pub deepstack_injection: DeepstackInjection,
+    pub prefix_empty_images: &'static str,
+    pub causal: bool,
+    pub mrope_axes_formula: &'static str,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Qwen3VlContract {
+    pub vision: VisionContract,
+    pub text: TextContract,
+    pub bf16_stage_order: &'static [&'static str],
+}
+
+pub const VISION_STAGES: &[&str] = &[
+    "pixels F32 host -> model dtype",
+    "patch_embed.proj (5-D flattened linear / temporal split)",
+    "pos_embed four-corner interpolation (table dtype)",
+    "vision 2-D rotary phases (F32)",
+    "blocks.N.norm1 (LayerNorm eps 1e-6)",
+    "blocks.N.attn.qkv",
+    "blocks.N q/k rotate: F32 -> model dtype",
+    "blocks.N frame-isolated packed attention (non-causal)",
+    "blocks.N.attn.proj",
+    "blocks.N residual",
+    "blocks.N.norm2",
+    "blocks.N.mlp.linear_fc1 -> GELU -> linear_fc2",
+    "blocks.N residual",
+    "deepstack_merger_list.i capture (post-group norm) when configured",
+    "merger (pre-group norm) final merged rows",
+];
+
+pub const TEXT_STAGES: &[&str] = &[
+    "embed_tokens",
+    "index_copy visual rows into marker spans",
+    "per-layer input_layernorm",
+    "q/k/v projections",
+    "Qwen3 per-head q_norm/k_norm",
+    "interleaved mRoPE on q/k (model dtype)",
+    "packed causal GQA attention",
+    "o_proj + residual",
+    "post_attention_layernorm",
+    "SwiGLU gate/up/down + residual",
+    "deepstack index_add after matching text layer",
+    "final norm",
+];
+
+fn vision_activation(profile: VisionProfile, act: &str) -> VisionActivation {
+    if profile == VisionProfile::ExactFp16 && act != "silu" && act != "gelu" {
+        return VisionActivation::GeluExact;
+    }
+    match act {
+        "silu" => VisionActivation::Silu,
+        "gelu" => VisionActivation::GeluExact,
+        _ => VisionActivation::GeluPytorchTanh,
+    }
+}
+
+fn merger_activation(profile: VisionProfile) -> VisionActivation {
+    match profile {
+        VisionProfile::ExactFp16 => VisionActivation::GeluExact,
+        VisionProfile::MultiVector => VisionActivation::GeluExact,
+        VisionProfile::Default16 => VisionActivation::GeluPytorchTanh,
+    }
+}
+
+pub fn select(config: &Qwen3VlConfig, multi_vector: bool) -> Result<Qwen3VlContract, BackendError> {
+    if config.vision.dtype != Dtype::Bf16 && config.vision.dtype != Dtype::F16 {
+        return Err(BackendError::Start(
+            "Qwen3-VL contract requires F16 or BF16 model dtype".to_owned(),
+        ));
+    }
+    let profile = config.vision_profile(multi_vector || config.readout.multi_vector);
+    let act = if config.vision.hidden_act.is_empty() {
+        DEFAULT_VISION_ACT
+    } else {
+        &config.vision.hidden_act
+    };
+    Ok(Qwen3VlContract {
+        vision: VisionContract {
+            profile,
+            activation: vision_activation(profile, act),
+            merger_activation: merger_activation(profile),
+            corner_sum: match profile {
+                VisionProfile::Default16 => CornerSumOrder::DefaultSum,
+                VisionProfile::ExactFp16 => CornerSumOrder::ExactPair,
+                VisionProfile::MultiVector => CornerSumOrder::MultiVectorLeft,
+            },
+            final_merger: MergeNorm::PreGroup,
+            deepstack_merger: MergeNorm::PostGroup,
+            layer_norm_epsilon: 1e-6,
+            patch_projection: match profile {
+                VisionProfile::Default16 => "single BF16 GEMM [rows, patch_dim] x [H, patch_dim]^T + bias",
+                VisionProfile::MultiVector => "Conv3D stride=kernel [C,T,16,16] + bias",
+                VisionProfile::ExactFp16 => "two temporal-2 GEMMs, rounded sum, then separate bias",
+            },
+            attention_isolation: "per temporal frame: cu_seqlens advances height*width per frame; non-causal; max_frame=max(height*width)",
+            rotary_layout: "split-half 2-D: angles=[row*vision_freq, col*vision_freq]; q/k promoted to F32 then cast to model dtype",
+            deepstack_capture: "capture after full block residual in increasing vision layer order",
+        },
+        text: TextContract {
+            rope_source: TextRopeSource::MultimodalAxes,
+            rope_application: "interleaved mRoPE on q/k in model dtype; v untouched",
+            marker_injection: "replace embedding rows at [token_start, token_start+token_count); not additive",
+            deepstack_injection: DeepstackInjection::AdditiveAfterTextLayer,
+            prefix_empty_images: "no tower work; empty [0, hidden] visual/deepstack placeholders while text suffix keeps mRoPE",
+            causal: true,
+            mrope_axes_formula: "axis[j] = 1 if j%3==1 && j<s1*3; 2 if j%3==2 && j<s2*3; else 0",
+        },
+        bf16_stage_order: VISION_STAGES,
+    })
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_device.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_device.rs
new file mode 100644
index 0000000..24e108f
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_device.rs
@@ -0,0 +1,1996 @@
+//! Concrete Qwen3-VL device executor.
+//!
+//! This module performs real cold BF16 weight upload, owns reusable device
+//! workspaces, prepares cuBLASLt plans and FA4 attention, and executes the
+//! vision tower plus the shared dense decoder loop. It does not use a test sink
+//! or a no-op fallback: the only execution path launches the real primitives.
+
+use crate::cublas::Blas;
+use crate::decoder::{DecoderModel, DecoderMultimodal, DecoderWork};
+use crate::decoder_model::{DecoderConfig, DecoderWeights};
+use crate::fa4::{AttentionBatch, AttentionSpec, DType, Fa4, Scale, Window};
+use crate::lt::{LtPlan, LtProvider};
+use crate::model::Checkpoint;
+use crate::qwen3_vl_config::{Dtype, Qwen3VlConfig};
+use crate::qwen3_vl_inventory::{expected_tensors, InventoryScope};
+use crate::qwen3_vl_text::{image_position_ids, mrope_axis_map, mrope_frequencies, mrope_phases};
+use crate::qwen3_vl_vision::{deepstack_capture_order, ImageGrid};
+use crate::staging::HostIoLease;
+use crate::tensor::Bf16;
+use crate::upload::WeightUploader;
+use crate::WorkKey;
+use cuda_core::{
+    launch_kernel, Context, DeviceBuffer, DeviceCopy, Function, PinnedHostBuffer, Stream,
+};
+use infinity_v3_backend_core::{BackendError, Batch, Pool};
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::ffi::c_void;
+use std::mem::ManuallyDrop;
+use std::path::Path;
+use std::sync::atomic::Ordering;
+use std::sync::Arc;
+
+fn start(error: impl std::fmt::Display) -> BackendError {
+    BackendError::Start(format!("Oxide Qwen3-VL device: {error}"))
+}
+
+fn infer(error: impl std::fmt::Display) -> BackendError {
+    BackendError::Inference(format!("Oxide Qwen3-VL device: {error}"))
+}
+
+fn product(left: usize, right: usize) -> Result<usize, BackendError> {
+    left.checked_mul(right)
+        .ok_or_else(|| infer("dimension overflow"))
+}
+
+fn u32_size(value: usize) -> Result<u32, BackendError> {
+    u32::try_from(value).map_err(|_| infer("dimension exceeds u32"))
+}
+
+fn arg<T>(value: &mut T) -> *mut c_void {
+    value as *mut T as *mut c_void
+}
+
+fn blocks(elements: usize) -> Result<(u32, u32, u32), BackendError> {
+    let blocks = elements
+        .checked_add(255)
+        .ok_or_else(|| infer("launch grid overflow"))?
+        / 256;
+    Ok((u32_size(blocks.max(1))?, 1, 1))
+}
+
+fn launch(
+    function: &Function,
+    stream: &Stream,
+    grid: (u32, u32, u32),
+    shared: u32,
+    args: &mut [*mut c_void],
+) -> Result<(), BackendError> {
+    // SAFETY: callers retain every buffer through stream completion and pass
+    // exactly the kernel ABI's scalar/pointer arguments.
+    unsafe {
+        launch_kernel(
+            function.cu_function(),
+            grid,
+            (256, 1, 1),
+            shared,
+            stream.cu_stream(),
+            args,
+        )
+    }
+    .map_err(infer)
+}
+
+fn launch_threads(
+    function: &Function,
+    stream: &Stream,
+    grid: (u32, u32, u32),
+    threads: u32,
+    shared: u32,
+    args: &mut [*mut c_void],
+) -> Result<(), BackendError> {
+    unsafe {
+        launch_kernel(
+            function.cu_function(),
+            grid,
+            (threads, 1, 1),
+            shared,
+            stream.cu_stream(),
+            args,
+        )
+    }
+    .map_err(infer)
+}
+
+fn zero_alloc<T: DeviceCopy>(
+    stream: &Arc<Stream>,
+    len: usize,
+) -> Result<DeviceBuffer<T>, BackendError> {
+    // SAFETY: the complete buffer is zeroed on the ordered stream before use.
+    let buffer = unsafe { DeviceBuffer::<T>::uninitialized_async(stream, len) }.map_err(infer)?;
+    unsafe {
+        cuda_core::memory::memset_d8_async(
+            buffer.cu_deviceptr(),
+            0,
+            buffer.num_bytes(),
+            stream.cu_stream(),
+        )
+    }
+    .map_err(infer)?;
+    Ok(buffer)
+}
+
+/// Copy the active prefix of a host slice into a larger reusable device buffer.
+/// `src` must outlive the ordered copy. This does not assert exact capacity.
+unsafe fn copy_prefix<T>(
+    destination: &DeviceBuffer<T>,
+    stream: &Stream,
+    source: &[T],
+) -> Result<(), BackendError> {
+    if source.is_empty() {
+        return Ok(());
+    }
+    let bytes = source
+        .len()
+        .checked_mul(std::mem::size_of::<T>())
+        .ok_or_else(|| infer("host copy size overflow"))?;
+    // SAFETY: destination capacity is checked by the workspace and `source`
+    // outlives the ordered copy contract at every call site.
+    unsafe {
+        cuda_core::memory::memcpy_htod_async(
+            destination.cu_deviceptr(),
+            source.as_ptr(),
+            bytes,
+            stream.cu_stream(),
+        )
+    }
+    .map_err(infer)
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct VisionWorkKey {
+    patches: usize,
+    merged: usize,
+    frames: usize,
+    tokens: usize,
+    staged_pixels: usize,
+    staged_frames: usize,
+}
+
+/// Pinned host arena capacities are request totals, not worst-single-image
+/// maxima. Device pixels/frame_offsets stay max-sized and stream-ordered.
+fn pinned_staging_capacities(key: &VisionWorkKey) -> (usize, usize) {
+    (key.staged_pixels, key.staged_frames)
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct PinnedStagingPlan {
+    pub(crate) pixel_ranges: Vec<(usize, usize)>,
+    pub(crate) frame_ranges: Vec<(usize, usize)>,
+    pub(crate) total_pixels: usize,
+    pub(crate) total_frames: usize,
+}
+
+/// Compute disjoint immutable pinned source ranges for every image before any
+/// async H2D is enqueued.
+pub(crate) fn plan_pinned_staging(
+    images: &[VisionImage],
+) -> Result<PinnedStagingPlan, BackendError> {
+    let mut pixel_ranges = Vec::with_capacity(images.len());
+    let mut frame_ranges = Vec::with_capacity(images.len());
+    let mut total_pixels = 0usize;
+    let mut total_frames = 0usize;
+    for image in images {
+        let patch_rows = image.patch_rows()?;
+        let patch_dim = image
+            .pixels
+            .len()
+            .checked_div(patch_rows)
+            .filter(|dim| *dim > 0 && patch_rows.checked_mul(*dim) == Some(image.pixels.len()))
+            .ok_or_else(|| start(format!("{} has an invalid pixel payload", image.name)))?;
+        let pixels = patch_rows
+            .checked_mul(patch_dim)
+            .ok_or_else(|| start("pinned pixel range overflow"))?;
+        let frames = image.grid_thw[0]
+            .checked_add(1)
+            .ok_or_else(|| start("pinned frame count overflow"))?;
+        pixel_ranges.push((total_pixels, pixels));
+        frame_ranges.push((total_frames, frames));
+        total_pixels = total_pixels
+            .checked_add(pixels)
+            .ok_or_else(|| start("pinned pixel total overflow"))?;
+        total_frames = total_frames
+            .checked_add(frames)
+            .ok_or_else(|| start("pinned frame total overflow"))?;
+    }
+    Ok(PinnedStagingPlan {
+        pixel_ranges,
+        frame_ranges,
+        total_pixels,
+        total_frames,
+    })
+}
+
+struct VisionWork {
+    stream: Arc<Stream>,
+    key: VisionWorkKey,
+    bytes: usize,
+    pixels: ManuallyDrop<DeviceBuffer<f32>>,
+    pixels_bf16: ManuallyDrop<DeviceBuffer<Bf16>>,
+    states: ManuallyDrop<DeviceBuffer<Bf16>>,
+    norm: ManuallyDrop<DeviceBuffer<Bf16>>,
+    qkv: ManuallyDrop<DeviceBuffer<Bf16>>,
+    attention: ManuallyDrop<DeviceBuffer<Bf16>>,
+    branch: ManuallyDrop<DeviceBuffer<Bf16>>,
+    mlp: ManuallyDrop<DeviceBuffer<Bf16>>,
+    grouped_norm: ManuallyDrop<DeviceBuffer<Bf16>>,
+    merger_tmp: ManuallyDrop<DeviceBuffer<Bf16>>,
+    image_merged: ManuallyDrop<DeviceBuffer<Bf16>>,
+    image_deepstack: ManuallyDrop<Vec<DeviceBuffer<Bf16>>>,
+    merged: ManuallyDrop<DeviceBuffer<Bf16>>,
+    deepstack: ManuallyDrop<Vec<DeviceBuffer<Bf16>>>,
+    frame_offsets: ManuallyDrop<DeviceBuffer<u32>>,
+    visual_rows: ManuallyDrop<DeviceBuffer<u32>>,
+    rope_cos: ManuallyDrop<DeviceBuffer<f32>>,
+    rope_sin: ManuallyDrop<DeviceBuffer<f32>>,
+    rope_positions: ManuallyDrop<DeviceBuffer<u32>>,
+    host_pixels: ManuallyDrop<PinnedHostBuffer<f32>>,
+    host_frames: ManuallyDrop<PinnedHostBuffer<u32>>,
+    host_rows: ManuallyDrop<PinnedHostBuffer<u32>>,
+    host_cos: ManuallyDrop<PinnedHostBuffer<f32>>,
+    host_sin: ManuallyDrop<PinnedHostBuffer<f32>>,
+    host_positions: ManuallyDrop<PinnedHostBuffer<u32>>,
+}
+
+impl VisionWork {
+    fn new(
+        stream: Arc<Stream>,
+        config: &Qwen3VlConfig,
+        key: VisionWorkKey,
+        deepstack: usize,
+    ) -> Result<Self, BackendError> {
+        let hidden = config.vision.hidden_size;
+        let patch_dim = config.vision.patch_dim()?;
+        let grouped = product(hidden, config.vision.merge_area()?)?;
+        let out_hidden = config.vision.out_hidden_size;
+        let intermediate = config.vision.intermediate_size;
+        let half = config.text.text_dim() / 2;
+        let mut bytes = 0usize;
+        let alloc_bf16 =
+            |bytes: &mut usize, len: usize| -> Result<DeviceBuffer<Bf16>, BackendError> {
+                *bytes = bytes
+                    .checked_add(product(len, 2)?)
+                    .ok_or_else(|| infer("workspace byte overflow"))?;
+                zero_alloc::<Bf16>(&stream, len)
+            };
+        let pixels_len = product(key.patches, patch_dim)?;
+        let hidden_len = product(key.patches, hidden)?;
+        let qkv_len = product(key.patches, product(hidden, 3)?)?;
+        let mlp_len = product(key.patches, intermediate)?;
+        let grouped_len = product(key.merged, grouped)?;
+        let out_len = product(key.merged, out_hidden)?;
+        let pixels = {
+            bytes = bytes
+                .checked_add(product(pixels_len, 4)?)
+                .ok_or_else(|| infer("pixel byte overflow"))?;
+            zero_alloc::<f32>(&stream, pixels_len)?
+        };
+        let pixels_bf16 = alloc_bf16(&mut bytes, pixels_len)?;
+        let states = alloc_bf16(&mut bytes, hidden_len)?;
+        let norm = alloc_bf16(&mut bytes, hidden_len)?;
+        let qkv = alloc_bf16(&mut bytes, qkv_len)?;
+        let attention = alloc_bf16(&mut bytes, hidden_len)?;
+        let branch = alloc_bf16(&mut bytes, hidden_len)?;
+        let mlp = alloc_bf16(&mut bytes, mlp_len)?;
+        let grouped_norm = alloc_bf16(&mut bytes, grouped_len)?;
+        let merger_tmp = alloc_bf16(&mut bytes, grouped_len)?;
+        let image_merged = alloc_bf16(&mut bytes, out_len)?;
+        let mut image_deepstack = Vec::with_capacity(deepstack);
+        for _ in 0..deepstack {
+            image_deepstack.push(alloc_bf16(&mut bytes, out_len)?);
+        }
+        let total_out = product(key.merged, out_hidden)?;
+        let merged = alloc_bf16(&mut bytes, total_out)?;
+        let mut deepstack_total = Vec::with_capacity(deepstack);
+        for _ in 0..deepstack {
+            deepstack_total.push(alloc_bf16(&mut bytes, total_out)?);
+        }
+        let frame_offsets = {
+            bytes = bytes
+                .checked_add(product(key.frames + 1, 4)?)
+                .ok_or_else(|| infer("frame byte overflow"))?;
+            zero_alloc::<u32>(&stream, key.frames + 1)?
+        };
+        let visual_rows = {
+            bytes = bytes
+                .checked_add(product(key.merged, 4)?)
+                .ok_or_else(|| infer("row byte overflow"))?;
+            zero_alloc::<u32>(&stream, key.merged)?
+        };
+        let rope_len = product(key.tokens, half)?;
+        let rope_cos = {
+            bytes = bytes
+                .checked_add(product(rope_len, 4)?)
+                .ok_or_else(|| infer("mrope byte overflow"))?;
+            zero_alloc::<f32>(&stream, rope_len)?
+        };
+        let rope_sin = {
+            bytes = bytes
+                .checked_add(product(rope_len, 4)?)
+                .ok_or_else(|| infer("mrope byte overflow"))?;
+            zero_alloc::<f32>(&stream, rope_len)?
+        };
+        let rope_positions = {
+            bytes = bytes
+                .checked_add(product(key.tokens, 4)?)
+                .ok_or_else(|| infer("position byte overflow"))?;
+            zero_alloc::<u32>(&stream, key.tokens)?
+        };
+        let pinned = |bytes: &mut usize, len: usize, width: usize| -> Result<usize, BackendError> {
+            *bytes = bytes
+                .checked_add(product(len, width)?)
+                .ok_or_else(|| infer("pinned staging byte overflow"))?;
+            Ok(len)
+        };
+        let (staged_pixels, staged_frames) = pinned_staging_capacities(&key);
+        let host_pixels =
+            PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, staged_pixels, 4)?)
+                .map_err(infer)?;
+        let host_frames =
+            PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, staged_frames, 4)?)
+                .map_err(infer)?;
+        let host_rows =
+            PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, key.merged, 4)?)
+                .map_err(infer)?;
+        let host_cos = PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, rope_len, 4)?)
+            .map_err(infer)?;
+        let host_sin = PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, rope_len, 4)?)
+            .map_err(infer)?;
+        let host_positions =
+            PinnedHostBuffer::zeroed(stream.context(), pinned(&mut bytes, key.tokens, 4)?)
+                .map_err(infer)?;
+        crate::LIVE_ARENA_BYTES.fetch_add(bytes, Ordering::Relaxed);
+        crate::record_live_arena_bytes();
+        Ok(Self {
+            stream,
+            key,
+            bytes,
+            pixels: ManuallyDrop::new(pixels),
+            pixels_bf16: ManuallyDrop::new(pixels_bf16),
+            states: ManuallyDrop::new(states),
+            norm: ManuallyDrop::new(norm),
+            qkv: ManuallyDrop::new(qkv),
+            attention: ManuallyDrop::new(attention),
+            branch: ManuallyDrop::new(branch),
+            mlp: ManuallyDrop::new(mlp),
+            grouped_norm: ManuallyDrop::new(grouped_norm),
+            merger_tmp: ManuallyDrop::new(merger_tmp),
+            image_merged: ManuallyDrop::new(image_merged),
+            image_deepstack: ManuallyDrop::new(image_deepstack),
+            merged: ManuallyDrop::new(merged),
+            deepstack: ManuallyDrop::new(deepstack_total),
+            frame_offsets: ManuallyDrop::new(frame_offsets),
+            visual_rows: ManuallyDrop::new(visual_rows),
+            rope_cos: ManuallyDrop::new(rope_cos),
+            rope_sin: ManuallyDrop::new(rope_sin),
+            rope_positions: ManuallyDrop::new(rope_positions),
+            host_pixels: ManuallyDrop::new(host_pixels),
+            host_frames: ManuallyDrop::new(host_frames),
+            host_rows: ManuallyDrop::new(host_rows),
+            host_cos: ManuallyDrop::new(host_cos),
+            host_sin: ManuallyDrop::new(host_sin),
+            host_positions: ManuallyDrop::new(host_positions),
+        })
+    }
+
+    fn fits(&self, key: VisionWorkKey, deepstack: usize) -> bool {
+        // Exact geometry: decoder hooks use DeviceBuffer::len() as the active
+        // row/token count, so capacity-only reuse would expose stale rows.
+        self.key == key && self.deepstack.len() == deepstack
+    }
+}
+
+impl Drop for VisionWork {
+    fn drop(&mut self) {
+        if self.stream.synchronize().is_ok() {
+            unsafe {
+                ManuallyDrop::drop(&mut self.pixels);
+                ManuallyDrop::drop(&mut self.pixels_bf16);
+                ManuallyDrop::drop(&mut self.states);
+                ManuallyDrop::drop(&mut self.norm);
+                ManuallyDrop::drop(&mut self.qkv);
+                ManuallyDrop::drop(&mut self.attention);
+                ManuallyDrop::drop(&mut self.branch);
+                ManuallyDrop::drop(&mut self.mlp);
+                ManuallyDrop::drop(&mut self.grouped_norm);
+                ManuallyDrop::drop(&mut self.merger_tmp);
+                ManuallyDrop::drop(&mut self.image_merged);
+                ManuallyDrop::drop(&mut self.image_deepstack);
+                ManuallyDrop::drop(&mut self.merged);
+                ManuallyDrop::drop(&mut self.deepstack);
+                ManuallyDrop::drop(&mut self.frame_offsets);
+                ManuallyDrop::drop(&mut self.visual_rows);
+                ManuallyDrop::drop(&mut self.rope_cos);
+                ManuallyDrop::drop(&mut self.rope_sin);
+                ManuallyDrop::drop(&mut self.rope_positions);
+                ManuallyDrop::drop(&mut self.host_pixels);
+                ManuallyDrop::drop(&mut self.host_frames);
+                ManuallyDrop::drop(&mut self.host_rows);
+                ManuallyDrop::drop(&mut self.host_cos);
+                ManuallyDrop::drop(&mut self.host_sin);
+                ManuallyDrop::drop(&mut self.host_positions);
+            }
+            crate::LIVE_ARENA_BYTES.fetch_sub(self.bytes, Ordering::Relaxed);
+            crate::record_live_arena_bytes();
+        }
+    }
+}
+
+/// Retained external-mRoPE tables for a text-only request (no visual rows).
+/// `rows`/`visual` are one-element dummies so the decoder ABI can still carry
+/// a zero logical row count; the text suffix keeps its real phases.
+struct PositionWork {
+    stream: Arc<Stream>,
+    tokens: usize,
+    cos: DeviceBuffer<f32>,
+    sin: DeviceBuffer<f32>,
+    positions: DeviceBuffer<u32>,
+    rows: DeviceBuffer<u32>,
+    visual: DeviceBuffer<Bf16>,
+    host_cos: PinnedHostBuffer<f32>,
+    host_sin: PinnedHostBuffer<f32>,
+    host_positions: PinnedHostBuffer<u32>,
+}
+
+impl PositionWork {
+    fn new(stream: Arc<Stream>, tokens: usize, half: usize) -> Result<Self, BackendError> {
+        let count = product(tokens, half)?;
+        let cos = zero_alloc::<f32>(&stream, count)?;
+        let sin = zero_alloc::<f32>(&stream, count)?;
+        let positions = zero_alloc::<u32>(&stream, tokens)?;
+        let rows = zero_alloc::<u32>(&stream, 1)?;
+        let visual = zero_alloc::<Bf16>(&stream, 1)?;
+        let host_cos = PinnedHostBuffer::zeroed(stream.context(), count).map_err(infer)?;
+        let host_sin = PinnedHostBuffer::zeroed(stream.context(), count).map_err(infer)?;
+        let host_positions = PinnedHostBuffer::zeroed(stream.context(), tokens).map_err(infer)?;
+        Ok(Self {
+            stream,
+            tokens,
+            cos,
+            sin,
+            positions,
+            rows,
+            visual,
+            host_cos,
+            host_sin,
+            host_positions,
+        })
+    }
+
+    fn fits(&self, tokens: usize) -> bool {
+        tokens <= self.tokens
+    }
+
+    fn bytes(&self) -> usize {
+        self.cos.num_bytes()
+            + self.sin.num_bytes()
+            + self.positions.num_bytes()
+            + self.rows.num_bytes()
+            + self.visual.num_bytes()
+            + self.host_cos.num_bytes()
+            + self.host_sin.num_bytes()
+            + self.host_positions.num_bytes()
+    }
+}
