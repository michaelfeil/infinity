+
+impl GeometryTuple {
+    fn config_json(&self) -> serde_json::Value {
+        let mut text = json!({
+            "dtype": "bfloat16",
+            "hidden_size": self.text_hidden,
+            "num_attention_heads": self.text_heads,
+            "num_key_value_heads": self.text_kv,
+            "head_dim": self.text_head_dim,
+            "num_hidden_layers": self.text_layers,
+            "intermediate_size": self.text_intermediate.max(1),
+            "vocab_size": self.text_vocab,
+            "max_position_embeddings": 262144,
+            "rms_norm_eps": 1e-6,
+            "hidden_act": "silu",
+            "model_type": if self.dense_text { "qwen3_vl_text" } else { "qwen3_moe" },
+            "rope_scaling": {
+                "mrope_interleaved": true,
+                "mrope_section": self.mrope,
+                "rope_theta": self.text_theta,
+                "rope_type": "default",
+            },
+            "rope_theta": self.text_theta,
+        });
+        if !self.dense_text {
+            text["num_experts"] = 128.into();
+        }
+        json!({
+            "architectures": [match self.alias {
+                QwenVlAlias::Qwen3Vl => "Qwen3VLForConditionalGeneration",
+                QwenVlAlias::ColQwen3 => "ColQwen3",
+                QwenVlAlias::NemotronColEmbed => "Qwen3VLNemotronEmbedModel",
+            }],
+            "dtype": "bfloat16",
+            "model_type": self.alias.model_type(),
+            "image_token_id": 151655,
+            "video_token_id": 151656,
+            "vision_start_token_id": 151652,
+            "vision_end_token_id": 151653,
+            "text_config": text,
+            "vision_config": {
+                "dtype": "bfloat16",
+                "hidden_size": self.vision_hidden,
+                "num_heads": self.vision_heads,
+                "depth": self.vision_depth,
+                "intermediate_size": self.vision_intermediate,
+                "patch_size": 16,
+                "temporal_patch_size": 2,
+                "in_channels": 3,
+                "spatial_merge_size": 2,
+                "num_position_embeddings": self.vision_positions,
+                "out_hidden_size": self.vision_out,
+                "hidden_act": "gelu_pytorch_tanh",
+                "deepstack_visual_indexes": self.deepstack,
+                "model_type": "qwen3_vl",
+            },
+        })
+    }
+
+    pub(crate) fn config(&self) -> Result<Qwen3VlConfig, BackendError> {
+        Qwen3VlConfig::from_value(self.config_json())
+    }
+
+    pub(crate) fn classify(&self) -> Result<GeometrySupport, BackendError> {
+        let config = self.config()?;
+        let mut missing = Vec::new();
+        let text_causal = config.readout.kind != ReadoutKind::NemotronColEmbed;
+        let text_profile = AttentionSpec {
+            heads: self.text_heads,
+            kv_heads: self.text_kv,
+            head_dim: self.text_head_dim,
+            causal: text_causal,
+            window: Window::Global,
+            dtype: DType::Bf16,
+            scale: Scale::RsqrtHeadDim,
+        };
+        let vision_profile = AttentionSpec {
+            heads: self.vision_heads,
+            kv_heads: self.vision_heads,
+            head_dim: self.vision_hidden / self.vision_heads,
+            causal: false,
+            window: Window::Global,
+            dtype: DType::Bf16,
+            scale: Scale::RsqrtHeadDim,
+        };
+        let mut decoder_error = None;
+        let dense_decoder = if self.dense_text {
+            let text = config.raw.get("text_config").ok_or_else(|| {
+                infinity_v3_backend_core::BackendError::Start("missing text_config".into())
+            })?;
+            match DecoderConfig::from_text_config(text)
+                .and_then(|decoder| validate_recipe(&decoder))
+            {
+                Ok(()) => true,
+                Err(error) => {
+                    decoder_error = Some(format!("{error:?}"));
+                    false
+                }
+            }
+        } else {
+            false
+        };
+        let vision_fa4 = Fa4::supports(&vision_profile);
+        let text_fa4 = Fa4::supports(&text_profile);
+        if !vision_fa4 {
+            missing.push(profile_json(
+                "vision",
+                &vision_profile,
+                "noncausal vision tower",
+            ));
+        }
+        if !text_fa4 {
+            missing.push(profile_json(
+                "text",
+                &text_profile,
+                if text_causal {
+                    "causal dense text"
+                } else {
+                    "noncausal ColEmbed text"
+                },
+            ));
+        }
+        if !dense_decoder {
+            missing.push(json!({
+                "kind": "text_decoder",
+                "reason": decoder_error.unwrap_or_else(|| {
+                    "MoE text is outside the dense Qwen3-VL foundation".to_owned()
+                }),
+            }));
+        }
+        let status = if !dense_decoder {
+            "missing_decoder"
+        } else if !vision_fa4 || !text_fa4 {
+            "missing_fa4"
+        } else {
+            "ready"
+        };
+        Ok(GeometrySupport {
+            structural: true,
+            dense_decoder,
+            vision_fa4,
+            text_fa4,
+            status,
+            text_profile,
+            vision_profile,
+            missing,
+        })
+    }
+}
+
+fn profile_json(kind: &str, spec: &AttentionSpec, role: &str) -> serde_json::Value {
+    json!({
+        "kind": kind,
+        "role": role,
+        "heads": spec.heads,
+        "kv_heads": spec.kv_heads,
+        "head_dim": spec.head_dim,
+        "causal": spec.causal,
+        "window": "global",
+        "dtype": "bf16",
+        "scale": "rsqrt_head_dim",
+    })
+}
+
+fn sha256(path: &Path) -> Option<String> {
+    use sha2::{Digest, Sha256};
+    let bytes = std::fs::read(path).ok()?;
+    Some(format!("{:x}", Sha256::digest(bytes)))
+}
+
+/// Profile requests that are not tied to a fully verified model tuple yet.
+/// The audit proves the FA4 ABI bakes the grouping ratio, not absolute heads.
+pub fn additional_profile_requests() -> Vec<serde_json::Value> {
+    let causal = AttentionSpec {
+        heads: 40,
+        kv_heads: 8,
+        head_dim: 128,
+        causal: true,
+        window: Window::Global,
+        dtype: DType::Bf16,
+        scale: Scale::RsqrtHeadDim,
+    };
+    let noncausal = AttentionSpec {
+        causal: false,
+        ..causal
+    };
+    let mut requests = Vec::new();
+    for (role, spec) in [
+        ("Qwen3-VL-14B/other Q40/KV8 d128 causal global", causal),
+        (
+            "Qwen3-VL-14B/other Q40/KV8 d128 noncausal global",
+            noncausal,
+        ),
+    ] {
+        if !Fa4::supports(&spec) {
+            requests.push(json!({
+                "tuple": "Qwen3-VL-14B (derived profile-only request)",
+                "missing": {
+                    "kind": "text",
+                    "role": role,
+                    "heads": spec.heads,
+                    "kv_heads": spec.kv_heads,
+                    "head_dim": spec.head_dim,
+                    "causal": spec.causal,
+                    "window": "global",
+                    "dtype": "bf16",
+                    "scale": "rsqrt_head_dim",
+                    "reason": "grouping ratio 5 is absent from canonical26",
+                }
+            }));
+        }
+    }
+    requests
+}
+
+pub fn report() -> serde_json::Value {
+    let mut tuples = Vec::new();
+    let mut required = Vec::new();
+    for tuple in cached_tuples().into_iter().chain(derived_tuples()) {
+        let support = tuple.classify().ok();
+        if let Some(support) = support.as_ref() {
+            for item in &support.missing {
+                if item.get("kind").and_then(|value| value.as_str()) == Some("text")
+                    || item.get("kind").and_then(|value| value.as_str()) == Some("vision")
+                {
+                    required.push(json!({
+                        "tuple": tuple.name,
+                        "missing": item,
+                    }));
+                }
+            }
+        }
+        tuples.push(json!({
+            "name": tuple.name,
+            "source": tuple.source,
+            "config_path": tuple.config_path,
+            "config_sha256": tuple.config_path.and_then(|path| sha256(Path::new(path))),
+            "alias": tuple.alias.model_type(),
+            "dense_text": tuple.dense_text,
+            "text": {
+                "hidden_size": tuple.text_hidden,
+                "heads": tuple.text_heads,
+                "kv_heads": tuple.text_kv,
+                "head_dim": tuple.text_head_dim,
+                "layers": tuple.text_layers,
+                "intermediate_size": tuple.text_intermediate,
+                "vocab": tuple.text_vocab,
+                "theta": tuple.text_theta,
+                "mrope": tuple.mrope,
+            },
+            "vision": {
+                "hidden_size": tuple.vision_hidden,
+                "heads": tuple.vision_heads,
+                "head_dim": tuple.vision_hidden / tuple.vision_heads,
+                "depth": tuple.vision_depth,
+                "intermediate_size": tuple.vision_intermediate,
+                "out_hidden_size": tuple.vision_out,
+                "positions": tuple.vision_positions,
+                "deepstack": tuple.deepstack,
+            },
+            "support": support.map(|support| json!({
+                "structural": support.structural,
+                "dense_decoder": support.dense_decoder,
+                "vision_fa4": support.vision_fa4,
+                "text_fa4": support.text_fa4,
+                "status": support.status,
+                "text_profile": Fa4::profile_name(&support.text_profile),
+                "vision_profile": Fa4::profile_name(&support.vision_profile),
+                "shell_only": false,
+            })),
+        }));
+    }
+    required.extend(additional_profile_requests());
+    json!({
+        "schema": "oxide-qwen3-vl-geometry/v1",
+        "base_commit": "e582ce90eb1544fcff081a495cb8fd4f3c17b112",
+        "structural_envelope": "Native accepts dense Qwen3-VL text with head_dim 128, square vision position tables, temporal_patch_size 2, in_channels 3 and text hidden equal to vision out_hidden_size. The Oxide generic Qwen3 recipe covers arbitrary dense head_dim-128 hidden widths with the existing generic norm/RoPE/QK exports. FA4 selection uses the grouping ratio, head_dim, dtype, causal bit and mask family, not absolute Q/KV heads: Q64/KV8 d128 reuses mode 22/5, Q12/KV12 d64 global reuses mode 0, and only the ratio-5 Q40/KV8 d128 combination is genuinely new.",
+        "cached_tuples": 4,
+        "derived_tuples": 3,
+        "tuples": tuples,
+        "dtypes": {
+            "bf16": {
+                "config": "admitted; effective dtype is the top-level checkpoint dtype",
+                "device": "concrete Qwen3-VL tower and dense decoder use BF16",
+                "readout": "BF16 weights are widened exactly on the host",
+                "cached_tuples": ["Qwen3-VL-8B-Embedding", "TomoroAI-ColQwen3-4B", "Nemotron-ColEmbed-VL-4B-v2", "Nemotron-ColEmbed-VL-8B-v2"],
+            },
+            "f16": {
+                "config": "admitted structurally by the config/contract",
+                "device": "not implemented: the additive Qwen3-VL kernels are BF16; F16 needs its own shader/exports",
+                "readout": "F16 weights are widened exactly on the host",
+                "action": "report to central shader owner; do not admit F16 at the backend",
+            },
+            "f32": {
+                "config": "rejected for the GPU adapter; Native CPU reference only",
+                "device": "not supported",
+                "readout": "F32 host projection supported for tests/CPU readouts",
+            },
+        },
+        "central_fa4_owner_packet": {
+            "purpose": "Profiles required for Native-accepted Qwen3-VL tuples that are not in canonical26.",
+            "profiles": required,
+            "note": "Absent profiles are reported; no existing profile is borrowed or relabelled."
+        },
+        "non_claims": [
+            "Derived 2B/32B tuples must be verified against the real config before admission.",
+            "No GPU execution or profile qualification is claimed.",
+            "30B-A3B MoE text is outside the dense Qwen3-VL foundation."
+        ]
+    })
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_inventory.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_inventory.rs
new file mode 100644
index 0000000..dd92860
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_inventory.rs
@@ -0,0 +1,742 @@
+// Expected tensor inventory and checkpoint binding for Qwen3-VL.
+//
+// The expected names and shapes are derived from the actual Native accessors:
+// `model.visual.*` for the tower and `model.language_model.*` for the dense Qwen3
+// text decoder. Optional biases are admitted only where the Native decoder
+// accepts them. A tensor that is present but unused is reported, never silently
+// dropped.
+
+use crate::checkpoint::{start, CheckpointDtype, CheckpointMetadata, TensorMeta};
+use crate::qwen3_vl_config::{Qwen3VlConfig, TextConfig};
+use infinity_v3_backend_core::BackendError;
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+pub const VISION_PREFIX: &str = "model.visual.";
+pub const TEXT_PREFIX: &str = "model.language_model.";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum TensorKind {
+    Vision,
+    Deepstack,
+    Text,
+    OptionalTextBias,
+    Readout,
+}
+
+impl TensorKind {
+    pub const fn label(self) -> &'static str {
+        match self {
+            Self::Vision => "vision",
+            Self::Deepstack => "deepstack",
+            Self::Text => "text",
+            Self::OptionalTextBias => "optional_text_bias",
+            Self::Readout => "readout",
+        }
+    }
+
+    pub const fn optional(self) -> bool {
+        matches!(self, Self::OptionalTextBias | Self::Readout)
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ExpectedTensor {
+    pub name: String,
+    pub shape: Vec<usize>,
+    pub kind: TensorKind,
+    pub layer: Option<usize>,
+    pub deepstack_index: Option<usize>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum InventoryScope {
+    TowerOnly,
+    Full,
+}
+
+#[derive(Clone, Debug)]
+pub struct BoundTensor {
+    pub expected: ExpectedTensor,
+    pub actual: TensorMeta,
+}
+
+#[derive(Clone, Debug)]
+pub struct InventoryReport {
+    pub scope: InventoryScope,
+    pub bound: Vec<BoundTensor>,
+    pub vision_count: usize,
+    pub deepstack_count: usize,
+    pub text_count: usize,
+    pub optional_text_bias_count: usize,
+    pub readout_count: usize,
+    pub total_elements: u64,
+    pub total_bytes: u64,
+    pub vision_layers: Vec<usize>,
+    pub text_layers: Vec<usize>,
+    pub deepstack_layers: Vec<usize>,
+    pub shards: BTreeMap<String, usize>,
+}
+
+impl InventoryReport {
+    pub fn tensor_names(&self) -> impl Iterator<Item = &str> {
+        self.bound.iter().map(|bound| bound.actual.name.as_str())
+    }
+}
+
+fn push(
+    out: &mut Vec<ExpectedTensor>,
+    name: String,
+    shape: Vec<usize>,
+    kind: TensorKind,
+    layer: Option<usize>,
+    deepstack_index: Option<usize>,
+) {
+    out.push(ExpectedTensor {
+        name,
+        shape,
+        kind,
+        layer,
+        deepstack_index,
+    });
+}
+
+fn push_norm(
+    out: &mut Vec<ExpectedTensor>,
+    prefix: &str,
+    width: usize,
+    kind: TensorKind,
+    layer: Option<usize>,
+    deepstack_index: Option<usize>,
+) {
+    push(
+        out,
+        format!("{prefix}.weight"),
+        vec![width],
+        kind,
+        layer,
+        deepstack_index,
+    );
+    push(
+        out,
+        format!("{prefix}.bias"),
+        vec![width],
+        kind,
+        layer,
+        deepstack_index,
+    );
+}
+
+fn push_linear(
+    out: &mut Vec<ExpectedTensor>,
+    prefix: &str,
+    rows: usize,
+    columns: usize,
+    kind: TensorKind,
+    layer: Option<usize>,
+    deepstack_index: Option<usize>,
+) {
+    push(
+        out,
+        format!("{prefix}.weight"),
+        vec![rows, columns],
+        kind,
+        layer,
+        deepstack_index,
+    );
+    push(
+        out,
+        format!("{prefix}.bias"),
+        vec![rows],
+        kind,
+        layer,
+        deepstack_index,
+    );
+}
+
+fn vision_expected(
+    config: &Qwen3VlConfig,
+    out: &mut Vec<ExpectedTensor>,
+) -> Result<(), BackendError> {
+    let vision = &config.vision;
+    let hidden = vision.hidden_size;
+    let merge_area = vision.merge_area()?;
+    let grouped = hidden
+        .checked_mul(merge_area)
+        .ok_or_else(|| start("merged vision width overflow"))?;
+    let patch_dim = vision.patch_dim()?;
+    push(
+        out,
+        format!("{VISION_PREFIX}patch_embed.proj.weight"),
+        vec![
+            hidden,
+            vision.in_channels,
+            vision.temporal_patch_size,
+            vision.patch_size,
+            vision.patch_size,
+        ],
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    push(
+        out,
+        format!("{VISION_PREFIX}patch_embed.proj.bias"),
+        vec![hidden],
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    push(
+        out,
+        format!("{VISION_PREFIX}pos_embed.weight"),
+        vec![vision.num_position_embeddings, hidden],
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    if patch_dim
+        != vision.in_channels * vision.temporal_patch_size * vision.patch_size * vision.patch_size
+    {
+        return Err(start("patch dimension mismatch"));
+    }
+    for layer in 0..vision.depth {
+        let prefix = format!("{VISION_PREFIX}blocks.{layer}");
+        push_norm(
+            out,
+            &format!("{prefix}.norm1"),
+            hidden,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.attn.qkv"),
+            hidden * 3,
+            hidden,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.attn.proj"),
+            hidden,
+            hidden,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+        push_norm(
+            out,
+            &format!("{prefix}.norm2"),
+            hidden,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.mlp.linear_fc1"),
+            vision.intermediate_size,
+            hidden,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.mlp.linear_fc2"),
+            hidden,
+            vision.intermediate_size,
+            TensorKind::Vision,
+            Some(layer),
+            None,
+        );
+    }
+    push_norm(
+        out,
+        &format!("{VISION_PREFIX}merger.norm"),
+        hidden,
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    push_linear(
+        out,
+        &format!("{VISION_PREFIX}merger.linear_fc1"),
+        grouped,
+        grouped,
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    push_linear(
+        out,
+        &format!("{VISION_PREFIX}merger.linear_fc2"),
+        vision.out_hidden_size,
+        grouped,
+        TensorKind::Vision,
+        None,
+        None,
+    );
+    for (index, layer) in vision.deepstack_visual_indexes.iter().enumerate() {
+        let prefix = format!("{VISION_PREFIX}deepstack_merger_list.{index}");
+        push_norm(
+            out,
+            &format!("{prefix}.norm"),
+            grouped,
+            TensorKind::Deepstack,
+            Some(*layer),
+            Some(index),
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.linear_fc1"),
+            grouped,
+            grouped,
+            TensorKind::Deepstack,
+            Some(*layer),
+            Some(index),
+        );
+        push_linear(
+            out,
+            &format!("{prefix}.linear_fc2"),
+            vision.out_hidden_size,
+            grouped,
+            TensorKind::Deepstack,
+            Some(*layer),
+            Some(index),
+        );
+    }
+    Ok(())
+}
+
+fn text_expected(text: &TextConfig, out: &mut Vec<ExpectedTensor>) -> Result<(), BackendError> {
+    let hidden = text.hidden_size;
+    let q_width = text.q_width()?;
+    let kv_width = text.kv_width()?;
+    let intermediate = text.intermediate_size;
+    push(
+        out,
+        format!("{TEXT_PREFIX}embed_tokens.weight"),
+        vec![text.vocab_size, hidden],
+        TensorKind::Text,
+        None,
+        None,
+    );
+    push(
+        out,
+        format!("{TEXT_PREFIX}norm.weight"),
+        vec![hidden],
+        TensorKind::Text,
+        None,
+        None,
+    );
+    // Embedding checkpoints can carry a tied LM head that Native ignores.
+    push(
+        out,
+        "lm_head.weight".to_owned(),
+        vec![text.vocab_size, hidden],
+        TensorKind::OptionalTextBias,
+        None,
+        None,
+    );
+    push(
+        out,
+        "lm_head.bias".to_owned(),
+        vec![text.vocab_size],
+        TensorKind::OptionalTextBias,
+        None,
+        None,
+    );
+    for layer in 0..text.num_hidden_layers {
+        let prefix = format!("{TEXT_PREFIX}layers.{layer}");
+        push(
+            out,
+            format!("{prefix}.input_layernorm.weight"),
+            vec![hidden],
+            TensorKind::Text,
+            Some(layer),
+            None,
+        );
+        push(
+            out,
+            format!("{prefix}.post_attention_layernorm.weight"),
+            vec![hidden],
+            TensorKind::Text,
+            Some(layer),
+            None,
+        );
+        for (name, rows, columns) in [
+            ("q_proj", q_width, hidden),
+            ("k_proj", kv_width, hidden),
+            ("v_proj", kv_width, hidden),
+            ("o_proj", hidden, q_width),
+        ] {
+            push(
+                out,
+                format!("{prefix}.self_attn.{name}.weight"),
+                vec![rows, columns],
+                TensorKind::Text,
+                Some(layer),
+                None,
+            );
+            push(
+                out,
+                format!("{prefix}.self_attn.{name}.bias"),
+                vec![rows],
+                TensorKind::OptionalTextBias,
+                Some(layer),
+                None,
+            );
+        }
+        for name in ["q_norm", "k_norm"] {
+            push(
+                out,
+                format!("{prefix}.self_attn.{name}.weight"),
+                vec![text.head_dim],
+                TensorKind::Text,
+                Some(layer),
+                None,
+            );
+        }
+        for (name, rows, columns) in [
+            ("gate_proj", intermediate, hidden),
+            ("up_proj", intermediate, hidden),
+            ("down_proj", hidden, intermediate),
+        ] {
+            push(
+                out,
+                format!("{prefix}.mlp.{name}.weight"),
+                vec![rows, columns],
+                TensorKind::Text,
+                Some(layer),
+                None,
+            );
+            push(
+                out,
+                format!("{prefix}.mlp.{name}.bias"),
+                vec![rows],
+                TensorKind::OptionalTextBias,
+                Some(layer),
+                None,
+            );
+        }
+    }
+    Ok(())
+}
+
+fn readout_expected(config: &Qwen3VlConfig, out: &mut Vec<ExpectedTensor>) {
+    use crate::qwen3_vl_config::ReadoutKind;
+    if !config.readout.multi_vector {
+        return;
+    }
+    match config.readout.kind {
+        ReadoutKind::ColQwen3 => {
+            let width = config
+                .readout
+                .token_projection_width
+                .unwrap_or(crate::qwen3_vl_config::COLQWEN3_TOKEN_WIDTH);
+            for prefix in ["embedding_proj_layer", "linear"] {
+                push(
+                    out,
+                    format!("{prefix}.weight"),
+                    vec![width, config.text.hidden_size],
+                    TensorKind::Readout,
+                    None,
+                    None,
+                );
+                push(
+                    out,
+                    format!("{prefix}.bias"),
+                    vec![width],
+                    TensorKind::Readout,
+                    None,
+                    None,
+                );
+            }
+        }
+        ReadoutKind::Embedding => {
+            // HF_ColBERT's projection width comes from the checkpoint, so the
+            // inventory binds it without inventing a shape.
+            push(
+                out,
+                "linear.weight".to_owned(),
+                Vec::new(),
+                TensorKind::Readout,
+                None,
+                None,
+            );
+            push(
+                out,
+                "linear.bias".to_owned(),
+                Vec::new(),
+                TensorKind::Readout,
+                None,
+                None,
+            );
+        }
+        ReadoutKind::Rerank => {
+            push(
+                out,
+                "score.weight".to_owned(),
+                Vec::new(),
+                TensorKind::Readout,
+                None,
+                None,
+            );
+            push(
+                out,
+                "score.bias".to_owned(),
+                Vec::new(),
+                TensorKind::Readout,
+                None,
+                None,
+            );
+        }
+        ReadoutKind::NemotronColEmbed => {}
+    }
+}
+
+pub fn expected_tensors(
+    config: &Qwen3VlConfig,
+    scope: InventoryScope,
+) -> Result<Vec<ExpectedTensor>, BackendError> {
+    let mut expected = Vec::new();
+    vision_expected(config, &mut expected)?;
+    if scope == InventoryScope::Full {
+        text_expected(&config.text, &mut expected)?;
+    }
+    readout_expected(config, &mut expected);
+    Ok(expected)
+}
+
+fn canonical_name(name: &str) -> Option<String> {
+    // ColQwen3 stores the same VLM under `vlm.`; Native strips the namespace.
+    let name = name.strip_prefix("vlm.").unwrap_or(name);
+    if name.starts_with(VISION_PREFIX) {
+        return Some(name.to_owned());
+    }
+    if let Some(rest) = name.strip_prefix("visual.") {
+        return Some(format!("{VISION_PREFIX}{rest}"));
+    }
+    if name.starts_with(TEXT_PREFIX) {
+        return Some(name.to_owned());
+    }
+    if let Some(rest) = name.strip_prefix("language_model.") {
+        return Some(format!("{TEXT_PREFIX}{rest}"));
+    }
+    // Trained readout tensors extracted by Native's bridge before the adapter.
+    if matches!(
+        name,
+        "embedding_proj_layer.weight"
+            | "embedding_proj_layer.bias"
+            | "linear.weight"
+            | "linear.bias"
+            | "score.weight"
+            | "score.bias"
+            | "lm_head.weight"
+            | "lm_head.bias"
+    ) {
+        return Some(name.to_owned());
+    }
+    None
+}
+
+/// Native requires QKV biases to be all present or all absent, and gate/up
+/// biases to be pairwise present. `o_proj` and `down_proj` biases are
+/// independent. Inventory must reject a partial group before any load.
+pub fn validate_optional_bias_groups(
+    text: &TextConfig,
+    present: &BTreeSet<String>,
+) -> Result<(), BackendError> {
+    for layer in 0..text.num_hidden_layers {
+        let prefix = format!("{TEXT_PREFIX}layers.{layer}");
+        let grouped: [(&[&str], usize); 2] = [
+            (&["q_proj", "k_proj", "v_proj"], 3usize),
+            (&["gate_proj", "up_proj"], 2usize),
+        ];
+        for (names, full) in grouped {
+            let count = names
+                .iter()
+                .filter(|name| {
+                    present.contains(&format!("{prefix}.self_attn.{name}.bias"))
+                        || present.contains(&format!("{prefix}.mlp.{name}.bias"))
+                })
+                .count();
+            if count != 0 && count != full {
+                return Err(start(format!(
+                    "layer {layer} has a partial bias group {names:?}: {count} of {full}"
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+
+pub fn validate_checkpoint(
+    config: &Qwen3VlConfig,
+    metadata: &CheckpointMetadata,
+    scope: InventoryScope,
+) -> Result<InventoryReport, BackendError> {
+    let expected = expected_tensors(config, scope)?;
+    let mut canonical: BTreeMap<String, (&TensorMeta, String)> = BTreeMap::new();
+    let mut unused = Vec::new();
+    for (name, meta) in &metadata.tensors {
+        match canonical_name(name) {
+            Some(key) => {
+                if let Some((previous, original)) = canonical.get(&key) {
+                    if original != name {
+                        return Err(start(format!(
+                            "ambiguous Qwen3-VL weight {key}: both {original} and {name} are present"
+                        )));
+                    }
+                    let _ = previous;
+                }
+                canonical.insert(key, (meta, name.clone()));
+            }
+            None => unused.push(name.clone()),
+        }
+    }
+    if !unused.is_empty() {
+        return Err(start(format!(
+            "checkpoint contains tensors outside the Qwen3-VL adapter: {unused:?}"
+        )));
+    }
+    let mut bound = Vec::with_capacity(expected.len());
+    for expected_tensor in expected {
+        let Some((actual, original)) = canonical.remove(&expected_tensor.name) else {
+            if expected_tensor.kind.optional() {
+                continue;
+            }
+            return Err(start(format!(
+                "missing Qwen3-VL tensor {}",
+                expected_tensor.name
+            )));
+        };
+        if actual.dtype != CheckpointDtype::Bf16 && actual.dtype != CheckpointDtype::F16 {
+            return Err(start(format!(
+                "tensor {} has unsupported dtype {}",
+                expected_tensor.name,
+                actual.dtype.name()
+            )));
+        }
+        let declared = match config.vision.dtype {
+            crate::qwen3_vl_config::Dtype::Bf16 => CheckpointDtype::Bf16,
+            crate::qwen3_vl_config::Dtype::F16 => CheckpointDtype::F16,
+            crate::qwen3_vl_config::Dtype::F32 => CheckpointDtype::F32,
+        };
+        if actual.dtype != declared {
+            return Err(start(format!(
+                "tensor {} dtype {} does not match config dtype {}",
+                expected_tensor.name,
+                actual.dtype.name(),
+                config.vision.dtype.name()
+            )));
+        }
+        if !expected_tensor.shape.is_empty() && actual.shape != expected_tensor.shape {
+            return Err(start(format!(
+                "tensor {} has shape {:?}, expected {:?} (source {original})",
+                expected_tensor.name, actual.shape, expected_tensor.shape
+            )));
+        }
+        bound.push(BoundTensor {
+            expected: expected_tensor,
+            actual: actual.clone(),
+        });
+    }
+    if scope == InventoryScope::TowerOnly {
+        for key in canonical.keys() {
+            if !key.starts_with(TEXT_PREFIX) {
+                return Err(start(format!("unexpected Qwen3-VL tensor {key}")));
+            }
+        }
+    } else if let Some((name, _)) = canonical.into_iter().next() {
+        return Err(start(format!("unexpected Qwen3-VL tensor {name}")));
+    }
+    let present_biases: BTreeSet<String> = bound
+        .iter()
+        .filter(|tensor| tensor.expected.kind == TensorKind::OptionalTextBias)
+        .map(|tensor| tensor.expected.name.clone())
+        .collect();
+    validate_optional_bias_groups(&config.text, &present_biases)?;
+    let mut vision_count = 0;
+    let mut deepstack_count = 0;
+    let mut text_count = 0;
+    let mut optional_text_bias_count = 0;
+    let mut readout_count = 0usize;
+    let mut total_elements = 0u64;
+    let mut total_bytes = 0u64;
+    let mut vision_layers = BTreeSet::new();
+    let mut text_layers = BTreeSet::new();
+    let mut deepstack_layers = BTreeSet::new();
+    let mut shards = BTreeMap::new();
+    for tensor in &bound {
+        match tensor.expected.kind {
+            TensorKind::Vision => vision_count += 1,
+            TensorKind::Deepstack => deepstack_count += 1,
+            TensorKind::Text => text_count += 1,
+            TensorKind::OptionalTextBias => optional_text_bias_count += 1,
+            TensorKind::Readout => readout_count += 1,
+        }
+        if let Some(layer) = tensor.expected.layer {
+            match tensor.expected.kind {
+                TensorKind::Vision => {
+                    vision_layers.insert(layer);
+                }
+                TensorKind::Deepstack => {
+                    deepstack_layers.insert(layer);
+                }
+                TensorKind::Text | TensorKind::OptionalTextBias | TensorKind::Readout => {
+                    text_layers.insert(layer);
+                }
+            }
+        }
+        total_elements = total_elements
+            .checked_add(u64::try_from(tensor.actual.elements()?).map_err(start)?)
+            .ok_or_else(|| start("inventory element count overflow"))?;
+        total_bytes = total_bytes
+            .checked_add(tensor.actual.bytes()?)
+            .ok_or_else(|| start("inventory byte count overflow"))?;
+        *shards.entry(tensor.actual.shard.clone()).or_insert(0) += 1;
+    }
+    Ok(InventoryReport {
+        scope,
+        bound,
+        vision_count,
+        deepstack_count,
+        text_count,
+        optional_text_bias_count,
+        readout_count,
+        total_elements,
+        total_bytes,
+        vision_layers: vision_layers.into_iter().collect(),
+        text_layers: text_layers.into_iter().collect(),
+        deepstack_layers: deepstack_layers.into_iter().collect(),
+        shards,
+    })
+}
+
+/// Open the actual checkpoint config/headers and validate them. No payload is
+/// read and no device is created.
+pub fn validate_checkpoint_path(
+    root: &Path,
+    scope: InventoryScope,
+) -> Result<(Qwen3VlConfig, InventoryReport), BackendError> {
+    let config = Qwen3VlConfig::from_path(root)?;
+    let metadata = CheckpointMetadata::open(root)?;
+    let report = validate_checkpoint(&config, &metadata, scope)?;
+    Ok((config, report))
+}
+
+pub fn deepstack_mapping(config: &Qwen3VlConfig) -> Vec<(usize, usize)> {
+    config
+        .vision
+        .deepstack_visual_indexes
+        .iter()
+        .enumerate()
+        .map(|(name_index, layer)| (*layer, name_index))
+        .collect()
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_layout.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_layout.rs
new file mode 100644
index 0000000..a5f2d9a
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_layout.rs
@@ -0,0 +1,301 @@
+// Cold workspace planning for the Oxide Qwen3-VL tower and text fusion.
+//
+// These are Oxide-owned arena plans derived from the Native stage order. They
+// are not a claim that the Native LibTorch allocator uses this layout. Every
+// section is 256-byte aligned, every size is checked, and no allocation occurs.
+
+use crate::checkpoint::start;
+use crate::qwen3_vl_config::Qwen3VlConfig;
+use crate::qwen3_vl_vision::ImageGrid;
+use infinity_v3_backend_core::BackendError;
+use serde::{Deserialize, Serialize};
+
+pub const ALIGNMENT: u64 = 256;
+const BF16: u64 = 2;
+const F32: u64 = 4;
+
+#[derive(Clone, Debug, Serialize, Deserialize, Eq, PartialEq)]
+pub struct ArenaSection {
+    pub name: String,
+    pub elements: u64,
+    pub element_bytes: u64,
+    pub offset: u64,
+    pub bytes: u64,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, Eq, PartialEq)]
+pub struct ArenaPlan {
+    pub sections: Vec<ArenaSection>,
+    pub total_bytes: u64,
+}
+
+fn align_up(value: u64, alignment: u64) -> Result<u64, BackendError> {
+    if alignment == 0 {
+        return Err(start("alignment must be positive"));
+    }
+    value
+        .checked_add(alignment - 1)
+        .map(|value| value / alignment * alignment)
+        .ok_or_else(|| start("alignment overflow"))
+}
+
+fn checked_mul(left: u64, right: u64, name: &str) -> Result<u64, BackendError> {
+    left.checked_mul(right)
+        .ok_or_else(|| start(format!("{name} overflow")))
+}
+
+struct Builder {
+    sections: Vec<ArenaSection>,
+    offset: u64,
+}
+
+impl Builder {
+    fn new() -> Self {
+        Self {
+            sections: Vec::new(),
+            offset: 0,
+        }
+    }
+
+    fn push(&mut self, name: &str, elements: u64, element_bytes: u64) -> Result<(), BackendError> {
+        let offset = align_up(self.offset, ALIGNMENT)?;
+        let bytes = checked_mul(elements, element_bytes, name)?;
+        let end = offset
+            .checked_add(bytes)
+            .ok_or_else(|| start(format!("{name} end overflow")))?;
+        self.sections.push(ArenaSection {
+            name: name.to_owned(),
+            elements,
+            element_bytes,
+            offset,
+            bytes,
+        });
+        self.offset = end;
+        Ok(())
+    }
+
+    fn finish(self) -> Result<ArenaPlan, BackendError> {
+        let total_bytes = align_up(self.offset, ALIGNMENT)?;
+        Ok(ArenaPlan {
+            sections: self.sections,
+            total_bytes,
+        })
+    }
+}
+
+fn u64_of(value: usize) -> Result<u64, BackendError> {
+    u64::try_from(value).map_err(start)
+}
+
+pub fn vision_arena(
+    config: &Qwen3VlConfig,
+    images: &[ImageGrid],
+) -> Result<ArenaPlan, BackendError> {
+    let vision = &config.vision;
+    let hidden = u64_of(vision.hidden_size)?;
+    let dim = u64_of(vision.head_dim())?;
+    let intermediate = u64_of(vision.intermediate_size)?;
+    let grouped = checked_mul(hidden, u64_of(vision.merge_area()?)?, "merged vision width")?;
+    let patch_dim = u64_of(vision.patch_dim()?)?;
+    let mut patch_rows = 0u64;
+    let mut merged_rows = 0u64;
+    for image in images {
+        let rows = u64::try_from(image.patch_rows()?).map_err(start)?;
+        patch_rows = patch_rows
+            .checked_add(rows)
+            .ok_or_else(|| start("vision patch rows overflow"))?;
+        merged_rows = merged_rows
+            .checked_add(u64_of(image.token_count)?)
+            .ok_or_else(|| start("vision merged rows overflow"))?;
+    }
+    let deepstack = u64_of(vision.deepstack_visual_indexes.len())?;
+    let mut builder = Builder::new();
+    builder.push(
+        "pixels_f32",
+        checked_mul(patch_rows, patch_dim, "pixels")?,
+        F32,
+    )?;
+    builder.push(
+        "states_bf16",
+        checked_mul(patch_rows, hidden, "states")?,
+        BF16,
+    )?;
+    builder.push("norm_bf16", checked_mul(patch_rows, hidden, "norm")?, BF16)?;
+    builder.push(
+        "qkv_bf16",
+        checked_mul(patch_rows, checked_mul(hidden, 3, "qkv width")?, "qkv")?,
+        BF16,
+    )?;
+    builder.push("q_f32", checked_mul(patch_rows, hidden, "q")?, F32)?;
+    builder.push("k_f32", checked_mul(patch_rows, hidden, "k")?, F32)?;
+    builder.push("v_f32", checked_mul(patch_rows, hidden, "v")?, F32)?;
+    builder.push(
+        "vision_cos_f32",
+        checked_mul(patch_rows, dim / 2, "vision cos")?,
+        F32,
+    )?;
+    builder.push(
+        "vision_sin_f32",
+        checked_mul(patch_rows, dim / 2, "vision sin")?,
+        F32,
+    )?;
+    builder.push(
+        "attention_bf16",
+        checked_mul(patch_rows, hidden, "attention")?,
+        BF16,
+    )?;
+    builder.push(
+        "projected_bf16",
+        checked_mul(patch_rows, hidden, "projected")?,
+        BF16,
+    )?;
+    builder.push(
+        "mlp_fc1_bf16",
+        checked_mul(patch_rows, intermediate, "mlp fc1")?,
+        BF16,
+    )?;
+    builder.push(
+        "mlp_fc2_bf16",
+        checked_mul(patch_rows, hidden, "mlp fc2")?,
+        BF16,
+    )?;
+    builder.push(
+        "merger_group_bf16",
+        checked_mul(merged_rows, grouped, "merger group")?,
+        BF16,
+    )?;
+    builder.push(
+        "merger_fc1_bf16",
+        checked_mul(merged_rows, grouped, "merger fc1")?,
+        BF16,
+    )?;
+    builder.push(
+        "merged_features_bf16",
+        checked_mul(
+            merged_rows,
+            u64_of(vision.out_hidden_size)?,
+            "merged features",
+        )?,
+        BF16,
+    )?;
+    if deepstack > 0 {
+        let deep_elements = checked_mul(
+            checked_mul(
+                merged_rows,
+                u64_of(vision.out_hidden_size)?,
+                "deepstack width",
+            )?,
+            deepstack,
+            "deepstack",
+        )?;
+        builder.push("deepstack_bf16", deep_elements, BF16)?;
+    }
+    builder.finish()
+}
+
+pub fn text_arena(config: &Qwen3VlConfig, tokens: usize) -> Result<ArenaPlan, BackendError> {
+    if tokens == 0 {
+        return Err(start("text arena requires at least one token"));
+    }
+    let text = &config.text;
+    let tokens = u64_of(tokens)?;
+    let hidden = u64_of(text.hidden_size)?;
+    let head_dim = u64_of(text.text_dim())?;
+    let q_width = u64_of(text.q_width()?)?;
+    let kv_width = u64_of(text.kv_width()?)?;
+    let intermediate = u64_of(text.intermediate_size)?;
+    let mut builder = Builder::new();
+    builder.push("embed_bf16", checked_mul(tokens, hidden, "embed")?, BF16)?;
+    builder.push(
+        "residual_bf16",
+        checked_mul(tokens, hidden, "residual")?,
+        BF16,
+    )?;
+    builder.push("norm_bf16", checked_mul(tokens, hidden, "text norm")?, BF16)?;
+    let packed_qkv_width = q_width
+        .checked_add(
+            kv_width
+                .checked_mul(2)
+                .ok_or_else(|| start("text qkv width overflow"))?,
+        )
+        .ok_or_else(|| start("text qkv width overflow"))?;
+    builder.push(
+        "qkv_bf16",
+        checked_mul(tokens, packed_qkv_width, "text qkv")?,
+        BF16,
+    )?;
+    builder.push("q_bf16", checked_mul(tokens, q_width, "q")?, BF16)?;
+    builder.push("k_bf16", checked_mul(tokens, kv_width, "k")?, BF16)?;
+    builder.push("v_bf16", checked_mul(tokens, kv_width, "v")?, BF16)?;
+    builder.push("q_norm_bf16", checked_mul(tokens, q_width, "q norm")?, BF16)?;
+    builder.push(
+        "k_norm_bf16",
+        checked_mul(tokens, kv_width, "k norm")?,
+        BF16,
+    )?;
+    builder.push(
+        "mrope_cos_f32",
+        checked_mul(tokens, head_dim / 2, "mrope cos")?,
+        F32,
+    )?;
+    builder.push(
+        "mrope_sin_f32",
+        checked_mul(tokens, head_dim / 2, "mrope sin")?,
+        F32,
+    )?;
+    builder.push(
+        "attention_bf16",
+        checked_mul(tokens, q_width, "text attention")?,
+        BF16,
+    )?;
+    builder.push(
+        "mlp_bf16",
+        checked_mul(
+            tokens,
+            checked_mul(intermediate, 2, "text mlp width")?,
+            "text mlp",
+        )?,
+        BF16,
+    )?;
+    builder.push("final_bf16", checked_mul(tokens, hidden, "final")?, BF16)?;
+    builder.finish()
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, Eq, PartialEq)]
+pub struct FusionLayout {
+    pub vision: Option<ArenaPlan>,
+    pub text: ArenaPlan,
+    pub marker_rows: u64,
+    pub deepstack_rows: u64,
+}
+
+pub fn fusion_layout(
+    config: &Qwen3VlConfig,
+    tokens: usize,
+    images: &[ImageGrid],
+    include_vision: bool,
+) -> Result<FusionLayout, BackendError> {
+    let vision = if include_vision {
+        Some(vision_arena(config, images)?)
+    } else {
+        None
+    };
+    let marker_rows = images.iter().try_fold(0u64, |total, image| {
+        total
+            .checked_add(u64_of(image.token_count)?)
+            .ok_or_else(|| start("marker row count overflow"))
+    })?;
+    let deepstack_rows = if include_vision {
+        marker_rows
+            .checked_mul(u64_of(config.vision.deepstack_visual_indexes.len())?)
+            .ok_or_else(|| start("deepstack row count overflow"))?
+    } else {
+        0
+    };
+    Ok(FusionLayout {
+        vision,
+        text: text_arena(config, tokens)?,
+        marker_rows,
+        deepstack_rows,
+    })
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_oxide_bridge.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_oxide_bridge.rs
new file mode 100644
index 0000000..bf472ac
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_oxide_bridge.rs
@@ -0,0 +1,171 @@
+//! Integration seam between the cold Qwen3-VL plans and existing Oxide
+//! primitives. This module intentionally reuses `TensorRef`/`TensorMut`,
+//! `math::LinearPlan`, FA4 `AttentionSpec`/`AttentionBatch`, `staging::HostIo`
+//! and `upload::WeightUploader`; it does not fork the Dense executor.
+
+use crate::fa4::{AttentionBatch, AttentionSpec, DType, Scale, Window};
+use crate::math::LinearPlan;
+use crate::model::WeightSource;
+use crate::qwen3_vl_config::Qwen3VlConfig;
+use crate::qwen3_vl_enqueue::VisionBatch;
+use crate::staging::{HostIo, SlotPool};
+use crate::tensor::{Bf16, Element, Layout, TensorMut, TensorRef};
+use crate::upload::WeightUploader;
+use cuda_core::{Context, DeviceBuffer};
+use infinity_v3_backend_core::BackendError;
+use std::sync::Arc;
+
+fn start(error: impl std::fmt::Display) -> BackendError {
+    BackendError::Start(format!("Oxide qwen3-vl bridge: {error}"))
+}
+
+/// Real BF16 linear plans for one prepared vision batch. Construction is cold
+/// and uses the existing checked GEMM planner; it never queries or launches.
+pub(crate) struct VisionLinearPlans {
+    pub(crate) patch_embed: LinearPlan<Bf16>,
+    pub(crate) qkv: LinearPlan<Bf16>,
+    pub(crate) projection: LinearPlan<Bf16>,
+    pub(crate) mlp_fc1: LinearPlan<Bf16>,
+    pub(crate) mlp_fc2: LinearPlan<Bf16>,
+    pub(crate) merger_fc1: LinearPlan<Bf16>,
+    pub(crate) merger_fc2: LinearPlan<Bf16>,
+}
+
+impl VisionLinearPlans {
+    pub(crate) fn prepare(
+        config: &Qwen3VlConfig,
+        patch_rows: usize,
+        merged_rows: usize,
+    ) -> Result<Self, BackendError> {
+        let rows = patch_rows.max(1);
+        let merged_rows = merged_rows.max(1);
+        let hidden = config.vision.hidden_size;
+        let intermediate = config.vision.intermediate_size;
+        let grouped = hidden
+            .checked_mul(config.vision.merge_area()?)
+            .ok_or_else(|| start("merged vision width overflow"))?;
+        let plan = |input: usize, output: usize| {
+            LinearPlan::<Bf16>::contiguous(rows, input, output).map_err(start)
+        };
+        let merged_plan = |input: usize, output: usize| {
+            LinearPlan::<Bf16>::contiguous(merged_rows, input, output).map_err(start)
+        };
+        Ok(Self {
+            patch_embed: plan(config.vision.patch_dim()?, hidden)?,
+            qkv: plan(
+                hidden,
+                hidden.checked_mul(3).ok_or_else(|| start("qkv width"))?,
+            )?,
+            projection: plan(hidden, hidden)?,
+            mlp_fc1: plan(hidden, intermediate)?,
+            mlp_fc2: plan(intermediate, hidden)?,
+            merger_fc1: merged_plan(grouped, grouped)?,
+            merger_fc2: merged_plan(grouped, config.vision.out_hidden_size)?,
+        })
+    }
+}
+
+/// Non-causal global vision attention spec. `kv_heads == heads` because the
+/// published Qwen3-VL vision tower has no GQA.
+pub(crate) fn vision_attention_spec(config: &Qwen3VlConfig) -> AttentionSpec {
+    AttentionSpec {
+        heads: config.vision.num_heads,
+        kv_heads: config.vision.num_heads,
+        head_dim: config.vision.head_dim(),
+        causal: false,
+        window: Window::Global,
+        dtype: DType::Bf16,
+        scale: Scale::RsqrtHeadDim,
+    }
+}
+
+/// Frame-isolated packed attention arguments for one prepared batch. The caller
+/// supplies device pointers; this function allocates nothing and submits
+/// nothing. `cu_seqlens` is the batch-local per-frame offset array.
+pub(crate) fn frame_attention_batch(
+    config: &Qwen3VlConfig,
+    batch: &VisionBatch,
+    q: u64,
+    k: u64,
+    v: u64,
+    out: u64,
+    q_offsets: u64,
+) -> AttentionBatch {
+    let heads = config.vision.num_heads;
+    let dim = config.vision.head_dim();
+    let stride = [
+        (heads * dim) as i64,
+        dim as i64,
+        1,
+        (heads * dim) as i64,
+        dim as i64,
+        1,
+        (heads * dim) as i64,
+        dim as i64,
+        1,
+        (heads * dim) as i64,
+        dim as i64,
+        1,
+    ];
+    AttentionBatch {
+        q,
+        k,
+        v,
+        out,
+        q_offsets,
+        k_offsets: q_offsets,
+        q_tokens: batch.patch_rows,
+        k_tokens: batch.patch_rows,
+        batch: batch.cu_seqlens.len().saturating_sub(1),
+        max_q: batch.max_frame,
+        strides: stride,
+    }
+}
+
+/// Reuse the existing host staging pool rather than allocating a Qwen-specific
+/// synchronous scratch path.
+pub(crate) fn vision_host_io(
+    context: &Arc<Context>,
+) -> Result<Arc<SlotPool<HostIo>>, BackendError> {
+    HostIo::pool(context)
+}
+
+/// Reuse the existing `WeightUploader` (two pinned slots, recorded events, no
+/// hot allocation after construction) for the tower tensor list.
+pub(crate) struct VisionWeightUploader<'a> {
+    inner: &'a mut WeightUploader,
+}
+
+impl<'a> VisionWeightUploader<'a> {
+    pub(crate) fn new(inner: &'a mut WeightUploader) -> Self {
+        Self { inner }
+    }
+
+    pub(crate) fn upload(
+        &mut self,
+        sources: &[&WeightSource],
+    ) -> Result<DeviceBuffer<Bf16>, BackendError> {
+        self.inner.upload(sources)
+    }
+
+    pub(crate) fn finish(&self) -> Result<(), BackendError> {
+        self.inner.finish()
+    }
+}
+
+/// Borrowed checked row views over existing device buffers.
+pub(crate) fn checked_rows<'a, E: Element>(
+    buffer: &'a DeviceBuffer<E::Storage>,
+    rows: usize,
+    columns: usize,
+) -> Result<TensorRef<'a, E, 2>, crate::tensor::TensorError> {
+    TensorRef::new(buffer, Layout::contiguous([rows, columns])?)
+}
+
+pub(crate) fn checked_rows_mut<'a, E: Element>(
+    buffer: &'a mut DeviceBuffer<E::Storage>,
+    rows: usize,
+    columns: usize,
+) -> Result<TensorMut<'a, E, 2>, crate::tensor::TensorError> {
+    TensorMut::new(buffer, Layout::contiguous([rows, columns])?)
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_readout.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_readout.rs
new file mode 100644
index 0000000..46a9f26
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_readout.rs
@@ -0,0 +1,424 @@
+// Host-side trained readout composition for Qwen3-VL wrappers.
+//
+// The Native loader selects wrappers from the original `model_type`:
+// * `colqwen3`         -> modules.json Dense token projection + row normalize
+// * `qwen3_vl_nemotron_embed` -> pre-final-norm token rows + row normalize
+// * `HF_ColBERT`       -> main-checkpoint `linear.weight` + row normalize
+// Plain `qwen3_vl` embeddings use last-token pooling and no transform.
+//
+// This module reads only a small trained projection/head. It never rewrites the
+// checkpoint or config, and it never invents a projection when one is absent.
+
+use crate::checkpoint::start;
+use crate::model::{read_json, Checkpoint};
+use crate::qwen3_vl_config::{ReadoutConfig, ReadoutKind};
+use infinity_v3_backend_core::BackendError;
+use serde::Deserialize;
+use std::path::{Component, Path};
+
+#[derive(Clone, Debug)]
+pub struct LinearReadout {
+    pub weight: Vec<f32>,
+    pub bias: Option<Vec<f32>>,
+    pub input_width: usize,
+    pub output_width: usize,
+    pub tanh: bool,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+struct DenseConfig {
+    in_features: usize,
+    out_features: usize,
+    #[serde(default)]
+    bias: bool,
+    #[serde(default = "identity_activation")]
+    activation_function: String,
+}
+
+fn identity_activation() -> String {
+    "torch.nn.modules.linear.Identity".to_owned()
+}
+
+#[derive(Clone, Debug)]
+pub struct Qwen3VlReadout {
+    pub config: ReadoutConfig,
+    pub hidden: usize,
+    chain: Vec<LinearReadout>,
+    score: Option<LinearReadout>,
+    norm_eps: f32,
+}
+
+impl Qwen3VlReadout {
+    pub fn load(root: &Path, config: &ReadoutConfig, hidden: usize) -> Result<Self, BackendError> {
+        if hidden == 0 {
+            return Err(start("readout hidden width is zero"));
+        }
+        let mut chain = Vec::new();
+        let mut score = None;
+        match config.kind {
+            ReadoutKind::Embedding => {
+                if config.multi_vector {
+                    // HF_ColBERT stores the token projection in the main
+                    // checkpoint as `linear.weight` (Native decoder path).
+                    let checkpoint = Checkpoint::open(root)?;
+                    let (weight, bias, rows) =
+                        read_linear(&checkpoint, "linear.weight", "linear.bias")?;
+                    if weight.len() != rows * hidden {
+                        return Err(start(format!(
+                            "ColBERT token projection is {}x{}, expected {}x{}",
+                            rows,
+                            weight.len() / rows.max(1),
+                            rows,
+                            hidden
+                        )));
+                    }
+                    chain.push(LinearReadout {
+                        weight,
+                        bias,
+                        input_width: hidden,
+                        output_width: rows,
+                        tanh: false,
+                    });
+                }
+            }
+            ReadoutKind::ColQwen3 => {
+                // Native bridge order: `embedding_proj_layer` (after stripping
+                // `vlm.`), then `linear.weight`, then a Dense module.
+                let checkpoint = Checkpoint::open(root)?;
+                if checkpoint.contains("embedding_proj_layer.weight")
+                    || checkpoint.contains("vlm.embedding_proj_layer.weight")
+                {
+                    let (weight, bias, rows) = read_linear_alias(
+                        &checkpoint,
+                        "embedding_proj_layer.weight",
+                        "embedding_proj_layer.bias",
+                    )?;
+                    if weight.len() != rows * hidden {
+                        return Err(start(
+                            "ColQwen3 embedding_proj_layer has incompatible geometry",
+                        ));
+                    }
+                    chain.push(LinearReadout {
+                        weight,
+                        bias,
+                        input_width: hidden,
+                        output_width: rows,
+                        tanh: false,
+                    });
+                } else if checkpoint.contains("linear.weight")
+                    || checkpoint.contains("vlm.linear.weight")
+                {
+                    let (weight, bias, rows) =
+                        read_linear_alias(&checkpoint, "linear.weight", "linear.bias")?;
+                    if weight.len() != rows * hidden {
+                        return Err(start(
+                            "ColQwen3 linear projection has incompatible geometry",
+                        ));
+                    }
+                    chain.push(LinearReadout {
+                        weight,
+                        bias,
+                        input_width: hidden,
+                        output_width: rows,
+                        tanh: false,
+                    });
+                } else {
+                    chain = load_dense_chain(root, hidden)?;
+                }
+                let expected = config.token_projection_width.unwrap_or(0);
+                let actual = chain.last().map_or(hidden, |module| module.output_width);
+                if expected != 0 && actual != expected {
+                    return Err(start(format!(
+                        "ColQwen3 token projection width {actual} does not match expected {expected}"
+                    )));
+                }
+            }
+            ReadoutKind::NemotronColEmbed => {
+                // The Native wrapper applies no token projection: it exports
+                // the pre-final-norm residual states and normalizes rows.
+            }
+            ReadoutKind::Rerank => {
+                let checkpoint = Checkpoint::open(root)?;
+                let (weight, bias, rows) = read_linear(&checkpoint, "score.weight", "score.bias")?;
+                if weight.len() != rows * hidden {
+                    return Err(start("rerank score head has incompatible geometry"));
+                }
+                score = Some(LinearReadout {
+                    weight,
+                    bias,
+                    input_width: hidden,
+                    output_width: rows,
+                    tanh: false,
+                });
+            }
+        }
+        if config.skip_final_norm && config.kind != ReadoutKind::NemotronColEmbed {
+            return Err(start(
+                "skip_final_norm is admitted only for the Nemotron ColEmbed wrapper",
+            ));
+        }
+        Ok(Self {
+            config: config.clone(),
+            hidden,
+            chain,
+            score,
+            norm_eps: config.norm_eps as f32,
+        })
+    }
+
+    pub fn output_width(&self) -> usize {
+        self.chain
+            .last()
+            .map_or(self.hidden, |module| module.output_width)
+    }
+
+    pub fn requires_token_rows(&self) -> bool {
+        self.config.multi_vector
+    }
+
+    /// Apply the trained chain to row-major `[tokens, hidden]` rows and then
+    /// L2-normalize when the wrapper requires it. Returns `[tokens, width]`.
+    pub fn apply_rows(&self, rows: &[f32], tokens: usize) -> Result<Vec<f32>, BackendError> {
+        let expected = tokens
+            .checked_mul(self.hidden)
+            .ok_or_else(|| start("readout token row count overflow"))?;
+        if rows.len() != expected {
+            return Err(start(format!(
+                "readout received {} values, expected {expected}",
+                rows.len()
+            )));
+        }
+        if self.chain.is_empty() {
+            let mut output = rows.to_vec();
+            if self.config.normalize {
+                l2_normalize(&mut output, tokens, self.hidden, self.norm_eps)?;
+            }
+            return Ok(output);
+        }
+        let mut current = rows.to_vec();
+        let mut width = self.hidden;
+        for module in &self.chain {
+            if module.input_width != width {
+                return Err(start("trained readout chain width mismatch"));
+            }
+            let mut next = vec![0f32; tokens * module.output_width];
+            for (row, source) in current.chunks_exact(width).enumerate() {
+                for (column, weight) in module.weight.chunks_exact(module.input_width).enumerate() {
+                    let mut value = 0f32;
+                    for (a, b) in source.iter().zip(weight) {
+                        value += a * b;
+                    }
+                    if let Some(bias) = module.bias.as_ref() {
+                        value += bias[column];
+                    }
+                    if module.tanh {
+                        value = value.tanh();
+                    }
+                    next[row * module.output_width + column] = value;
+                }
+            }
+            current = next;
+            width = module.output_width;
+        }
+        if self.config.normalize {
+            l2_normalize(&mut current, tokens, width, self.norm_eps)?;
+        }
+        Ok(current)
+    }
+
+    /// Apply a trained scalar/label score head to pooled rows. This is not
+    /// selected by a Native Qwen3-VL model_type; callers must opt in.
+    pub fn apply_scores(&self, pooled: &[f32], sequences: usize) -> Result<Vec<f32>, BackendError> {
+        let score = self
+            .score
+            .as_ref()
+            .ok_or_else(|| start("checkpoint has no trained rerank score head"))?;
+        let expected = sequences
+            .checked_mul(self.hidden)
+            .ok_or_else(|| start("rerank row count overflow"))?;
+        if pooled.len() != expected {
+            return Err(start("rerank input row count mismatch"));
+        }
+        let mut output = vec![0f32; sequences * score.output_width];
+        for (row, source) in pooled.chunks_exact(self.hidden).enumerate() {
+            for (column, weight) in score.weight.chunks_exact(self.hidden).enumerate() {
+                let mut value = 0f32;
+                for (a, b) in source.iter().zip(weight) {
+                    value += a * b;
+                }
+                if let Some(bias) = score.bias.as_ref() {
+                    value += bias[column];
+                }
+                output[row * score.output_width + column] = value;
+            }
+        }
+        Ok(output)
+    }
+}
+
+fn l2_normalize(
+    rows: &mut [f32],
+    count: usize,
+    width: usize,
+    eps: f32,
+) -> Result<(), BackendError> {
+    if width == 0 {
+        return Err(start("cannot normalize zero-width rows"));
+    }
+    if !(eps.is_finite() && eps > 0.0) {
+        return Err(start("token normalization epsilon must be positive"));
+    }
+    for row in rows.chunks_exact_mut(width).take(count) {
+        let norm = row.iter().map(|value| value * value).sum::<f32>().sqrt();
+        if !norm.is_finite() {
+            return Err(start("token row has a non-finite norm"));
+        }
+        // Native MultiVectorModel: states / clamp_min(||states||, eps).
+        let denominator = norm.max(eps);
+        for value in row {
+            *value /= denominator;
+        }
+    }
+    Ok(())
+}
+
+type LinearValues = (Vec<f32>, Option<Vec<f32>>, usize);
+
+fn read_linear(
+    checkpoint: &Checkpoint,
+    weight: &str,
+    bias: &str,
+) -> Result<LinearValues, BackendError> {
+    read_linear_alias(checkpoint, weight, bias)
+}
+
+fn read_linear_alias(
+    checkpoint: &Checkpoint,
+    weight: &str,
+    bias: &str,
+) -> Result<LinearValues, BackendError> {
+    let weight_name = if checkpoint.contains(weight) {
+        weight.to_owned()
+    } else {
+        format!("vlm.{weight}")
+    };
+    let bias_name = if checkpoint.contains(bias) {
+        Some(bias.to_owned())
+    } else if checkpoint.contains(&format!("vlm.{bias}")) {
+        Some(format!("vlm.{bias}"))
+    } else {
+        None
+    };
+    read_linear_named(checkpoint, &weight_name, bias_name.as_deref())
+}
+
+fn read_linear_named(
+    checkpoint: &Checkpoint,
+    weight: &str,
+    bias: Option<&str>,
+) -> Result<LinearValues, BackendError> {
+    let shape = checkpoint
+        .shape(weight)
+        .ok_or_else(|| start(format!("missing readout tensor {weight}")))?;
+    if shape.len() != 2 {
+        return Err(start(format!("readout tensor {weight} must be rank 2")));
+    }
+    let (rows, columns) = (shape[0], shape[1]);
+    let source = checkpoint.source(weight, shape)?;
+    let mut weight_values = vec![0f32; rows * columns];
+    source.read_f32(0, &mut weight_values)?;
+    let bias_values = if let Some(bias) = bias {
+        let bias_shape = checkpoint
+            .shape(bias)
+            .ok_or_else(|| start("missing bias shape"))?;
+        if bias_shape != [rows] {
+            return Err(start(format!("readout bias {bias} has the wrong shape")));
+        }
+        let source = checkpoint.source(bias, bias_shape)?;
+        let mut values = vec![0f32; rows];
+        source.read_f32(0, &mut values)?;
+        Some(values)
+    } else {
+        None
+    };
+    Ok((weight_values, bias_values, rows))
+}
+
+fn load_dense_chain(root: &Path, hidden: usize) -> Result<Vec<LinearReadout>, BackendError> {
+    let modules_path = root.join("modules.json");
+    if !modules_path.is_file() {
+        return Err(start(
+            "ColQwen3 requires modules.json with the trained Dense token projection",
+        ));
+    }
+    let modules: serde_json::Value = read_json(&modules_path)?;
+    let modules = modules
+        .as_array()
+        .ok_or_else(|| start("modules.json must contain an array"))?;
+    let mut chain = Vec::new();
+    let mut width = hidden;
+    for module in modules {
+        let kind = module
+            .get("type")
+            .and_then(serde_json::Value::as_str)
+            .ok_or_else(|| start("module is missing its type"))?;
+        if kind.rsplit('.').next() != Some("Dense") {
+            continue;
+        }
+        let path = module
+            .get("path")
+            .and_then(serde_json::Value::as_str)
+            .ok_or_else(|| start("Dense module is missing its path"))?;
+        let relative = Path::new(path);
+        if relative.as_os_str().is_empty()
+            || relative
+                .components()
+                .any(|part| !matches!(part, Component::Normal(_)))
+        {
+            return Err(start(
+                "Dense module path must stay inside the model directory",
+            ));
+        }
+        let module_root = root.join(relative);
+        let config: DenseConfig = read_json(&module_root.join("config.json"))?;
+        if config.in_features != width {
+            return Err(start(format!(
+                "Dense module input {} does not match current width {width}",
+                config.in_features
+            )));
+        }
+        let checkpoint = Checkpoint::open_module(root, &module_root)?;
+        let (weight, bias, rows) = read_linear(&checkpoint, "linear.weight", "linear.bias")?;
+        if rows != config.out_features || weight.len() != config.out_features * config.in_features {
+            return Err(start("Dense module weight does not match config.json"));
+        }
+        if config.bias != bias.is_some() {
+            return Err(start(
+                "Dense module bias presence does not match config.json",
+            ));
+        }
+        let tanh = match config.activation_function.as_str() {
+            "torch.nn.modules.linear.Identity" => false,
+            "torch.nn.modules.activation.Tanh" => true,
+            other => {
+                return Err(start(format!(
+                    "unsupported Dense activation {other} in the VL token readout"
+                )))
+            }
+        };
+        chain.push(LinearReadout {
+            weight,
+            bias,
+            input_width: config.in_features,
+            output_width: config.out_features,
+            tanh,
+        });
+        width = config.out_features;
+    }
+    if chain.is_empty() {
+        return Err(start(
+            "ColQwen3 has no trained Dense token projection in modules.json",
+        ));
+    }
+    Ok(chain)
+}
