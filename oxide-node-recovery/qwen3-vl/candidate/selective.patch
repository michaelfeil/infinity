--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_enqueue.rs
@@ -0,0 +1,204 @@
+// Owned prepared vision execution plan.
+//
+// Preparation is cold: it computes frame isolation, batch ranges and the fixed
+// stage sequence once. `enqueue` walks that immutable plan and performs no heap
+// allocation, no device query, no readback and no synchronization. The sink is
+// the only entity allowed to submit device work, so a CPU test can verify the
+// exact stage order without claiming a GPU pass.
+
+use crate::checkpoint::start;
+use crate::qwen3_vl_config::Qwen3VlConfig;
+use crate::qwen3_vl_vision::{
+    deepstack_capture_order, frame_plan, vision_batches, FramePlan, ImageGrid,
+};
+use infinity_v3_backend_core::BackendError;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum BlockStage {
+    Norm1,
+    Qkv,
+    Rotary,
+    Attention,
+    Projection,
+    Residual1,
+    Norm2,
+    MlpFc1,
+    MlpActivation,
+    MlpFc2,
+    Residual2,
+}
+
+pub const BLOCK_STAGES: [BlockStage; 11] = [
+    BlockStage::Norm1,
+    BlockStage::Qkv,
+    BlockStage::Rotary,
+    BlockStage::Attention,
+    BlockStage::Projection,
+    BlockStage::Residual1,
+    BlockStage::Norm2,
+    BlockStage::MlpFc1,
+    BlockStage::MlpActivation,
+    BlockStage::MlpFc2,
+    BlockStage::Residual2,
+];
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct VisionBatch {
+    pub image_start: usize,
+    pub image_end: usize,
+    pub patch_rows: usize,
+    pub merged_rows: usize,
+    pub cu_seqlens: Vec<i32>,
+    pub max_frame: usize,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PreparedVision {
+    pub images: Vec<ImageGrid>,
+    pub batches: Vec<VisionBatch>,
+    pub deepstack: Vec<(usize, usize)>,
+    pub depth: usize,
+    pub total_patch_rows: usize,
+    pub total_merged_rows: usize,
+}
+
+pub trait VisionSink {
+    type Error;
+    fn patch_embed(&mut self, batch: &VisionBatch) -> Result<(), Self::Error>;
+    fn position_rotary(&mut self, batch: &VisionBatch) -> Result<(), Self::Error>;
+    fn block(
+        &mut self,
+        batch: &VisionBatch,
+        layer: usize,
+        stage: BlockStage,
+    ) -> Result<(), Self::Error>;
+    fn deepstack(
+        &mut self,
+        batch: &VisionBatch,
+        layer: usize,
+        name_index: usize,
+    ) -> Result<(), Self::Error>;
+    fn merger(&mut self, batch: &VisionBatch) -> Result<(), Self::Error>;
+}
+
+fn batch_frame_offsets(
+    plan: &FramePlan,
+    image_start: usize,
+    image_end: usize,
+) -> Result<(Vec<i32>, usize, usize), BackendError> {
+    let mut offsets = Vec::with_capacity(1);
+    offsets.push(0i32);
+    let mut max_frame = 0usize;
+    let mut merged = 0usize;
+    for image in image_start..image_end {
+        let (first_frame, end_frame) = plan.image_frame_spans[image];
+        for frame in first_frame..end_frame {
+            let length = plan.frame_lengths[frame];
+            let next = (*offsets.last().unwrap_or(&0) as usize)
+                .checked_add(length)
+                .ok_or_else(|| start("batch frame offset overflow"))?;
+            if next > i32::MAX as usize {
+                return Err(start("batch frame offsets exceed i32"));
+            }
+            offsets.push(next as i32);
+            max_frame = max_frame.max(length);
+        }
+        merged = merged
+            .checked_add(plan.merged_counts[image])
+            .ok_or_else(|| start("batch merged row overflow"))?;
+    }
+    Ok((offsets, max_frame, merged))
+}
+
+impl PreparedVision {
+    pub fn prepare(
+        config: &Qwen3VlConfig,
+        images: &[ImageGrid],
+        budget_bytes: u64,
+    ) -> Result<Self, BackendError> {
+        if images.is_empty() {
+            return Err(start("prepared vision requires at least one image"));
+        }
+        let plan = frame_plan(images)?;
+        let mut patch_rows = Vec::with_capacity(images.len());
+        for image in images {
+            if image.merge_size != config.vision.spatial_merge_size {
+                return Err(start(format!(
+                    "image merge size {} does not match config merge {}",
+                    image.merge_size, config.vision.spatial_merge_size
+                )));
+            }
+            patch_rows.push(image.patch_rows()?);
+        }
+        let ranges = vision_batches(
+            &patch_rows,
+            config.vision.hidden_size,
+            config.vision.intermediate_size,
+            budget_bytes,
+        )?;
+        let mut batches = Vec::with_capacity(ranges.len());
+        let mut total_patch_rows = 0usize;
+        let mut total_merged_rows = 0usize;
+        for (image_start, image_end) in ranges {
+            let patch_rows =
+                patch_rows[image_start..image_end]
+                    .iter()
+                    .try_fold(0usize, |total, count| {
+                        total
+                            .checked_add(*count)
+                            .ok_or_else(|| start("batch patch rows overflow"))
+                    })?;
+            let (cu_seqlens, max_frame, merged_rows) =
+                batch_frame_offsets(&plan, image_start, image_end)?;
+            total_patch_rows = total_patch_rows
+                .checked_add(patch_rows)
+                .ok_or_else(|| start("total patch rows overflow"))?;
+            total_merged_rows = total_merged_rows
+                .checked_add(merged_rows)
+                .ok_or_else(|| start("total merged rows overflow"))?;
+            batches.push(VisionBatch {
+                image_start,
+                image_end,
+                patch_rows,
+                merged_rows,
+                cu_seqlens,
+                max_frame,
+            });
+        }
+        let deepstack =
+            deepstack_capture_order(&config.vision.deepstack_visual_indexes, config.vision.depth)?;
+        Ok(Self {
+            images: images.to_vec(),
+            batches,
+            deepstack,
+            depth: config.vision.depth,
+            total_patch_rows,
+            total_merged_rows,
+        })
+    }
+
+    pub fn stage_calls(&self) -> usize {
+        self.batches.len() * (2 + self.depth * BLOCK_STAGES.len() + self.deepstack.len() + 1)
+    }
+
+    /// Walk the immutable plan. All scratch is owned by the sink; this method
+    /// performs no allocation, no query, no synchronization and no CPU fallback.
+    pub fn enqueue<S: VisionSink>(&self, sink: &mut S) -> Result<(), S::Error> {
+        for batch in &self.batches {
+            sink.patch_embed(batch)?;
+            sink.position_rotary(batch)?;
+            for layer in 0..self.depth {
+                for stage in BLOCK_STAGES {
+                    sink.block(batch, layer, stage)?;
+                }
+                for &(capture_layer, name_index) in &self.deepstack {
+                    if capture_layer == layer {
+                        sink.deepstack(batch, layer, name_index)?;
+                    }
+                }
+            }
+            sink.merger(batch)?;
+        }
+        Ok(())
+    }
+}
diff --git a/libs/infinity-v3/backends/oxide/src/qwen3_vl_fixtures.rs b/libs/infinity-v3/backends/oxide/src/qwen3_vl_fixtures.rs
new file mode 100644
index 0000000..c19d70b
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/qwen3_vl_fixtures.rs
@@ -0,0 +1,208 @@
+// Real Qwen3-VL processor fixture -> engine `Batch` plumbing.
+//
+// The fixtures are produced by the cached Rust processor (no Torch, no GPU, no
+// download). This module reads the same ids/types/positions/cumulative arrays
+// and the prepared f32 patch payloads, so the Oxide consumer and the Native b66
+// consumer can be driven from byte-identical inputs.
+
+use crate::checkpoint::start;
+use infinity_v3_backend_core::{BackendError, Batch, ImagePatches, MultimodalEncoding, Pool};
+use serde::Deserialize;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct FixtureFile {
+    pub fixtures: Vec<Fixture>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct Fixture {
+    pub name: String,
+    pub ids: Vec<u32>,
+    #[serde(default)]
+    pub types: Vec<u32>,
+    #[serde(default)]
+    pub positions: Vec<u32>,
+    pub cumulative: Vec<u32>,
+    /// Absent for text-only fixtures. When present it must have three axes.
+    #[serde(default)]
+    pub media_positions: Option<Vec<Vec<u32>>>,
+    #[serde(default)]
+    pub images: Vec<FixtureImage>,
+    #[serde(default)]
+    pub pool: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct FixtureImage {
+    pub grid_thw: [usize; 3],
+    pub merge_size: usize,
+    pub patch_dim: usize,
+    /// Absolute path in the delivered fixture manifest, or a path relative to
+    /// the manifest directory.
+    pub pixels: String,
+    pub token_start: usize,
+    pub token_count: usize,
+}
+
+pub fn read_fixture_file(path: &Path) -> Result<FixtureFile, BackendError> {
+    let bytes = std::fs::read(path).map_err(start)?;
+    serde_json::from_slice(&bytes).map_err(start)
+}
+
+pub fn fixture_batch(
+    fixture: &Fixture,
+    fixture_root: &Path,
+    raw: bool,
+) -> Result<Batch, BackendError> {
+    let tokens = fixture.ids.len();
+    let sequences = fixture
+        .cumulative
+        .len()
+        .checked_sub(1)
+        .ok_or_else(|| start("fixture is missing cumulative boundaries"))?;
+    if sequences == 0
+        || fixture.cumulative.first().copied() != Some(0)
+        || fixture.cumulative.last().copied() != Some(tokens as u32)
+    {
+        return Err(start("fixture cumulative boundaries are invalid"));
+    }
+    if fixture.positions.len() != tokens
+        || (!fixture.types.is_empty() && fixture.types.len() != tokens)
+    {
+        return Err(start("fixture token arrays disagree"));
+    }
+    let types = if fixture.types.is_empty() {
+        vec![0u32; tokens]
+    } else {
+        fixture.types.clone()
+    };
+    if let Some(positions) = fixture.media_positions.as_ref() {
+        if positions.len() != 3 {
+            return Err(start("fixture media_positions must have three axes"));
+        }
+        if positions.iter().any(|axis| axis.len() != tokens) {
+            return Err(start("fixture media_positions do not cover every token"));
+        }
+    } else if !fixture.images.is_empty() {
+        return Err(start(
+            "fixture has images but no media_positions; refusing to synthesize positions",
+        ));
+    }
+
+    let mut multimodal = Vec::with_capacity(sequences);
+    for pair in fixture.cumulative.windows(2) {
+        let begin = pair[0] as usize;
+        let end = pair[1] as usize;
+        let mut images = Vec::new();
+        for (index, image) in fixture.images.iter().enumerate() {
+            if image.token_start < begin || image.token_start >= end {
+                continue;
+            }
+            let relative = image.token_start - begin;
+            if relative + image.token_count > end - begin {
+                return Err(start(format!(
+                    "fixture image {index} crosses a sequence boundary"
+                )));
+            }
+            let rows = image
+                .grid_thw
+                .iter()
+                .try_fold(1usize, |value, dim| value.checked_mul(*dim))
+                .ok_or_else(|| start("fixture image rows overflow"))?;
+            if image.token_count
+                != rows
+                    .checked_div(image.merge_size * image.merge_size)
+                    .unwrap_or(0)
+            {
+                return Err(start("fixture image token count disagrees with its grid"));
+            }
+            let expected = rows
+                .checked_mul(image.patch_dim)
+                .ok_or_else(|| start("fixture image payload size overflow"))?;
+            let path = PathBuf::from(&image.pixels);
+            let path = if path.is_absolute() {
+                path
+            } else {
+                fixture_root.join(path)
+            };
+            let bytes = std::fs::read(&path)
+                .map_err(|error| start(format!("fixture pixels {}: {error}", path.display())))?;
+            if bytes.len() != expected * 4 {
+                return Err(start(format!(
+                    "fixture pixels {} have {} bytes, expected {}",
+                    path.display(),
+                    bytes.len(),
+                    expected * 4
+                )));
+            }
+            let pixels = bytes
+                .chunks_exact(4)
+                .map(|chunk| f32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]))
+                .collect();
+            images.push((
+                relative,
+                Arc::new(ImagePatches {
+                    pixels,
+                    grid_thw: image.grid_thw,
+                    patch_dim: image.patch_dim,
+                    merge_size: image.merge_size,
+                }),
+            ));
+        }
+        let position_ids: [Vec<u32>; 3] = match fixture.media_positions.as_ref() {
+            Some(positions) => std::array::from_fn(|axis| positions[axis][begin..end].to_vec()),
+            // Plain text rows use the packed local positions for all three axes.
+            None => {
+                let local = fixture.positions[begin..end].to_vec();
+                [local.clone(), local.clone(), local]
+            }
+        };
+        multimodal.push(Some(Arc::new(MultimodalEncoding {
+            images,
+            audios: vec![],
+            position_ids,
+            memory: None,
+        })));
+    }
+    let raw_indices = if raw {
+        (0..sequences).map(|row| row as u32).collect()
+    } else {
+        Vec::new()
+    };
+    Ok(Batch {
+        multimodal,
+        input_ids: fixture.ids.clone(),
+        token_type_ids: types,
+        position_ids: fixture.positions.clone(),
+        cumulative_seq_lengths: fixture.cumulative.clone(),
+        max_length: fixture
+            .cumulative
+            .windows(2)
+            .map(|pair| pair[1] - pair[0])
+            .max()
+            .unwrap_or(0),
+        pooled_indices: if raw {
+            Vec::new()
+        } else {
+            (0..sequences).map(|row| row as u32).collect()
+        },
+        raw_indices,
+        compact_input_ids: None,
+        compact_position_ids: None,
+        scatter_unfold: None,
+        fold_gather: None,
+        tokens: vec![],
+        offsets: vec![],
+    })
+}
+
+pub fn pool_from_name(name: Option<&str>) -> Result<Pool, BackendError> {
+    match name.unwrap_or("last_token") {
+        "cls" => Ok(Pool::Cls),
+        "mean" | "avg" => Ok(Pool::Mean),
+        "last_token" | "last" => Ok(Pool::LastToken),
+        other => Err(start(format!("unsupported fixture pool {other}"))),
+    }
+}
