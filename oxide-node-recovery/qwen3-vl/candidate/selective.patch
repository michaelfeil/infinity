--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/examples/qwen3_vl_host_consumer.rs
@@ -0,0 +1,516 @@
+// Unified CPU host consumer for Qwen3-VL.
+//
+// Modes:
+//   manifest   actual config, normal-factory alias, readout head, full inventory
+//   factory    Batch.multimodal -> pack_batch for all 8 real fixtures + typed media errors
+//   lifecycle  repeated A/B/A growth/drop and recoverable invalid media
+//   gpu-forward actual Qwen3VlBackend forward (Root only; needs CUDA)
+//
+// The author CPU build runs manifest/factory/lifecycle and never CUDA.
+
+use infinity_backend_oxide::qwen3_vl_batch::pack_batch;
+use infinity_backend_oxide::qwen3_vl_config::{Dtype, Qwen3VlConfig, ReadoutKind};
+use infinity_backend_oxide::qwen3_vl_fixtures::{fixture_batch, pool_from_name, read_fixture_file};
+use infinity_backend_oxide::qwen3_vl_inventory::{validate_checkpoint_path, InventoryScope};
+use infinity_backend_oxide::qwen3_vl_readout::Qwen3VlReadout;
+use infinity_backend_oxide::qwen3_vl_service::Qwen3VlBackend;
+use infinity_v3_backend_core::{Backend, Batch, Embedding, ImagePatches, MultimodalEncoding, Pool};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Instant;
+
+const DEFAULT_CHECKPOINTS: &[&str] = &[
+    "/workspace/model-performance/michaelfeil/benchmark-overview/models/Qwen--Qwen3-VL-Embedding-8B",
+    "/workspace/model-performance/michaelfeil/torch215-comparison-20261029/models/TomoroAI--tomoro-colqwen3-embed-4b",
+    "/workspace/model-performance/michaelfeil/torch215-comparison-20261029/models/nvidia--nemotron-colembed-vl-4b-v2",
+    "/tmp/perplexity-embedding-audit/multivector-support/nvidia--nemotron-colembed-vl-8b-v2",
+];
+
+fn sha256(path: &Path) -> Result<String, Box<dyn std::error::Error>> {
+    let bytes = std::fs::read(path)?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+fn readout_for(
+    root: &Path,
+    config: &Qwen3VlConfig,
+) -> Result<Option<Qwen3VlReadout>, Box<dyn std::error::Error>> {
+    if config.readout.kind == ReadoutKind::Embedding && !config.readout.multi_vector {
+        return Ok(None);
+    }
+    Ok(Some(Qwen3VlReadout::load(
+        root,
+        &config.readout,
+        config.text.hidden_size,
+    )?))
+}
+
+fn manifest(root: &Path) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let started = Instant::now();
+    let config = Qwen3VlConfig::from_path(root)?;
+    let alias = infinity_backend_oxide::qwen3_vl_alias(root)?
+        .ok_or("normal factory did not detect the Qwen3-VL alias")?;
+    let (_, report) = validate_checkpoint_path(root, InventoryScope::Full)?;
+    let readout = readout_for(root, &config)?;
+    let readout_width = readout.as_ref().map(Qwen3VlReadout::output_width);
+    Ok(json!({
+        "checkpoint": root,
+        "config_sha256": sha256(&root.join("config.json"))?,
+        "alias": alias.model_type(),
+        "model_type": config.model_type,
+        "dtype": match config.text.dtype {
+            Dtype::Bf16 => "bfloat16",
+            Dtype::F16 => "float16",
+            Dtype::F32 => "float32",
+        },
+        "text_hidden": config.text.hidden_size,
+        "vision_hidden": config.vision.hidden_size,
+        "vision_depth": config.vision.depth,
+        "deepstack": config.vision.deepstack_visual_indexes,
+        "readout_kind": format!("{:?}", config.readout.kind),
+        "multi_vector": config.readout.multi_vector,
+        "norm_eps": config.readout.norm_eps,
+        "readout_width": readout_width,
+        "tensor_count": report.bound.len(),
+        "readout_tensors": report.readout_count,
+        "total_bytes": report.total_bytes,
+        "elapsed_ms": started.elapsed().as_secs_f64() * 1e3,
+    }))
+}
+
+fn factory(root: &Path, fixtures: &Path) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let config = Qwen3VlConfig::from_path(root)?;
+    let _ = readout_for(root, &config)?;
+    let fixture_root = fixtures.parent().unwrap_or_else(|| Path::new("."));
+    let file = read_fixture_file(fixtures)?;
+    let mut records = Vec::new();
+    for fixture in &file.fixtures {
+        let raw = config.readout.multi_vector;
+        let batch = fixture_batch(fixture, fixture_root, raw)?;
+        let pool = pool_from_name(fixture.pool.as_deref())?;
+        let request = pack_batch(&batch, pool, raw)?;
+        records.push(json!({
+            "fixture": fixture.name,
+            "tokens": request.tokens,
+            "sequences": request.sequences,
+            "images": request.forward.images.len(),
+            "merged_rows": request.forward.media_positions.is_some(),
+            "raw": raw,
+        }));
+    }
+    // Typed, recoverable invalid media: wrong pixel payload size.
+    let invalid = Batch {
+        multimodal: vec![Some(Arc::new(MultimodalEncoding {
+            images: vec![(
+                0,
+                Arc::new(ImagePatches {
+                    pixels: vec![0.0; 3],
+                    grid_thw: [1, 2, 2],
+                    patch_dim: 4,
+                    merge_size: 2,
+                }),
+            )],
+            audios: vec![],
+            position_ids: [vec![0, 0], vec![0, 0], vec![0, 0]],
+            memory: None,
+        }))],
+        input_ids: vec![1, 2],
+        token_type_ids: vec![0, 0],
+        position_ids: vec![0, 1],
+        cumulative_seq_lengths: vec![0, 2],
+        max_length: 2,
+        pooled_indices: vec![0],
+        raw_indices: vec![],
+        compact_input_ids: None,
+        compact_position_ids: None,
+        scatter_unfold: None,
+        fold_gather: None,
+        tokens: vec![],
+        offsets: vec![],
+    };
+    let error =
+        pack_batch(&invalid, Pool::LastToken, false).expect_err("invalid media must be rejected");
+    // The same consumer path must remain usable after the typed error.
+    let valid = fixture_batch(&file.fixtures[0], fixture_root, config.readout.multi_vector)?;
+    let _ = pack_batch(&valid, Pool::LastToken, config.readout.multi_vector)?;
+    Ok(json!({
+        "checkpoint": root,
+        "fixtures": records,
+        "invalid_media": {
+            "kind": format!("{error:?}"),
+            "recoverable": true,
+            "valid_after_error": true
+        }
+    }))
+}
+
+fn lifecycle(
+    checkpoints: &[PathBuf],
+    fixtures: &Path,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let started = Instant::now();
+    let mut rounds = Vec::new();
+    for round in 0..3 {
+        let order: Vec<&PathBuf> = if round % 2 == 0 {
+            checkpoints.iter().collect()
+        } else {
+            checkpoints.iter().rev().collect()
+        };
+        let mut held = Vec::new();
+        for root in order {
+            held.push(manifest(root)?);
+            held.push(factory(root, fixtures)?);
+        }
+        // Keep the whole growth set alive, then drop it as one generation.
+        rounds.push(json!({
+            "round": round,
+            "held": held.len(),
+            "dropped": true,
+        }));
+    }
+    Ok(json!({
+        "checkpoint_count": checkpoints.len(),
+        "rounds": rounds,
+        "elapsed_ms": started.elapsed().as_secs_f64() * 1e3,
+        "invalid_media_recoverable": true
+    }))
+}
+
+fn gpu_forward(
+    checkpoints: &[PathBuf],
+    fixtures: &Path,
+    output: &Path,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let fixture_root = fixtures.parent().unwrap_or_else(|| Path::new("."));
+    let file = read_fixture_file(fixtures)?;
+    let mut records = Vec::new();
+    for root in checkpoints {
+        let config = Qwen3VlConfig::from_path(root)?;
+        let pool = Pool::LastToken;
+        let backend = Qwen3VlBackend::new_with_pool(root, "bfloat16", 0, pool.clone())?;
+        for fixture in &file.fixtures {
+            let batch = fixture_batch(fixture, fixture_root, config.readout.multi_vector)?;
+            let started = Instant::now();
+            let result = backend.embed(batch)?;
+            let values = result
+                .values()
+                .map(|embedding| match embedding {
+                    Embedding::Pooled(row) => row.len(),
+                    Embedding::All(rows) => rows.iter().map(Vec::len).sum(),
+                })
+                .sum::<usize>();
+            records.push(json!({
+                "checkpoint": root,
+                "fixture": fixture.name,
+                "values": values,
+                "elapsed_ms": started.elapsed().as_secs_f64() * 1e3,
+            }));
+        }
+    }
+    std::fs::create_dir_all(output)?;
+    let report = json!({"schema":"qwen3-vl-host-consumer-gpu/v1","records":records});
+    std::fs::write(
+        output.join("gpu-forward.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    Ok(report)
+}
+
+fn write_rows(
+    directory: &Path,
+    fixture: &str,
+    kind: &str,
+    width: usize,
+    sequences: usize,
+    cumulative: &[u32],
+    values: &[f32],
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    std::fs::create_dir_all(directory)?;
+    let path = directory.join(format!("{fixture}.{kind}.f32"));
+    let mut bytes = Vec::with_capacity(values.len() * 4);
+    for value in values {
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    std::fs::write(&path, &bytes)?;
+    Ok(json!({
+        "fixture": fixture,
+        "kind": kind,
+        "width": width,
+        "sequences": sequences,
+        "values": values.len(),
+        "cumulative": cumulative,
+        "sha256": format!("{:x}", Sha256::digest(&bytes)),
+        "path": path,
+        "finite": values.iter().all(|value| value.is_finite()),
+    }))
+}
+
+fn pooled_rows(
+    embeddings: &infinity_v3_backend_core::Embeddings,
+    sequences: usize,
+    width: usize,
+) -> Result<Vec<f32>, Box<dyn std::error::Error>> {
+    let mut values = Vec::with_capacity(sequences * width);
+    for row in 0..sequences {
+        match embeddings.get(&row) {
+            Some(Embedding::Pooled(vector)) if vector.len() == width => {
+                values.extend_from_slice(vector)
+            }
+            _ => return Err(format!("missing pooled row {row}").into()),
+        }
+    }
+    Ok(values)
+}
+
+fn raw_rows(
+    embeddings: &infinity_v3_backend_core::Embeddings,
+    sequences: usize,
+    width: usize,
+) -> Result<Vec<f32>, Box<dyn std::error::Error>> {
+    let mut values = Vec::new();
+    for row in 0..sequences {
+        match embeddings.get(&row) {
+            Some(Embedding::All(rows)) => {
+                for token in rows {
+                    if token.len() != width {
+                        return Err(format!("raw row width {} != {width}", token.len()).into());
+                    }
+                    values.extend_from_slice(token);
+                }
+            }
+            _ => return Err(format!("missing raw row {row}").into()),
+        }
+    }
+    Ok(values)
+}
+
+fn gpu_quality(
+    checkpoints: &[PathBuf],
+    fixtures: &Path,
+    output: &Path,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let root = checkpoints.first().ok_or("missing checkpoint")?;
+    let fixture_root = fixtures.parent().unwrap_or_else(|| Path::new("."));
+    let file = read_fixture_file(fixtures)?;
+    let config = Qwen3VlConfig::from_path(root)?;
+    let backend = Qwen3VlBackend::new_with_pool(root, "bfloat16", 0, Pool::LastToken)?;
+    let width = backend.output_width()?;
+    let mut pools = Vec::new();
+    if !config.readout.multi_vector {
+        for (pool, name) in [
+            (Pool::Cls, "pool0"),
+            (Pool::Mean, "pool1"),
+            (Pool::LastToken, "pool2"),
+        ] {
+            let directory = output.join(name);
+            let mut records = Vec::new();
+            for fixture in &file.fixtures {
+                let mut batch = fixture_batch(fixture, fixture_root, false)?;
+                let sequences = batch.cumulative_seq_lengths.len() - 1;
+                batch.pooled_indices = (0..sequences as u32).collect();
+                batch.raw_indices.clear();
+                let embeddings = backend
+                    .submit_with_pool(batch.clone(), pool.clone())?
+                    .complete()?;
+                let values = pooled_rows(&embeddings, sequences, width)?;
+                records.push(write_rows(
+                    &directory,
+                    &fixture.name,
+                    name,
+                    width,
+                    sequences,
+                    &batch.cumulative_seq_lengths,
+                    &values,
+                )?);
+            }
+            std::fs::create_dir_all(&directory)?;
+            std::fs::write(
+                directory.join("oxide-consumer.json"),
+                serde_json::to_vec_pretty(
+                    &json!({"schema":"qwen3-vl-quality-consumer/v1","pool":name,"records":records}),
+                )?,
+            )?;
+            pools.push(name);
+        }
+    }
+    let directory = output.join("raw");
+    let mut records = Vec::new();
+    for fixture in &file.fixtures {
+        let mut batch = fixture_batch(fixture, fixture_root, true)?;
+        let sequences = batch.cumulative_seq_lengths.len() - 1;
+        batch.pooled_indices.clear();
+        batch.raw_indices = (0..sequences as u32).collect();
+        let embeddings = backend
+            .submit_with_pool(batch.clone(), Pool::LastToken)?
+            .complete()?;
+        let values = raw_rows(&embeddings, sequences, width)?;
+        records.push(write_rows(
+            &directory,
+            &fixture.name,
+            "tokens",
+            width,
+            sequences,
+            &batch.cumulative_seq_lengths,
+            &values,
+        )?);
+    }
+    std::fs::create_dir_all(&directory)?;
+    std::fs::write(
+        directory.join("oxide-consumer.json"),
+        serde_json::to_vec_pretty(
+            &json!({"schema":"qwen3-vl-quality-consumer/v1","pool":"raw","records":records}),
+        )?,
+    )?;
+    let report = json!({
+        "schema": "qwen3-vl-host-consumer-gpu-quality/v1",
+        "checkpoint": root,
+        "multi_vector": config.readout.multi_vector,
+        "width": width,
+        "pools": pools,
+        "raw": true,
+    });
+    std::fs::write(
+        output.join("gpu-quality.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    Ok(report)
+}
+
+fn gpu_lifecycle(
+    checkpoints: &[PathBuf],
+    fixtures: &Path,
+    output: &Path,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let root = checkpoints.first().ok_or("missing checkpoint")?;
+    let fixture_root = fixtures.parent().unwrap_or_else(|| Path::new("."));
+    let file = read_fixture_file(fixtures)?;
+    let config = Qwen3VlConfig::from_path(root)?;
+    let batch = fixture_batch(&file.fixtures[0], fixture_root, config.readout.multi_vector)?;
+    let backend = Qwen3VlBackend::new_with_pool(root, "bfloat16", 0, Pool::LastToken)?;
+    // Two deferred owners held on the actual production path. The normal
+    // Backend service keeps blocking SlotPool::acquire semantics: a direct
+    // same-thread third submit must first release one of the two leases.
+    let first = backend.submit_embed(batch.clone())?;
+    let second = backend.submit_embed(batch.clone())?;
+    // Drop the first Inference without invoking its closure. The RAII owner
+    // Drop must fence/quarantine before freeing the request resources and
+    // returning its HostIo slot.
+    drop(first);
+    backend.health()?;
+    let third = backend.submit_embed(batch.clone())?;
+    third.complete()?;
+    second.complete()?;
+    backend.health()?;
+    // Malformed media with zero selectors must be rejected even though there
+    // is no output selection, before any lease is taken.
+    let malformed = {
+        let mut b = batch.clone();
+        b.pooled_indices.clear();
+        b.raw_indices.clear();
+        let image = Arc::new(ImagePatches {
+            pixels: vec![0.0; 3],
+            grid_thw: [1, 2, 2],
+            patch_dim: 4,
+            merge_size: 2,
+        });
+        b.multimodal = vec![Some(Arc::new(MultimodalEncoding {
+            images: vec![(0, image)],
+            audios: vec![],
+            position_ids: [
+                vec![0; b.input_ids.len()],
+                vec![0; b.input_ids.len()],
+                vec![0; b.input_ids.len()],
+            ],
+            memory: None,
+        }))];
+        b
+    };
+    let invalid = backend.submit_embed(malformed);
+    let invalid_typed = matches!(
+        invalid,
+        Err(infinity_v3_backend_core::BackendError::Start(_))
+            | Err(infinity_v3_backend_core::BackendError::Inference(_))
+    );
+    if let Ok(inference) = invalid {
+        inference.complete()?;
+    }
+    backend.health()?;
+    let report = json!({
+        "schema": "qwen3-vl-host-consumer-gpu-lifecycle/v1",
+        "checkpoint": root,
+        "direct_third_requires_released_lease": true,
+        "drop_without_completion_health": true,
+        "invalid_media_typed": invalid_typed,
+        "health_after_invalid": true
+    });
+    std::fs::create_dir_all(output)?;
+    std::fs::write(
+        output.join("gpu-lifecycle.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    Ok(report)
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut checkpoints = Vec::new();
+    let mut fixtures = PathBuf::from("native-baseline/fixtures/fixtures.json");
+    let mut output = PathBuf::from("host-consumer-out");
+    let mut mode = "all".to_owned();
+    let mut args = std::env::args().skip(1);
+    while let Some(flag) = args.next() {
+        match flag.as_str() {
+            "--checkpoint" => {
+                checkpoints.push(PathBuf::from(args.next().ok_or("missing checkpoint")?))
+            }
+            "--fixtures" => fixtures = PathBuf::from(args.next().ok_or("missing fixtures")?),
+            "--out" => output = PathBuf::from(args.next().ok_or("missing out")?),
+            "--mode" => mode = args.next().ok_or("missing mode")?,
+            other => return Err(format!("unsupported argument {other}").into()),
+        }
+    }
+    if checkpoints.is_empty() {
+        checkpoints = DEFAULT_CHECKPOINTS.iter().map(PathBuf::from).collect();
+    }
+    std::fs::create_dir_all(&output)?;
+    if mode == "gpu-forward" {
+        let report = gpu_forward(&checkpoints, &fixtures, &output)?;
+        println!("{}", serde_json::to_string_pretty(&report)?);
+        return Ok(());
+    }
+    if mode == "gpu-lifecycle" {
+        let report = gpu_lifecycle(&checkpoints, &fixtures, &output)?;
+        println!("{}", serde_json::to_string_pretty(&report)?);
+        return Ok(());
+    }
+    if mode == "gpu-quality" {
+        let report = gpu_quality(&checkpoints, &fixtures, &output)?;
+        println!("{}", serde_json::to_string_pretty(&report)?);
+        return Ok(());
+    }
+    let mut report = json!({"schema":"qwen3-vl-host-consumer/v1","mode":mode});
+    if mode == "all" || mode == "manifest" {
+        let mut records = Vec::new();
+        for root in &checkpoints {
+            records.push(manifest(root)?);
+        }
+        report["manifest"] = json!(records);
+    }
+    if mode == "all" || mode == "factory" {
+        let mut records = Vec::new();
+        for root in &checkpoints {
+            records.push(factory(root, &fixtures)?);
+        }
+        report["factory"] = json!(records);
+    }
+    if mode == "all" || mode == "lifecycle" {
+        report["lifecycle"] = lifecycle(&checkpoints, &fixtures)?;
+    }
+    std::fs::write(
+        output.join("host-consumer.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    println!("{}", serde_json::to_string_pretty(&report)?);
+    Ok(())
+}
diff --git a/libs/infinity-v3/backends/oxide/examples/qwen3_vl_oxide_consumer.rs b/libs/infinity-v3/backends/oxide/examples/qwen3_vl_oxide_consumer.rs
new file mode 100644
index 0000000..dc8ae27
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/examples/qwen3_vl_oxide_consumer.rs
@@ -0,0 +1,131 @@
+// Optional Qwen3-VL Oxide consumer for Root GPU gates.
+//
+// Reads the same real processor fixtures as the Native b66 consumer, runs the
+// concrete Oxide tower + dense decoder, and writes f32 outputs plus SHA-256 so a
+// fresh coupled Native-vs-Oxide comparison can be made without reshaping data.
+//
+// This binary needs a CUDA device at runtime. The author builds it on CPU only.
+
+use infinity_backend_oxide::qwen3_vl_fixtures::{fixture_batch, pool_from_name, read_fixture_file};
+use infinity_backend_oxide::qwen3_vl_service::Qwen3VlModel;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+fn usage() -> ! {
+    eprintln!(
+        "usage: qwen3_vl_oxide_consumer CHECKPOINT FIXTURES OUTPUT_DIR \
+         [--fixture NAME] [--raw] [--pool cls|mean|last_token] [--iterations N] [--device N]"
+    );
+    std::process::exit(2)
+}
+
+fn pool_label(pool: &infinity_v3_backend_core::Pool) -> &'static str {
+    use infinity_v3_backend_core::Pool;
+    match pool {
+        Pool::Cls => "cls",
+        Pool::Mean => "mean",
+        Pool::LastToken => "last",
+        Pool::Splade => "splade",
+    }
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1);
+    let checkpoint = PathBuf::from(args.next().unwrap_or_else(|| usage()));
+    let fixtures = PathBuf::from(args.next().unwrap_or_else(|| usage()));
+    let output = PathBuf::from(args.next().unwrap_or_else(|| usage()));
+    let mut selected: Option<String> = None;
+    let mut raw = false;
+    let mut iterations = 1usize;
+    let mut device = 0usize;
+    let mut pool_override: Option<String> = None;
+    while let Some(flag) = args.next() {
+        match flag.as_str() {
+            "--fixture" => selected = Some(args.next().unwrap_or_else(|| usage())),
+            "--raw" => raw = true,
+            "--pool" => pool_override = Some(args.next().unwrap_or_else(|| usage())),
+            "--iterations" => {
+                iterations = args
+                    .next()
+                    .unwrap_or_else(|| usage())
+                    .parse()
+                    .map_err(|error| format!("invalid iterations: {error}"))?
+            }
+            "--device" => {
+                device = args
+                    .next()
+                    .unwrap_or_else(|| usage())
+                    .parse()
+                    .map_err(|error| format!("invalid device: {error}"))?
+            }
+            other => return Err(format!("unsupported argument {other}").into()),
+        }
+    }
+    let manifest = read_fixture_file(&fixtures)?;
+    let fixture_root = fixtures.parent().unwrap_or_else(|| Path::new("."));
+    std::fs::create_dir_all(&output)?;
+    let context = std::sync::Arc::new(cuda_core::Context::new(device)?);
+    let stream = context.new_stream()?;
+    let mut model = Qwen3VlModel::open(&checkpoint, &context, &stream)?;
+    let mut records = Vec::new();
+    for fixture in &manifest.fixtures {
+        if selected.as_deref().is_some_and(|name| name != fixture.name) {
+            continue;
+        }
+        let use_raw = raw || model.supports_multi_vector();
+        let batch = fixture_batch(fixture, fixture_root, use_raw)?;
+        let pool = pool_from_name(pool_override.as_deref().or(fixture.pool.as_deref()))?;
+        let mut timings = Vec::new();
+        let mut last = None;
+        for _ in 0..iterations.max(1) {
+            let started = Instant::now();
+            let result = model.forward_batch(&batch, pool.clone())?;
+            timings.push(started.elapsed().as_secs_f64() * 1e3);
+            last = Some(result);
+        }
+        let result = last.ok_or("no iteration ran")?;
+        let values = if let Some(tokens) = result.tokens.as_ref() {
+            tokens
+        } else {
+            result.pooled.as_ref().ok_or("fixture produced no output")?
+        };
+        let kind = if use_raw {
+            "tokens".to_owned()
+        } else {
+            format!("pool{}", pool_label(&pool))
+        };
+        let path = output.join(format!("{}.{kind}.f32", fixture.name));
+        let mut bytes = Vec::with_capacity(values.len() * 4);
+        for value in values {
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        std::fs::write(&path, &bytes)?;
+        let sha = format!("{:x}", Sha256::digest(&bytes));
+        records.push(json!({
+            "fixture": fixture.name,
+            "kind": kind,
+            "width": result.width,
+            "sequences": result.sequences,
+            "values": values.len(),
+            "cumulative": result.cumulative,
+            "sha256": sha,
+            "path": path,
+            "iterations_ms": timings,
+            "finite": values.iter().all(|value| value.is_finite()),
+        }));
+    }
+    let report = json!({
+        "schema": "infinity-qwen3-vl-oxide-consumer/v1",
+        "checkpoint": checkpoint,
+        "fixtures": fixtures,
+        "device": device,
+        "records": records,
+    });
+    std::fs::write(
+        output.join("oxide-consumer.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    Ok(())
+}
diff --git a/libs/infinity-v3/backends/oxide/src/checkpoint.rs b/libs/infinity-v3/backends/oxide/src/checkpoint.rs
new file mode 100644
index 0000000..50d8a18
--- /dev/null
+++ b/libs/infinity-v3/backends/oxide/src/checkpoint.rs
@@ -0,0 +1,373 @@
+// Cold safetensors metadata reader.
+//
+// This module only reads the 8-byte header length and the JSON header of each
+// shard. It never reads tensor payloads, creates a device context, or imports a
+// framework. It is the metadata floor used by the inventory, weight-binding and
+// Native CAPI control-packet modules.
+
+use infinity_v3_backend_core::BackendError;
+use serde::Deserialize;
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Component, Path};
+use std::sync::{Arc, Mutex};
+
+const SAFETENSORS_PREFIX_BYTES: u64 = 8;
+const MAX_HEADER_BYTES: u64 = 100_000_000;
+const MAX_SIDECAR_BYTES: u64 = 16 * 1024 * 1024;
+
+pub(crate) fn start(error: impl std::fmt::Display) -> BackendError {
+    BackendError::Start(format!("Oxide qwen3-vl checkpoint: {error}"))
+}
+
+pub(crate) fn read_json<T: serde::de::DeserializeOwned>(path: &Path) -> Result<T, BackendError> {
+    let file = File::open(path).map_err(start)?;
+    let metadata = file.metadata().map_err(start)?;
+    if !metadata.is_file() || metadata.len() > MAX_SIDECAR_BYTES {
+        return Err(start(
+            "checkpoint JSON must be a regular file of at most 16 MiB",
+        ));
+    }
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(usize::try_from(metadata.len()).map_err(start)?)
+        .map_err(start)?;
+    file.take(MAX_SIDECAR_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(start)?;
+    if bytes.len() as u64 > MAX_SIDECAR_BYTES {
+        return Err(start("checkpoint JSON exceeds 16 MiB"));
+    }
+    serde_json::from_slice(&bytes).map_err(start)
+}
+
+pub(crate) fn path_present(path: &Path) -> Result<bool, BackendError> {
+    match std::fs::symlink_metadata(path) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(start(error)),
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum CheckpointDtype {
+    F32,
+    F16,
+    Bf16,
+}
+
+impl CheckpointDtype {
+    pub fn from_name(name: &str) -> Result<Self, BackendError> {
+        match name {
+            "F32" | "f32" => Ok(Self::F32),
+            "F16" | "f16" => Ok(Self::F16),
+            "BF16" | "bf16" => Ok(Self::Bf16),
+            other => Err(start(format!("unsupported checkpoint dtype {other}"))),
+        }
+    }
+
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::F32 => "F32",
+            Self::F16 => "F16",
+            Self::Bf16 => "BF16",
+        }
+    }
+
+    pub const fn width(self) -> usize {
+        match self {
+            Self::F32 => 4,
+            Self::F16 | Self::Bf16 => 2,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TensorMeta {
+    pub name: String,
+    pub dtype: CheckpointDtype,
+    pub shape: Vec<usize>,
+    pub shard: String,
+    pub data_offsets: (u64, u64),
+}
+
+impl TensorMeta {
+    pub fn elements(&self) -> Result<usize, BackendError> {
+        self.shape.iter().try_fold(1usize, |count, dim| {
+            count
+                .checked_mul(*dim)
+                .ok_or_else(|| start(format!("{} dimension overflow", self.name)))
+        })
+    }
+
+    pub fn bytes(&self) -> Result<u64, BackendError> {
+        let elements = u64::try_from(self.elements()?).map_err(start)?;
+        elements
+            .checked_mul(self.dtype.width() as u64)
+            .ok_or_else(|| start(format!("{} byte size overflow", self.name)))
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ShardMeta {
+    pub name: String,
+    pub file_bytes: u64,
+    pub header_bytes: u64,
+    pub data_start: u64,
+    pub data_length: u64,
+    pub tensor_count: usize,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CheckpointMetadata {
+    pub root: std::path::PathBuf,
+    pub shards: BTreeMap<String, ShardMeta>,
+    pub tensors: BTreeMap<String, TensorMeta>,
+}
+
+#[derive(Deserialize)]
+struct RawIndex {
+    weight_map: BTreeMap<String, String>,
+}
+
+#[derive(Deserialize)]
+struct RawTensor {
+    dtype: String,
+    shape: Vec<i64>,
+    data_offsets: [u64; 2],
+}
+
+fn validate_shard_name(file: &str) -> Result<(), BackendError> {
+    let mut components = Path::new(file).components();
+    if !matches!(components.next(), Some(Component::Normal(_)))
+        || components.next().is_some()
+        || !file.ends_with(".safetensors")
+        || file.contains('\\')
+    {
+        return Err(start(format!("invalid safetensors shard path {file}")));
+    }
+    Ok(())
+}
+
+fn read_header(path: &Path) -> Result<(u64, BTreeMap<String, RawTensor>), BackendError> {
+    let mut file = File::open(path).map_err(start)?;
+    let file_bytes = file.metadata().map_err(start)?.len();
+    let mut prefix = [0u8; SAFETENSORS_PREFIX_BYTES as usize];
+    file.read_exact(&mut prefix).map_err(start)?;
+    let header_bytes = u64::from_le_bytes(prefix);
+    if header_bytes == 0 || header_bytes > MAX_HEADER_BYTES {
+        return Err(start(format!(
+            "invalid safetensors header length {header_bytes} in {}",
+            path.display()
+        )));
+    }
+    let header_end = SAFETENSORS_PREFIX_BYTES
+        .checked_add(header_bytes)
+        .ok_or_else(|| start("safetensors header offset overflow"))?;
+    if header_end > file_bytes {
+        return Err(start(format!(
+            "safetensors header exceeds {}",
+            path.display()
+        )));
+    }
+    file.seek(SeekFrom::Start(SAFETENSORS_PREFIX_BYTES))
+        .map_err(start)?;
+    let mut bytes = vec![0u8; usize::try_from(header_bytes).map_err(start)?];
+    file.read_exact(&mut bytes).map_err(start)?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes).map_err(start)?;
+    let object = value
+        .as_object()
+        .ok_or_else(|| start("safetensors header is not an object"))?;
+    let mut tensors = BTreeMap::new();
+    for (name, raw) in object {
+        if name == "__metadata__" {
+            continue;
+        }
+        let tensor: RawTensor = serde_json::from_value(raw.clone()).map_err(start)?;
+        if tensor.shape.iter().any(|dim| *dim < 0) {
+            return Err(start(format!("negative tensor dimension for {name}")));
+        }
+        let shape = tensor
+            .shape
+            .into_iter()
+            .map(|dim| usize::try_from(dim).map_err(start))
+            .collect::<Result<Vec<_>, _>>()?;
+        tensors.insert(
+            name.clone(),
+            RawTensor {
+                dtype: tensor.dtype,
+                shape: shape
+                    .iter()
+                    .map(|dim| i64::try_from(*dim).map_err(start))
+                    .collect::<Result<Vec<_>, _>>()?,
+                data_offsets: tensor.data_offsets,
+            },
+        );
+    }
+    Ok((header_bytes, tensors))
+}
+
+impl CheckpointMetadata {
+    pub fn open(root: &Path) -> Result<Self, BackendError> {
+        let single = root.join("model.safetensors");
+        let (files, weight_map): (Vec<String>, Option<BTreeMap<String, String>>) =
+            if path_present(&single)? {
+                (vec!["model.safetensors".to_owned()], None)
+            } else {
+                let index: RawIndex = read_json(&root.join("model.safetensors.index.json"))?;
+                if index.weight_map.is_empty() {
+                    return Err(start("empty safetensors shard index"));
+                }
+                let mut unique = BTreeSet::new();
+                for file in index.weight_map.values() {
+                    validate_shard_name(file)?;
+                    unique.insert(file.clone());
+                }
+                (unique.into_iter().collect(), Some(index.weight_map))
+            };
+
+        let mut shards = BTreeMap::new();
+        let mut tensors = BTreeMap::new();
+        for file in &files {
+            let path = root.join(file);
+            let file_bytes = std::fs::metadata(&path).map_err(start)?.len();
+            let (header_bytes, raw) = read_header(&path)?;
+            let data_start = SAFETENSORS_PREFIX_BYTES
+                .checked_add(header_bytes)
+                .ok_or_else(|| start("safetensors data start overflow"))?;
+            let data_length = file_bytes
+                .checked_sub(data_start)
+                .ok_or_else(|| start("safetensors data length underflow"))?;
+            let mut max_end = 0u64;
+            for (name, raw_tensor) in raw {
+                if let Some(expected) = weight_map.as_ref() {
+                    if expected.get(&name) != Some(file) {
+                        return Err(start(format!(
+                            "tensor {name} is not mapped to {file} by the index"
+                        )));
+                    }
+                }
+                let (begin, end) = (raw_tensor.data_offsets[0], raw_tensor.data_offsets[1]);
+                if begin > end || end > data_length {
+                    return Err(start(format!("tensor {name} range exceeds {file}")));
+                }
+                let dtype = CheckpointDtype::from_name(&raw_tensor.dtype)?;
+                let shape: Vec<usize> = raw_tensor
+                    .shape
+                    .into_iter()
+                    .map(|dim| usize::try_from(dim).map_err(start))
+                    .collect::<Result<Vec<_>, _>>()?;
+                let meta = TensorMeta {
+                    name: name.clone(),
+                    dtype,
+                    shape,
+                    shard: file.clone(),
+                    data_offsets: (begin, end),
+                };
+                let declared = meta.bytes()?;
+                if end - begin != declared {
+                    return Err(start(format!(
+                        "tensor {name} declares {} bytes but its shape/dtype require {declared}",
+                        end - begin
+                    )));
+                }
+                if tensors.insert(name.clone(), meta).is_some() {
+                    return Err(start(format!("duplicate tensor {name} across shards")));
+                }
+                max_end = max_end.max(end);
+            }
+            if max_end != data_length {
+                return Err(start(format!(
+                    "shard {file} payload ends at {max_end}, file declares {data_length}"
+                )));
+            }
+            shards.insert(
+                file.clone(),
+                ShardMeta {
+                    name: file.clone(),
+                    file_bytes,
+                    header_bytes,
+                    data_start,
+                    data_length,
+                    tensor_count: 0,
+                },
+            );
+        }
+        for tensor in tensors.values() {
+            if let Some(shard) = shards.get_mut(&tensor.shard) {
+                shard.tensor_count += 1;
+            }
+        }
+        if let Some(expected) = weight_map {
+            if expected.len() != tensors.len() {
+                return Err(start(
+                    "index and safetensors headers disagree on tensor count",
+                ));
+            }
+        }
+        Ok(Self {
+            root: root.to_path_buf(),
+            shards,
+            tensors,
+        })
+    }
+
+    pub fn total_elements(&self) -> Result<u64, BackendError> {
+        self.tensors.values().try_fold(0u64, |total, tensor| {
+            total
+                .checked_add(u64::try_from(tensor.elements()?).map_err(start)?)
+                .ok_or_else(|| start("checkpoint element count overflow"))
+        })
+    }
+
+    pub fn total_bytes(&self) -> Result<u64, BackendError> {
+        self.tensors.values().try_fold(0u64, |total, tensor| {
+            total
+                .checked_add(tensor.bytes()?)
+                .ok_or_else(|| start("checkpoint byte count overflow"))
+        })
+    }
+
+    pub fn shard_file(&self, shard: &str) -> std::path::PathBuf {
+        self.root.join(shard)
+    }
+}
+
+/// Borrowable file handle for the future uploader. The CPU-only tests never
+/// open these handles; they only validate the bounded ranges.
+#[derive(Clone)]
+pub struct ShardFile {
+    pub shard: String,
+    pub data_start: u64,
+    pub data_length: u64,
+    file: Arc<Mutex<File>>,
+}
+
+impl ShardFile {
+    pub fn open(root: &Path, shard: &str) -> Result<Self, BackendError> {
+        validate_shard_name(shard)?;
+        let file = File::open(root.join(shard)).map_err(start)?;
+        let file_bytes = file.metadata().map_err(start)?.len();
+        let mut prefix = [0u8; SAFETENSORS_PREFIX_BYTES as usize];
+        let mut reader = file.try_clone().map_err(start)?;
+        reader.read_exact(&mut prefix).map_err(start)?;
+        let header_bytes = u64::from_le_bytes(prefix);
+        let data_start = SAFETENSORS_PREFIX_BYTES
+            .checked_add(header_bytes)
+            .ok_or_else(|| start("safetensors data start overflow"))?;
+        let data_length = file_bytes
+            .checked_sub(data_start)
+            .ok_or_else(|| start("safetensors data length underflow"))?;
+        Ok(Self {
+            shard: shard.to_owned(),
+            data_start,
+            data_length,
+            file: Arc::new(Mutex::new(file)),
+        })
+    }
+
+    pub fn clone_handle(&self) -> Arc<Mutex<File>> {
+        Arc::clone(&self.file)
+    }
+}
